      "animate": "ruler"
    },
    {
      "id": 11,
      "text": "The vertical line through S crosses the diagonal through M at Y. Draw a horizontal line through Y. Turn it round O by 90°, three times.",
      "create": {
        "Q": {"point": {"meet": ["sv@3", "md@3"]}},
        "Y": {"point": {"meet": ["sv", "md"]}},
        "yh": {"line": {"through": "Y", "parallelTo": "h"}},
        "yhp": {"repeat": {"of": ["yh"], "by": "rot4"}}
      },
      "animate": "ruler",
      "textWithoutHelpers": "The horizontal line through the star’s lower corner crosses the diagonal through M at Q. Draw a vertical line through Q."
    },
    {
      "id": 12,
      "text": "The vertical copy of the line through Y crosses the diagonal through U at Z. Draw a horizontal line through Z. Turn it round O by 90°, three times.",
      "create": {
        "Z": {"point": {"meet": ["yh@3", "ud"]}},
        "zh": {"line": {"through": "Z", "parallelTo": "h"}},
        "zhp": {"repeat": {"of": ["zh"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 13,
      "text": "The horizontal line through Z crosses line AC at L. Draw a vertical line through L. Turn it round O by 90°, three times.",
      "create": {
        "L": {"point": {"meet": ["zh", "ac"]}},
        "lv": {"line": {"through": "L", "parallelTo": "v"}},
        "lvp": {"repeat": {"of": ["lv"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 14,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
