    "fidelity": "not-applicable",
    "note": "The finished design was read from Brian Wichmann’s C268A vector drawing. The band centre lines were snapped to exact values on a half-OA grid. The drawing gives no steps. We devised the construction from the square’s midpoint and two squares on the circle of radius MG.",
    "changes": "The compass steps, their order and the named points are ours. The tutorial draws the centre lines of Wichmann’s 10 pt interlaced bands. Its square cell spans two small-star spacings because their surroundings alternate. The palette is illustrative; no photograph was checked. The page heading names Moulay Idriss zaouia, while its Wade references name Moulay Ishmael mosque.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data152/C268A: Moulay Idriss Zaouia, Fez",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data152/C268A.html",
      "note": "Read from his finished drawing, not construction instructions. His references are Castéra, Arabesques, page 268 right (Moulay Idriss zaouia, original colouring); Wichmann and Wade, Islamic Design: a Mathematical Approach, figure 9.9a; and David Wade photographs MOR 0616 and MOR 0329, captioned Moulay Ishmael mosque, Fez."
    }
  ],
  "given": {
    "O": "The centre of a small star inside a large star.",
    "A": "The next small-star centre on the horizontal line."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The circle crosses the two lines at A, B, C and D. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and D. The four corners are K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "B", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "D", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K1"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler",
      "textWithoutHelpers": "Draw a vertical line through O. The circle crosses the two lines at A, B, C and D. Draw a vertical line through each of A and B. Draw a horizontal line through C. It crosses the vertical line through A at K1. Draw a straight line through O and K1."
    },
    {
      "id": 3,
      "text": "Draw a straight line through A and C. It crosses the line from O to K1 at E. Draw a vertical line through E. It crosses the horizontal line at M. Draw a line through O at 90° to the line from O to K1.",
      "create": {
        "ac": {"line": {"through": ["A", "C"]}},
        "E": {"point": {"meet": ["ac", "d45"]}},
        "ev": {"line": {"through": "E", "parallelTo": "v"}},
        "M": {"point": {"meet": ["ev", "h"]}},
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}}
      },
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw a circle with centre O through E. It crosses the horizontal line at G. Draw a circle with centre O and radius MG. It crosses the horizontal line at T and the line from O to K1 at S.",
      "create": {
        "ch": {"circle": {"centre": "O", "through": "E"}},
        "G": {"point": {"meet": ["ch", "h"], "pick": {"angle": 0.0}}},
        "cs": {"circle": {"centre": "O", "radiusFrom": ["M", "G"]}},
        "T": {"point": {"meet": ["cs", "h"], "pick": {"angle": 0.0}}},
        "S": {"point": {"meet": ["cs", "d45"], "pick": {"angle": 45.0}}}
      },
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Draw a vertical line through S. Turn it round O by 90°, three times. Draw a line through T parallel to line AC. Turn it round O by 90°, three times. The eight lines make the star at O.",
      "create": {
        "sv": {"line": {"through": "S", "parallelTo": "v"}},
        "svp": {"repeat": {"of": ["sv"], "by": "rot4"}},
        "td": {"line": {"through": "T", "parallelTo": "ac"}},
        "tdp": {"repeat": {"of": ["td"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw a line through M parallel to line AC. Turn it round O by 90°, three times.",
      "create": {
        "md": {"line": {"through": "M", "parallelTo": "ac"}},
        "mdp": {"repeat": {"of": ["md"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "The vertical line through M crosses the star’s lower right side at U. Draw a line through U parallel to line AC. Turn it round O by 90°, three times.",
