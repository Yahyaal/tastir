  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s TOP1 drawing, whose pieces are drawn edge to edge. O is the centre of a ten-pointed star whose sides are the ten lines AD, BE, CF and on round, and OA is the radius of its points. The repeat is a rectangle of half-sides 2√5 and 10 tan 54° (in OA), with stars at its centre and corners and on rows between. Every line runs at a multiple of 36°, and every offset is sin 36° times a + b√5 with whole numbers a and b (drawing within 0.0002 of OA). The drawing gives no steps; we devised the construction.",
    "changes": "The compass steps, their order and the named points are ours. Wichmann draws the pieces red and white; our colours keep his red pieces in the warm slots and his white ones in the light slots. No photograph was checked.",
    "reviewed": "2026-10-27"
  },
  "credits": [
    {
      "source": "Tiling Search, data198/TOP1: Topkapi Palace door",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data198/TOP1.html",
      "note": "Read from his finished drawing, not construction instructions. His reference is Eric Broug, Islamic Geometric Design (Thames & Hudson, 2013), page 160, figure 5.94 (a door of the Topkapı Palace, Istanbul)."
    }
  ],
