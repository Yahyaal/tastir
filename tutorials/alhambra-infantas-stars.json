        "G0_2": {"point": {"meet": ["v", "H2"]}},
        "G0_3": {"point": {"meet": ["v", "H3"]}},
        "G1h_m5h": {"point": {"meet": ["Dm3", "Dpm2"]}},
        "G1h_m1h": {"point": {"meet": ["Dm1", "d2"]}},
        "G1h_1h": {"point": {"meet": ["d1", "Dp1"]}},
        "G1h_5h": {"point": {"meet": ["Dmm2", "Dp3"]}},
        "G1_m2": {"point": {"meet": ["V1", "Hm2"]}},
        "G1_m1": {"point": {"meet": ["V1", "Hm1"]}},
        "G1_0": {"point": {"meet": ["V1", "h"]}},
        "G1_1": {"point": {"meet": ["V1", "H1"]}},
        "G1_2": {"point": {"meet": ["V1", "H2"]}},
        "G3h_m3h": {"point": {"meet": ["Dm3", "d2"]}},
        "G3h_3h": {"point": {"meet": ["d1", "Dp3"]}},
        "G2_m1": {"point": {"meet": ["V2", "Hm1"]}},
        "G2_0": {"point": {"meet": ["V2", "h"]}},
        "G2_1": {"point": {"meet": ["V2", "H1"]}},
        "G5h_m1h": {"point": {"meet": ["Dm3", "Dp2"]}},
        "G5h_1h": {"point": {"meet": ["Dm2", "Dp3"]}},
        "G3_0": {"point": {"meet": ["V3", "h"]}},
        "tile": {"polygon": ["G3_0", "G0_3", "Gm3_0", "G0_m3"]}
      },
      "animate": "ruler"
    }
  ],
