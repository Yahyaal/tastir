{
  "format": 0,
  "id": "alhambra-infantas-stars",
  "title": "Infantas plaster stars",
  "fold": 4,
  "star": 8,
  "style": "Nasrid",
  "level": "beginner",
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "This uses Manuel Martínez Vela’s published grid method and the Infantas plaster tracing on a square grid and diagonals in ALZADA 115, page 45. We read the outlines and supplied the compass construction and step grouping.",
    "changes": "The article explains the shared grid and shows the completed tracing. It does not give this pattern’s numbered app sequence. Its separate nine-step Partal example is a different pattern. Source credits identify the design and method, not a verbatim sequence.",
    "reviewed": "2026-10-21"
  },
  "credits": [
    {
      "source": "La Alhambra con regla y compás: el trazado de los diseños geométricos nazaríes (ALZADA 115, 2017)",
      "creator": "Manuel Martínez Vela",
      "url": "https://www.riarte.es/handle/20.500.12251/633",
      "note": "The grid-and-diagonals base and the tracing of the plaster panel (yesería) of the Torre de las Infantas follow this article.",
      "steps": [1, 2, 3, 4, 5, 6]
    }
  ],
  "given": {
    "O": "The centre of one cross.",
    "A": "Any point to the right of O. The distance OA is one square of the grid."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size until the end. The distance OA is one square of the grid.",
      "create": {
        "h": { "line": { "through": ["O", "A"] } },
        "c": { "circle": { "centre": "O", "through": "A" } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a circle with centre A through O. It crosses the line again at B. Draw a circle with centre B through A. It crosses the line again at C. Draw a circle with centre D through O, where the first circle crosses the line on the left. It crosses the line again at E. Draw a circle with centre E through D. It crosses the line again at F.",
      "create": {
        "D": { "point": { "meet": ["c", "h"], "pick": { "angle": 180 } } },
        "cx1": { "circle": { "centre": "A", "radiusOf": "c" } },
        "B": { "point": { "meet": ["cx1", "h"], "pick": { "farthest": "O" } } },
        "cxm1": { "circle": { "centre": "D", "radiusOf": "c" } },
        "E": { "point": { "meet": ["cxm1", "h"], "pick": { "farthest": "O" } } },
        "cx2": { "circle": { "centre": "B", "radiusOf": "c" } },
        "C": { "point": { "meet": ["cx2", "h"], "pick": { "farthest": "O" } } },
        "cxm2": { "circle": { "centre": "E", "radiusOf": "c" } },
        "F": { "point": { "meet": ["cxm2", "h"], "pick": { "farthest": "O" } } }
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a vertical line through O. It crosses the first circle at J and M. Draw a circle with centre J through O. It crosses the vertical line again at K. Draw a circle with centre K through J. It crosses it again at L. Draw the same two circles below O, with centres M and N. They give N and P.",
      "create": {
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "J": { "point": { "meet": ["c", "v"], "pick": { "angle": 90 } } },
        "M": { "point": { "meet": ["c", "v"], "pick": { "angle": 270 } } },
        "cy1": { "circle": { "centre": "J", "radiusOf": "c" } },
        "K": { "point": { "meet": ["cy1", "v"], "pick": { "farthest": "O" } } },
        "cym1": { "circle": { "centre": "M", "radiusOf": "c" } },
        "N": { "point": { "meet": ["cym1", "v"], "pick": { "farthest": "O" } } },
        "cy2": { "circle": { "centre": "K", "radiusOf": "c" } },
        "L": { "point": { "meet": ["cy2", "v"], "pick": { "farthest": "O" } } },
        "cym2": { "circle": { "centre": "N", "radiusOf": "c" } },
        "P": { "point": { "meet": ["cym2", "v"], "pick": { "farthest": "O" } } }
      },
      "highlight": ["h"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a vertical line through each of F, E, D, A, B and C. Draw a horizontal line through each of P, N, M, J, K and L. The lines make a square grid.",
      "textWithoutHelpers": "Draw a vertical line through each of E, D, A and B. Draw a horizontal line through each of N, M, J and K. The lines make a square grid.",
      "create": {
        "Vm3": { "line": { "through": "F", "perpendicularTo": "h" } },
        "Hm3": { "line": { "through": "P", "perpendicularTo": "v" } },
        "Vm2": { "line": { "through": "E", "perpendicularTo": "h" } },
        "Hm2": { "line": { "through": "N", "perpendicularTo": "v" } },
        "Vm1": { "line": { "through": "D", "perpendicularTo": "h" } },
        "Hm1": { "line": { "through": "M", "perpendicularTo": "v" } },
        "V1": { "line": { "through": "A", "perpendicularTo": "h" } },
        "H1": { "line": { "through": "J", "perpendicularTo": "v" } },
        "V2": { "line": { "through": "B", "perpendicularTo": "h" } },
        "H2": { "line": { "through": "K", "perpendicularTo": "v" } },
        "V3": { "line": { "through": "C", "perpendicularTo": "h" } },
        "H3": { "line": { "through": "L", "perpendicularTo": "v" } }
      },
      "highlight": ["h", "v"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw the line through O that halves the angle AOJ. Draw the line through O that halves the angle JOD. Draw two lines through each of F, E, D, A, B and C, parallel to these two lines. Every square of the grid now has both its diagonals.",
      "create": {
        "d1": { "line": { "through": "O", "bisects": ["A", "O", "J"] } },
        "d2": { "line": { "through": "O", "bisects": ["J", "O", "D"] } },
        "Dmm3": { "line": { "through": "F", "parallelTo": "d1" } },
        "Dpm3": { "line": { "through": "F", "parallelTo": "d2" } },
        "Dmm2": { "line": { "through": "E", "parallelTo": "d1" } },
        "Dpm2": { "line": { "through": "E", "parallelTo": "d2" } },
        "Dmm1": { "line": { "through": "D", "parallelTo": "d1" } },
        "Dpm1": { "line": { "through": "D", "parallelTo": "d2" } },
        "Dm1": { "line": { "through": "A", "parallelTo": "d1" } },
        "Dp1": { "line": { "through": "A", "parallelTo": "d2" } },
        "Dm2": { "line": { "through": "B", "parallelTo": "d1" } },
        "Dp2": { "line": { "through": "B", "parallelTo": "d2" } },
        "Dm3": { "line": { "through": "C", "parallelTo": "d1" } },
        "Dp3": { "line": { "through": "C", "parallelTo": "d2" } }
      },
      "highlight": ["h", "v"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Join C, L, F and P to mark the tile that repeats. It stands on a corner, three squares from O each way. Some lines of the design end at the middle of a grid square, where its two diagonals cross.",
      "create": {
        "T5": { "point": { "meet": ["Dmm2", "Dpm3"] } },
        "T4": { "point": { "meet": ["Dmm3", "Dpm2"] } },
        "Q7": { "point": { "meet": ["Vm2", "Hm1"] } },
        "Q6": { "point": { "meet": ["Vm2", "H1"] } },
        "S3": { "point": { "meet": ["d1", "Dpm3"] } },
        "S2": { "point": { "meet": ["Dmm3", "d2"] } },
        "Q9": { "point": { "meet": ["Vm1", "Hm2"] } },
        "Q8": { "point": { "meet": ["Vm1", "Hm1"] } },
        "Q5": { "point": { "meet": ["Vm1", "H1"] } },
        "Q4": { "point": { "meet": ["Vm1", "H2"] } },
        "T6": { "point": { "meet": ["Dm2", "Dpm3"] } },
        "R3": { "point": { "meet": ["d1", "Dpm1"] } },
        "R2": { "point": { "meet": ["Dmm1", "d2"] } },
        "T3": { "point": { "meet": ["Dmm3", "Dp2"] } },
        "T7": { "point": { "meet": ["Dm3", "Dpm2"] } },
        "R4": { "point": { "meet": ["Dm1", "d2"] } },
        "R1": { "point": { "meet": ["d1", "Dp1"] } },
        "T2": { "point": { "meet": ["Dmm2", "Dp3"] } },
        "Q10": { "point": { "meet": ["V1", "Hm2"] } },
        "Q11": { "point": { "meet": ["V1", "Hm1"] } },
        "Q2": { "point": { "meet": ["V1", "H1"] } },
        "Q3": { "point": { "meet": ["V1", "H2"] } },
        "S4": { "point": { "meet": ["Dm3", "d2"] } },
        "S1": { "point": { "meet": ["d1", "Dp3"] } },
        "Q12": { "point": { "meet": ["V2", "Hm1"] } },
        "Q1": { "point": { "meet": ["V2", "H1"] } },
        "T8": { "point": { "meet": ["Dm3", "Dp2"] } },
        "T1": { "point": { "meet": ["Dm2", "Dp3"] } },
        "tile": { "polygon": ["C", "L", "F", "P"] }
      },
      "animate": "ruler"
    }
  ],
  "ink": {
    "text": "Ink the lines of the design. Each cross at the centre opens into bands along the grid. They fold back along the diagonals, and the space between them closes into notched stars.",
    "paths": [
      { "through": ["R3", "R1"] },
      { "through": ["R1", "A"] },
      { "through": ["A", "Q2"] },
      { "through": ["Q2", "S1"] },
      { "through": ["B", "Q1"] },
      { "through": ["B", "T1"] },
      { "through": ["T1", "C"] },
      { "through": ["Q3", "Q1"] },
      { "through": ["L", "T2"] },
      { "through": ["F", "T4"] },
      { "through": ["Q6", "Q4"] },
      { "through": ["T3", "L"] },
      { "through": ["T5", "E"] },
      { "through": ["R2", "J"] },
      { "through": ["S3", "Q8"] },
      { "through": ["M", "R4"] },
      { "through": ["P", "T7"] },
      { "through": ["Q10", "Q12"] },
      { "through": ["T8", "C"] },
      { "through": ["F", "T5"] },
      { "through": ["Q7", "Q9"] },
      { "through": ["T6", "P"] },
      { "through": ["N", "T7"] },
      { "through": ["D", "R3"] },
      { "through": ["S2", "Q5"] },
      { "through": ["R2", "R4"] },
      { "through": ["Q11", "S4"] },
      { "through": ["T3", "K"] },
      { "through": ["N", "Q10"] },
      { "through": ["M", "Q11"] },
      { "through": ["Q5", "J"] },
      { "through": ["Q4", "K"] },
      { "through": ["Q7", "E"] },
      { "through": ["Q8", "D"] }
    ],
    "parts": [
      {
        "text": "Ink from R3 through R1 and A to Q2, then on to S1. Ink from Q1 through B and T1 to C. Ink from Q3 to Q1. Ink from L to T2.",
        "paths": 9
      },
      {
        "text": "Ink the same lines turned round O, three more times. Tick “Also ink the copies round the centre” to ink them all at once.",
        "paths": 25
      }
    ]
  },
  "pattern": {
    "cell": "tile",
    "text": "Put copies of the tile side by side, as on the carved plaster panel of the Torre de las Infantas.",
    "palette": "Alhambra",
    "colors": { "star": "c" },
    "placements": {
      "repeat": [1, 1],
      "rules": [
        { "piece": "star", "nth": 1, "color": "b" },
        { "piece": "star", "nth": 2, "color": "a" },
        { "piece": "star", "nth": 3, "color": "ground" }
      ]
    }
  },
  "expect": {
    "note": "Golden values in grid squares (OA = one square), computed by the engine; four notched stars fill the tile of 18 squares.",
    "pieceTypes": 1,
    "pieces": [{ "name": "star", "vertices": 16, "area": 4.5, "perCell": 4 }],
    "cellArea": 18
  }
}
