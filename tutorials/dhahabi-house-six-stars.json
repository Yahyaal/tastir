      },
      "animate": "ruler",
      "textWithoutHelpers": "V1 to V6 are the small circle’s six division points. Draw a straight line through V1 and V3, V3 and V5, and V5 and V1. Draw a straight line through V2 and V4, and V4 and V6. Turn these five lines round O by 60°, five times."
    },
    {
      "id": 11,
      "text": "Draw a vertical line through C. It crosses the horizontal line at N3. Draw a circle with centre A and opening from O to N3. It crosses the horizontal line at N4, right of A.",
      "create": {
        "projection": {"line": {"through": "C", "parallelTo": "v"}},
        "N3": {"point": {"meet": ["projection", "h"]}},
        "cHalf": {"circle": {"centre": "A", "radiusFrom": ["O", "N3"]}},
        "N4": {"point": {"meet": ["cHalf", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 12,
      "text": "Draw a circle with centre N4 and the same opening as the small circle at T1. It crosses the horizontal line at N5, right of N4. Draw a vertical line through N5. Turn it round O by 60°, five times.",
      "create": {
        "cX": {"circle": {"centre": "N4", "radiusOf": "small"}},
        "N5": {"point": {"meet": ["cX", "h"], "pick": {"farthest": "O"}}},
        "xv": {"line": {"through": "N5", "parallelTo": "v"}},
        "xs": {"repeat": {"of": ["xv"], "by": "rot6"}}
      },
      "animate": "compass"
    },
    {
      "id": 13,
      "text": "Draw a circle with centre N2 and opening from O to N5. It crosses the horizontal line at N6, towards O. Draw a vertical line through N6. Turn it round O by 60°, five times.",
      "create": {
        "cY": {"circle": {"centre": "N2", "radiusFrom": ["O", "N5"]}},
        "N6": {"point": {"meet": ["cY", "h"], "pick": {"nearest": "O"}}},
        "yv": {"line": {"through": "N6", "parallelTo": "v"}},
        "ys": {"repeat": {"of": ["yv"], "by": "rot6"}}
      },
      "animate": "compass",
      "textWithoutHelpers": "Draw a circle with centre N2 and opening from O to N5. It crosses the horizontal line at N6, towards O."
    },
    {
      "id": 14,
      "text": "Draw a line through N2 parallel to line OB. Turn it round O by 60°, five times.",
      "create": {
        "connector": {"line": {"through": "N2", "parallelTo": "r30"}},
        "connectors": {"repeat": {"of": ["connector"], "by": "rot6"}}
      },
      "animate": "ruler"
    },
    {
      "id": 15,
      "text": "Join T1, T2, T3, T4, T5 and T6 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["T1", "T2", "T3", "T4", "T5", "T6"]}},
