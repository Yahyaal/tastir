  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size for the next steps.",
      "create": {"h": {"line": {"through": ["O", "A"]}}, "c": {"circle": {"centre": "O", "through": "A"}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a circle with centre A through O. Draw a circle with centre G through O, where the line crosses the first circle on the left.",
      "create": {
        "G": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "cE": {"circle": {"centre": "A", "radiusOf": "c"}},
        "cW": {"circle": {"centre": "G", "radiusOf": "c"}}
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a vertical line through O. It crosses the first circle at D and K. Draw a circle with centre D through O. Draw a circle with centre K through O.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "K": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "cN": {"circle": {"centre": "D", "radiusOf": "c"}},
        "cS": {"circle": {"centre": "K", "radiusOf": "c"}}
      },
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a straight line through B and H, C and J, E and L, and F and M. B, C, E, F, H, J, L and M are where the four new circles cross the first circle. The first circle is now cut into twelve.",
      "create": {
        "C": {"point": {"meet": ["c", "cE"], "pick": {"angle": 60.0}}},
        "L": {"point": {"meet": ["c", "cE"], "pick": {"angle": 300.0}}},
        "E": {"point": {"meet": ["c", "cW"], "pick": {"angle": 120.0}}},
        "J": {"point": {"meet": ["c", "cW"], "pick": {"angle": 240.0}}},
        "B": {"point": {"meet": ["c", "cN"], "pick": {"angle": 30.0}}},
        "F": {"point": {"meet": ["c", "cN"], "pick": {"angle": 150.0}}},
        "H": {"point": {"meet": ["c", "cS"], "pick": {"angle": 210.0}}},
        "M": {"point": {"meet": ["c", "cS"], "pick": {"angle": 330.0}}},
        "r30": {"line": {"through": ["B", "H"]}},
        "r60": {"line": {"through": ["C", "J"]}},
        "r120": {"line": {"through": ["E", "L"]}},
        "r150": {"line": {"through": ["F", "M"]}}
      },
      "highlight": ["cE", "cW", "cN", "cS"],
      "animate": "ruler",
      "textWithoutHelpers": "The four circles cross the first circle at B, C, E, F, H, J, L and M. Draw a straight line through B and H. Draw a straight line through F and M."
    },
    {
      "id": 5,
      "text": "Draw a straight line through B and F, F and K, and K and B. Draw a straight line through D and H, H and M, and M and D. The two triangles make the star at O.",
      "create": {
        "st0": {"line": {"through": ["B", "F"]}},
        "st1": {"line": {"through": ["D", "H"]}},
        "st2": {"line": {"through": ["F", "K"]}},
        "st3": {"line": {"through": ["H", "M"]}},
        "st4": {"line": {"through": ["K", "B"]}},
        "st5": {"line": {"through": ["M", "D"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw a circle with centre A through O. It crosses the horizontal line at N1, right of A. Draw a circle with centre N1 and opening OA. It crosses the horizontal line at N2, right of N1.",
      "create": {
        "c2": {"circle": {"centre": "A", "through": "O"}},
        "N1": {"point": {"meet": ["c2", "h"], "pick": {"farthest": "O"}}},
        "c3": {"circle": {"centre": "N1", "radiusFrom": ["O", "A"]}},
        "N2": {"point": {"meet": ["c3", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Draw a vertical line through N2. Turn it round O by 60°, five times. The six lines frame the tile, with corners T1 to T6.",
      "create": {
        "frame": {"line": {"through": "N2", "parallelTo": "v"}},
        "frames": {"repeat": {"of": ["frame"], "by": "rot6"}},
        "T1": {"point": {"meet": ["frame", "frame@1"]}},
        "T2": {"point": {"meet": ["frame@1", "frame@2"]}},
        "T3": {"point": {"meet": ["frame@2", "frame@3"]}},
        "T4": {"point": {"meet": ["frame@3", "frame@4"]}},
        "T5": {"point": {"meet": ["frame@4", "frame@5"]}},
        "T6": {"point": {"meet": ["frame@5", "frame"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Draw a circle with centre O through N2. It crosses line OB at P, towards T1. Draw a circle with centre T1 through P.",
      "create": {
        "frameCircle": {"circle": {"centre": "O", "through": "N2"}},
        "P": {"point": {"meet": ["frameCircle", "r30"], "pick": {"angle": 30.0}}},
        "small": {"circle": {"centre": "T1", "through": "P"}}
      },
      "animate": "compass"
    },
    {
      "id": 9,
      "text": "Draw a vertical line through T1. Draw lines through T1 parallel to lines OB and FM. Their crossings with the small circle are V1 to V6, counted round it.",
      "create": {
        "cornerRay30": {"line": {"through": "T1", "parallelTo": "r30"}},
        "cornerRay90": {"line": {"through": "T1", "parallelTo": "v"}},
        "cornerRay150": {"line": {"through": "T1", "parallelTo": "r150"}},
        "V1": {"point": {"meet": ["small", "cornerRay30"], "pick": {"farthest": "O"}}},
        "V2": {"point": {"meet": ["small", "cornerRay90"], "pick": {"angle": 36.206}}},
        "V3": {"point": {"meet": ["small", "cornerRay150"], "pick": {"angle": 37.089}}},
        "V4": {"point": {"meet": ["small", "cornerRay30"], "pick": {"nearest": "O"}}},
        "V5": {"point": {"meet": ["small", "cornerRay90"], "pick": {"angle": 22.911}}},
        "V6": {"point": {"meet": ["small", "cornerRay150"], "pick": {"angle": 23.794}}}
      },
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "Draw a straight line through V1 and V3, V3 and V5, and V5 and V1. Draw a straight line through V2 and V4, V4 and V6, and V6 and V2. Turn these six lines round O by 60°, five times.",
      "create": {
        "smallStar0": {"line": {"through": ["V1", "V3"]}},
        "smallStar1": {"line": {"through": ["V2", "V4"]}},
        "smallStar2": {"line": {"through": ["V3", "V5"]}},
        "smallStar3": {"line": {"through": ["V4", "V6"]}},
        "smallStar4": {"line": {"through": ["V5", "V1"]}},
        "smallStar5": {"line": {"through": ["V6", "V2"]}},
        "cornerStars": {
          "repeat": {
