{
  "format": 0,
  "id": "alhambra-arrayanes-squares",
  "title": "Squares and stars of the Patio de los Arrayanes (Alhambra)",
  "fold": 4,
  "style": "Nasrid",
  "level": "beginner",
  "credits": [
    {
      "source": "Tiling Search, data8/PG299: Alhambra, Patio de los Arrayanes",
      "creator": "Brian Wichmann",
      "url": "https://tilingsearch.mit.edu/HTML/data8/PG299.html",
      "note": "The design and the star’s size were read from his line drawing; the construction is ours."
    },
    {
      "source": "Photograph SPA 0111 (zellige dado, Patio de los Arrayanes)",
      "creator": "David Wade",
      "url": "https://patterninislamicart.com/",
      "note": "The real dado: the squares’ size and the pointed ends of the band tiles were read from it."
    }
  ],
  "photos": [
    {
      "file": "alhambra-arrayanes-dado.jpg",
      "caption": "The tiled dado of the Patio de los Arrayanes, Alhambra.",
      "creator": "gema de la fuente",
      "license": "CC BY-SA 2.0",
      "url": "https://commons.wikimedia.org/wiki/File:Mosaico,_la_alhambra_(2).jpg"
    }
  ],
  "given": {
    "O": "The centre of a star.",
    "A": "Halfway from O to the next star."
  },
  "steps": [
    {
      "id": 1,
      "text": "Rule a horizontal line through O and A and draw a circle about O through A. A star will sit at O and at every point two radii away along the diagonals; the bands run between them along the diagonals.",
      "create": {
        "c": { "circle": { "centre": "O", "through": "A" } },
        "h": { "line": { "through": ["O", "A"] } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Rule the vertical through O. At the four points where the circle meets the two lines, rule lines at right angles to them. Draw the circle about O through their corners: it meets the horizontal and vertical at the four corners of the square cell. Rule the cell’s four sides and its two diagonals through O.",
      "create": {
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "P90": { "point": { "meet": ["c", "v"], "pick": { "angle": 90.0 } } },
        "P180": { "point": { "meet": ["c", "h"], "pick": { "angle": 180.0 } } },
        "P270": { "point": { "meet": ["c", "v"], "pick": { "angle": 270.0 } } },
        "gx": { "line": { "through": "A", "perpendicularTo": "h" } },
        "gxw": { "line": { "through": "P180", "perpendicularTo": "h" } },
        "gy": { "line": { "through": "P90", "perpendicularTo": "v" } },
        "gys": { "line": { "through": "P270", "perpendicularTo": "v" } },
        "K": { "point": { "meet": ["gx", "gy"] } },
        "K2": { "point": { "meet": ["gxw", "gy"] } },
        "K3": { "point": { "meet": ["gxw", "gys"] } },
        "K4": { "point": { "meet": ["gx", "gys"] } },
        "d45": { "line": { "through": ["O", "K"] } },
        "d135": { "line": { "through": ["O", "K2"] } },
        "cd": { "circle": { "centre": "O", "through": "K" } },
        "C0": { "point": { "meet": ["cd", "h"], "pick": { "angle": 0.0 } } },
        "C90": { "point": { "meet": ["cd", "v"], "pick": { "angle": 90.0 } } },
        "C180": {
          "point": { "meet": ["cd", "h"], "pick": { "angle": 180.0 } }
        },
        "C270": {
          "point": { "meet": ["cd", "v"], "pick": { "angle": 270.0 } }
        },
        "w1": { "line": { "through": ["C0", "C90"] } },
        "w2": { "line": { "through": ["C90", "C180"] } },
        "w3": { "line": { "through": ["C180", "C270"] } },
        "w4": { "line": { "through": ["C270", "C0"] } }
      },
      "highlight": ["c", "h"],
      "animate": "ruler",
      "textWithoutHelpers": "Rule the vertical through O. Where the circle meets the two lines, rule lines at right angles to them on the left, the right and the top. Draw the circle about O through their corners: it meets the horizontal and vertical at the four corners of the square cell. Rule the cell’s near side and its two diagonals through O."
    },
    {
      "id": 3,
      "text": "Halve the angle between the vertical and the diagonal through K: the 67.5° line meets the top of the inner square at T. Join the top and left points of the circle; that line crosses the other diagonal at Z. Rule the line from Z through T: it crosses the vertical at U.",
      "create": {
        "r67": { "line": { "through": "O", "bisects": ["P90", "O", "K"] } },
        "T": { "point": { "meet": ["r67", "gy"] } },
        "f": { "line": { "through": ["P90", "P180"] } },
        "Z": { "point": { "meet": ["f", "d135"] } },
        "zt": { "line": { "through": ["Z", "T"] } },
        "U": { "point": { "meet": ["zt", "v"] } }
      },
      "highlight": ["P90", "K"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw the circle about P90 through U. It marks two points on the top of the inner square, either side of the vertical. Through them rule lines at right angles to the top.",
      "create": {
        "cu": { "circle": { "centre": "P90", "through": "U" } },
        "V1": {
          "point": { "meet": ["cu", "gy"], "pick": { "angle": 77.236 } }
        },
        "V2": {
          "point": { "meet": ["cu", "gy"], "pick": { "angle": 102.764 } }
        },
        "x1": { "line": { "through": "V1", "perpendicularTo": "gy" } },
        "x2": { "line": { "through": "V2", "perpendicularTo": "gy" } }
      },
      "highlight": ["P90", "U"],
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Where the right one meets the diagonal is a point of the star. Draw the circle about O through it, mark where it meets the horizontal, the vertical and the diagonals, and join every other mark: the star’s two squares.",
      "create": {
        "B45": { "point": { "meet": ["x1", "d45"] } },
        "cb": { "circle": { "centre": "O", "through": "B45" } },
        "B0": { "point": { "meet": ["cb", "h"], "pick": { "angle": 0.0 } } },
        "B90": { "point": { "meet": ["cb", "v"], "pick": { "angle": 90.0 } } },
        "B180": {
          "point": { "meet": ["cb", "h"], "pick": { "angle": 180.0 } }
        },
        "B270": {
          "point": { "meet": ["cb", "v"], "pick": { "angle": 270.0 } }
        },
        "B135": {
          "point": { "meet": ["cb", "d135"], "pick": { "angle": 135.0 } }
        },
        "B225": {
          "point": { "meet": ["cb", "d45"], "pick": { "angle": 225.0 } }
        },
        "B315": {
          "point": { "meet": ["cb", "d135"], "pick": { "angle": 315.0 } }
        },
        "y1": { "line": { "through": ["B45", "B135"] } },
        "y2": { "line": { "through": ["B225", "B315"] } },
        "y3": { "line": { "through": ["B45", "B315"] } },
        "y4": { "line": { "through": ["B135", "B225"] } },
        "bs0": { "line": { "through": ["B0", "B90"] } },
        "bs90": { "line": { "through": ["B90", "B180"] } },
        "bs180": { "line": { "through": ["B180", "B270"] } },
        "bs270": { "line": { "through": ["B270", "B0"] } }
      },
      "highlight": ["x1", "d45"],
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "Draw the circle about the top corner C90 through where circle c meets diagonal d45. It meets the vertical at Q, the corner of the large square that sits at C90. Through Q rule lines parallel to the two diagonals: two sides of that square, and the edges of the bands.",
      "create": {
        "P45": { "point": { "meet": ["c", "d45"], "pick": { "angle": 45.0 } } },
        "ck": { "circle": { "centre": "C90", "through": "P45" } },
        "Q": { "point": { "meet": ["ck", "v"], "pick": { "nearest": "O" } } },
        "e1": { "line": { "through": "Q", "parallelTo": "d45" } },
        "e2": { "line": { "through": "Q", "parallelTo": "d135" } }
      },
      "highlight": ["C90", "d45"],
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Copy the square’s sides to the other three corners of the cell, turning them about O.",
      "create": { "cq": { "repeat": { "of": ["e1", "e2"], "by": "rot4" } } },
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Mark the corners of the pattern: every point where the outline of a piece turns.",
      "create": {
        "M1": { "point": { "meet": ["w3", "e1"] } },
        "M2": { "point": { "meet": ["h", "e1"] } },
        "M3": { "point": { "meet": ["w2", "e1@1"] } },
        "M4": { "point": { "meet": ["w3", "e1@2"] } },
        "M5": { "point": { "meet": ["v", "e1@1"] } },
        "M6": { "point": { "meet": ["w2", "e2"] } },
        "M7": { "point": { "meet": ["x2", "bs180"] } },
        "M8": { "point": { "meet": ["x2", "bs90"] } },
        "M9": { "point": { "meet": ["r67", "y2"] } },
        "M10": { "point": { "meet": ["y1", "bs90"] } },
        "M11": { "point": { "meet": ["w4", "e1@1"] } },
        "M12": { "point": { "meet": ["y2", "bs270"] } },
        "M13": { "point": { "meet": ["r67", "y1"] } },
        "M14": { "point": { "meet": ["w1", "e1"] } },
        "M15": { "point": { "meet": ["x1", "bs270"] } },
        "M16": { "point": { "meet": ["x1", "bs0"] } },
        "M17": { "point": { "meet": ["h", "e2"] } },
        "M18": { "point": { "meet": ["w4", "e2"] } },
        "M19": { "point": { "meet": ["w1", "e1@2"] } }
      },
      "animate": "fade"
    },
    {
      "id": 9,
      "text": "The tile is the square cell.",
      "create": { "tile": { "polygon": ["C0", "C90", "C180", "C270"] } },
      "animate": "fade"
    }
  ],
  "ink": {
    "text": "Ink the star at O, the large squares at the corners, and the seams that run along the horizontal and vertical from each square’s corner to the star’s point.",
    "paths": [
      { "through": ["M1", "M2"] },
      { "through": ["M3", "M2"] },
      { "through": ["M4", "M5"] },
      { "through": ["M6", "Q"] },
      { "through": ["M2", "B180"] },
      { "through": ["B180", "M7"] },
      { "through": ["B180", "M8"] },
      { "through": ["B225", "M7"] },
      { "through": ["B225", "M9"] },
      { "through": ["M8", "B135"] },
      { "through": ["B135", "M10"] },
      { "through": ["M9", "B270"] },
      { "through": ["M10", "B90"] },
      { "through": ["M5", "B270"] },
      { "through": ["M5", "M11"] },
      { "through": ["B270", "M12"] },
      { "through": ["B90", "Q"] },
      { "through": ["B90", "M13"] },
      { "through": ["Q", "M14"] },
      { "through": ["M12", "B315"] },
      { "through": ["M13", "B45"] },
      { "through": ["B315", "M15"] },
      { "through": ["M15", "B0"] },
      { "through": ["M16", "B45"] },
      { "through": ["M16", "B0"] },
      { "through": ["B0", "M17"] },
      { "through": ["M17", "M18"] },
      { "through": ["M17", "M19"] }
    ]
  },
  "pattern": {
    "cell": "tile",
    "text": "Repeat the square cell edge to edge: a large square in each gap of the band grid, and a small star where the bands cross.",
    "palette": "Alhambra",
    "colors": { "square": "c", "band": "ground", "star": "d" }
  },
  "expect": {
    "pieceTypes": 3,
    "pieces": [
      { "name": "square", "vertices": 4, "area": 2, "perCell": 1 },
      { "name": "band", "vertices": 14, "area": 0.87975, "perCell": 2 },
      { "name": "star", "vertices": 16, "area": 0.2405, "perCell": 1 }
    ]
  }
}
