  "given": {
    "O": "The centre of a star.",
    "A": "Halfway from O to the next star."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {
        "c": { "circle": { "centre": "O", "through": "A" } },
        "h": { "line": { "through": ["O", "A"] } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw the square tile.",
      "parts": [
        {
          "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D.",
          "create": {
            "v": { "line": { "through": "O", "perpendicularTo": "h" } },
            "C": { "point": { "meet": ["c", "v"], "pick": { "angle": 90.0 } } },
            "B": { "point": { "meet": ["c", "h"], "pick": { "angle": 180.0 } } },
            "D": { "point": { "meet": ["c", "v"], "pick": { "angle": 270.0 } } }
          },
          "highlight": ["c", "h"],
          "animate": "ruler"
        },
        {
          "text": "Draw a vertical line through A. Draw a vertical line through B. Draw a horizontal line through C. Draw a horizontal line through D. These four lines make a square with corners E, F, G and H.",
          "textWithoutHelpers": "Draw a vertical line through A. Draw a vertical line through B. Draw a horizontal line through C. These lines cross at E and F.",
          "create": {
            "gx": { "line": { "through": "A", "perpendicularTo": "h" } },
            "gxw": { "line": { "through": "B", "perpendicularTo": "h" } },
            "gy": { "line": { "through": "C", "perpendicularTo": "v" } },
            "gys": { "line": { "through": "D", "perpendicularTo": "v" } },
            "E": { "point": { "meet": ["gx", "gy"] } },
            "F": { "point": { "meet": ["gxw", "gy"] } },
            "G": { "point": { "meet": ["gxw", "gys"] } },
            "H": { "point": { "meet": ["gx", "gys"] } }
          },
          "highlight": ["A", "B", "C", "D"],
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through O and E. Draw a straight line through O and F. Draw a circle with centre O through E. This circle crosses the horizontal line at J and L, and the vertical line at K and N.",
          "create": {
            "d45": { "line": { "through": ["O", "E"] } },
            "d135": { "line": { "through": ["O", "F"] } },
            "cd": { "circle": { "centre": "O", "through": "E" } },
            "J": { "point": { "meet": ["cd", "h"], "pick": { "angle": 0.0 } } },
            "K": { "point": { "meet": ["cd", "v"], "pick": { "angle": 90.0 } } },
            "L": { "point": { "meet": ["cd", "h"], "pick": { "angle": 180.0 } } },
            "N": { "point": { "meet": ["cd", "v"], "pick": { "angle": 270.0 } } }
          },
          "highlight": ["E", "F"],
          "animate": "ruler"
        },
        {
          "text": "Join J, K, L and N with straight lines. This square is the tile that repeats.",
          "textWithoutHelpers": "Draw a straight line through J and K. It is one side of the square tile JKLN.",
          "create": {
            "w1": { "line": { "through": ["J", "K"] } },
            "w2": { "line": { "through": ["K", "L"] } },
            "w3": { "line": { "through": ["L", "N"] } },
            "w4": { "line": { "through": ["N", "J"] } }
          },
          "highlight": ["J", "K", "L", "N"],
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 3,
      "text": "Find point U.",
      "parts": [
        {
          "text": "Draw the line through O that halves the angle COE. It crosses line FE at T.",
          "create": {
            "r67": { "line": { "through": "O", "bisects": ["C", "O", "E"] } },
            "T": { "point": { "meet": ["r67", "gy"] } }
          },
          "highlight": ["C", "E"],
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through B and C. It crosses line OF at Z.",
          "create": {
            "f": { "line": { "through": ["C", "B"] } },
            "Z": { "point": { "meet": ["f", "d135"] } }
          },
          "highlight": ["B", "C"],
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through Z and T. It crosses the vertical line at U.",
          "create": {
            "zt": { "line": { "through": ["Z", "T"] } },
            "U": { "point": { "meet": ["zt", "v"] } }
          },
          "highlight": ["Z", "T"],
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 4,
      "text": "Draw a circle with centre C through U. It crosses line FE at V and W. Draw a vertical line through V. Draw a vertical line through W.",
      "create": {
        "cu": { "circle": { "centre": "C", "through": "U" } },
        "V": { "point": { "meet": ["cu", "gy"], "pick": { "angle": 77.236 } } },
        "W": { "point": { "meet": ["cu", "gy"], "pick": { "angle": 102.764 } } },
        "x1": { "line": { "through": "V", "perpendicularTo": "gy" } },
        "x2": { "line": { "through": "W", "perpendicularTo": "gy" } }
      },
      "highlight": ["C", "U"],
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Draw the star.",
      "parts": [
        {
          "text": "Draw a circle with centre O through S1, where the vertical line through V crosses line OE.",
          "create": {
            "S1": { "point": { "meet": ["x1", "d45"] } },
            "cb": { "circle": { "centre": "O", "through": "S1" } },
            "S8": { "point": { "meet": ["cb", "h"], "pick": { "angle": 0.0 } } },
            "S2": { "point": { "meet": ["cb", "v"], "pick": { "angle": 90.0 } } },
            "S4": { "point": { "meet": ["cb", "h"], "pick": { "angle": 180.0 } } },
            "S6": { "point": { "meet": ["cb", "v"], "pick": { "angle": 270.0 } } },
            "S3": { "point": { "meet": ["cb", "d135"], "pick": { "angle": 135.0 } } },
            "S5": { "point": { "meet": ["cb", "d45"], "pick": { "angle": 225.0 } } },
            "S7": { "point": { "meet": ["cb", "d135"], "pick": { "angle": 315.0 } } }
          },
          "highlight": ["x1", "d45"],
          "animate": "compass"
        },
        {
          "text": "Draw a straight line through S1 and S3. Draw a straight line through S5 and S7. S1, S3, S5 and S7 are where the circle crosses lines OE and OF. The vertical lines through V and W are the other two sides of this square.",
          "create": {
            "y1": { "line": { "through": ["S1", "S3"] } },
            "y2": { "line": { "through": ["S5", "S7"] } },
            "y3": { "line": { "through": ["S1", "S7"] } },
            "y4": { "line": { "through": ["S3", "S5"] } }
          },
          "animate": "ruler"
        },
        {
          "text": "Join S2, S4, S6 and S8 with straight lines. This makes a second square. The two squares make the star.",
          "create": {
            "bs0": { "line": { "through": ["S8", "S2"] } },
            "bs90": { "line": { "through": ["S2", "S4"] } },
            "bs180": { "line": { "through": ["S4", "S6"] } },
            "bs270": { "line": { "through": ["S6", "S8"] } }
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 6,
      "text": "Draw the large square at K.",
      "parts": [
        {
          "text": "Draw a circle with centre K through R, where the circle through A crosses line OE. It crosses the vertical line at Q1.",
          "create": {
            "R": { "point": { "meet": ["c", "d45"], "pick": { "angle": 45.0 } } },
            "ck": { "circle": { "centre": "K", "through": "R" } },
            "Q1": { "point": { "meet": ["ck", "v"], "pick": { "nearest": "O" } } }
          },
          "highlight": ["K", "R"],
          "animate": "compass"
        },
        {
          "text": "Draw a line through Q1 parallel to line OE. Draw a line through Q1 parallel to line OF.",
          "create": {
            "e1": { "line": { "through": "Q1", "parallelTo": "d45" } },
            "e2": { "line": { "through": "Q1", "parallelTo": "d135" } }
          },
          "highlight": ["Q1"],
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 7,
      "text": "Draw a line through Q2 parallel to line OF. Draw a line through Q4 parallel to line OE. Q2 and Q4 are where the lines through Q1 cross the horizontal line. The four lines make a square with corners Q1, Q2, Q3 and Q4.",
      "create": {
        "Q2": { "point": { "meet": ["h", "e1"] } },
        "Q4": { "point": { "meet": ["h", "e2"] } },
        "e3": { "line": { "through": "Q2", "parallelTo": "d135" } },
        "e4": { "line": { "through": "Q4", "parallelTo": "d45" } },
        "Q3": { "point": { "meet": ["e3", "e4"] } }
      },
      "highlight": ["e1", "e2"],
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Mark each point where the outline of a piece changes direction.",
      "create": {
        "M1": { "point": { "meet": ["w3", "e1"] } },
        "M2": { "point": { "meet": ["h", "e1"] } },
        "M3": { "point": { "meet": ["w2", "e3"] } },
        "M4": { "point": { "meet": ["w3", "e4"] } },
