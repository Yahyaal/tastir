  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size until the end.",
      "create": {
        "h": { "line": { "through": ["O", "A"] } },
        "c": { "circle": { "centre": "O", "through": "A" } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a circle with centre A through O. Draw a circle with centre D through O, where the line crosses the first circle on the left. The two new circles touch at O.",
      "create": {
        "D": { "point": { "meet": ["c", "h"], "pick": { "angle": 180 } } },
        "cE": { "circle": { "centre": "A", "radiusOf": "c" } },
        "cW": { "circle": { "centre": "D", "radiusOf": "c" } }
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a circle with centre B through O. Draw a circle with centre C through O. Draw a circle with centre E through O. Draw a circle with centre F through O. B, C, E and F are where the two new circles cross the first one. Six circles now ring the first circle.",
      "create": {
        "B": { "point": { "meet": ["c", "cE"], "pick": { "angle": 60 } } },
        "F": { "point": { "meet": ["c", "cE"], "pick": { "angle": 300 } } },
        "C": { "point": { "meet": ["c", "cW"], "pick": { "angle": 120 } } },
