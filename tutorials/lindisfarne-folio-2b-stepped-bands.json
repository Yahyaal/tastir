{
  "format": 0,
  "id": "lindisfarne-folio-2b-stepped-bands",
  "title": "Stepped bands from folio 2b of the Lindisfarne Gospels",
  "short": "Lindisfarne stepped bands",
  "subtitle": "Lindisfarne Gospels, folio 2b, pattern 1",
  "given": {
    "O": "The centre where four small squares meet.",
    "A": "One small-square side to the right of O."
  },
  "fold": 4,
  "style": "Celtic",
  "level": "intermediate",
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s L34A drawing. Its plain tile corners lie exactly on an integer grid, with a repeat sixteen small-square sides wide. Compass steps give that grid; four diagonals through the seventh mark close the outer stepped bands. This is a Celtic manuscript pattern, not an attribution to an Islamic building. The drawing gives no steps; we devised the construction.",
    "changes": "The compass steps, their order and the named points are ours. The finished tile edges follow the plain drawing. The palette is illustrative; the manuscript page was not independently checked.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data1/L34A: Lindisfarne Gospels, folio 2b, pattern 1",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data1/L34A.html",
      "note": "Read from his finished drawing, not construction instructions. His references are Janet Backhouse, The Lindisfarne Gospels (Phaidon, 1981), page 34 and pattern 1 from folio 2b."
    }
  ],
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at C, above O. Draw a straight line through A and C.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "ac": {"line": {"through": ["A", "C"]}}
      },
      "animate": "ruler",
      "textWithoutHelpers": "Draw a vertical line through O. It crosses the circle at C, above O."
    },
    {
      "id": 3,
      "text": "Keep the compass open to OA. Draw circles with centres A, B1 and B2 in turn. Each circle crosses the horizontal line to the right at B1, B2 and B3.",
      "create": {
        "cb1": {"circle": {"centre": "A", "radiusFrom": ["O", "A"]}},
        "B1": {"point": {"meet": ["cb1", "h"], "pick": {"farthest": "O"}}},
        "cb2": {"circle": {"centre": "B1", "radiusFrom": ["O", "A"]}},
        "B2": {"point": {"meet": ["cb2", "h"], "pick": {"farthest": "O"}}},
        "cb3": {"circle": {"centre": "B2", "radiusFrom": ["O", "A"]}},
        "B3": {"point": {"meet": ["cb3", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a vertical line through each of A, B1, B2 and B3. Turn these four lines round O by 90°, three times.",
      "create": {
        "a0": {"line": {"through": "A", "parallelTo": "v"}},
        "a1": {"line": {"through": "B1", "parallelTo": "v"}},
        "a2": {"line": {"through": "B2", "parallelTo": "v"}},
        "a3": {"line": {"through": "B3", "parallelTo": "v"}},
        "ap": {"repeat": {"of": ["a0", "a1", "a2", "a3"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Keep the compass open to OA. Draw circles with centres B3, B4, B5 and B6 in turn. Each circle crosses the horizontal line to the right at B4, B5, B6 and B7.",
      "create": {
        "cb4": {"circle": {"centre": "B3", "radiusFrom": ["O", "A"]}},
        "B4": {"point": {"meet": ["cb4", "h"], "pick": {"farthest": "O"}}},
        "cb5": {"circle": {"centre": "B4", "radiusFrom": ["O", "A"]}},
        "B5": {"point": {"meet": ["cb5", "h"], "pick": {"farthest": "O"}}},
        "cb6": {"circle": {"centre": "B5", "radiusFrom": ["O", "A"]}},
        "B6": {"point": {"meet": ["cb6", "h"], "pick": {"farthest": "O"}}},
        "cb7": {"circle": {"centre": "B6", "radiusFrom": ["O", "A"]}},
        "B7": {"point": {"meet": ["cb7", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "Draw a vertical line through each of B4, B5, B6 and B7. Turn these four lines round O by 90°, three times.",
      "create": {
        "b0": {"line": {"through": "B4", "parallelTo": "v"}},
        "b1": {"line": {"through": "B5", "parallelTo": "v"}},
        "b2": {"line": {"through": "B6", "parallelTo": "v"}},
        "b3": {"line": {"through": "B7", "parallelTo": "v"}},
        "bp": {"repeat": {"of": ["b0", "b1", "b2", "b3"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Draw a line through B6 parallel to line AC. Turn it round O by 90°, three times.",
      "create": {
        "dd": {"line": {"through": "B6", "parallelTo": "ac"}},
        "dp": {"repeat": {"of": ["dd"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "The vertical line through B7 and its three turns make a square with corners K1, K2, K3 and K4.",
      "create": {
        "K1": {"point": {"meet": ["b3", "b3@1"]}},
        "K2": {"point": {"meet": ["b3@1", "b3@2"]}},
        "K3": {"point": {"meet": ["b3@2", "b3@3"]}},
        "K4": {"point": {"meet": ["b3@3", "b3"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
