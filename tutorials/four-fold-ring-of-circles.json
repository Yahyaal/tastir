{
  "format": 0,
  "id": "four-fold-ring-of-circles",
  "title": "Four-fold ring of circles",
  "fold": 4,
  "style": "Mughal",
  "level": "advanced",
  "credits": [
    {
      "source": "4fold Pattern Tutorial",
      "creator": "Sandy Kurt",
      "url": "https://sandykurt.com/free-tutorials",
      "note": "The ring of small circles touching the axes and diagonals, a lying and a standing square in each, and the choice of lines to ink follow this tutorial; our steps group the drawing differently and the text is our own.",
      "steps": [7, 8, 9, 10]
    }
  ],
  "given": {
    "O": "The centre of the drawing.",
    "A": "Any point to the right of O. The distance OA is the radius, and the unit for every length."
  },
  "steps": [
    {
      "id": 1,
      "text": "Put the compass point on the centre and draw a circle.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a horizontal line through the centre, then a vertical line at right angles to it. They cut the circle at four points.",
      "create": {
        "h": {"line": {"through": ["O", "A"]}},
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "E": {"point": {"meet": ["c", "h"], "pick": {"angle": 0}}},
        "N": {"point": {"meet": ["c", "v"], "pick": {"angle": 90}}},
        "W": {"point": {"meet": ["c", "h"], "pick": {"angle": 180}}},
        "S": {"point": {"meet": ["c", "v"], "pick": {"angle": 270}}}
      },
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Halve each right angle to get the two diagonals. The circle is now divided into eight equal parts.",
      "create": {
        "d1": {"line": {"through": "O", "bisects": ["E", "O", "N"]}},
        "d2": {"line": {"through": "O", "bisects": ["N", "O", "W"]}},
        "NE": {"point": {"meet": ["c", "d1"], "pick": {"angle": 45}}},
        "NW": {"point": {"meet": ["c", "d2"], "pick": {"angle": 135}}},
        "SW": {"point": {"meet": ["c", "d1"], "pick": {"angle": 225}}},
        "SE": {"point": {"meet": ["c", "d2"], "pick": {"angle": 315}}}
      },
      "highlight": ["h", "v"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Join the four points on the horizontal and vertical lines. This is the dynamic square, standing on its corner.",
      "create": {"dynamic": {"polygon": ["E", "N", "W", "S"]}},
      "highlight": ["E", "N", "W", "S"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Join the four points on the diagonals. This is the static square, sitting flat. The two squares cross each other at eight points.",
      "create": {
        "static": {"polygon": ["NE", "NW", "SW", "SE"]},
        "k": {"points": {"meet": ["dynamic", "static"], "pick": {"all": "byAngle"}}}
      },
      "highlight": ["NE", "NW", "SW", "SE"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw the square that just touches the circle: a line at right angles to the horizontal at each side, and at right angles to the vertical at the top and bottom. This square is the tile that will repeat.",
      "create": {
        "tE": {"line": {"through": "E", "perpendicularTo": "h"}},
        "tW": {"line": {"through": "W", "perpendicularTo": "h"}},
        "tN": {"line": {"through": "N", "perpendicularTo": "v"}},
        "tS": {"line": {"through": "S", "perpendicularTo": "v"}},
        "c1": {"point": {"meet": ["tE", "tN"]}},
        "c2": {"point": {"meet": ["tN", "tW"]}},
        "c3": {"point": {"meet": ["tW", "tS"]}},
        "c4": {"point": {"meet": ["tS", "tE"]}},
        "cell": {"polygon": ["c1", "c2", "c3", "c4"]}
      },
      "highlight": ["E", "N", "W", "S"],
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Put the compass on the crossing of the two squares just above the horizontal on the right, and open it until the circle just touches the horizontal and the diagonal. Keep that opening and draw the same small circle on the other seven crossings, on the centre, and on the four corners of the tile.",
      "create": {
        "ring1": {"circle": {"centre": "k.1", "tangentTo": ["h", "d1"]}},
        "ring_O": {"circle": {"centre": "O", "radiusOf": "ring1"}},
        "ring_c1": {"circle": {"centre": "c1", "radiusOf": "ring1"}},
        "ring_c2": {"circle": {"centre": "c2", "radiusOf": "ring1"}},
        "ring_c3": {"circle": {"centre": "c3", "radiusOf": "ring1"}},
        "ring_c4": {"circle": {"centre": "c4", "radiusOf": "ring1"}},
        "ring_k2": {"circle": {"centre": "k.2", "radiusOf": "ring1"}},
        "ring_k3": {"circle": {"centre": "k.3", "radiusOf": "ring1"}},
        "ring_k4": {"circle": {"centre": "k.4", "radiusOf": "ring1"}},
        "ring_k5": {"circle": {"centre": "k.5", "radiusOf": "ring1"}},
        "ring_k6": {"circle": {"centre": "k.6", "radiusOf": "ring1"}},
        "ring_k7": {"circle": {"centre": "k.7", "radiusOf": "ring1"}},
        "ring_k8": {"circle": {"centre": "k.8", "radiusOf": "ring1"}}
      },
      "highlight": ["k", "h", "d1"],
      "animate": "compass"
    },
    {
