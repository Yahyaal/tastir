        },
        "X7": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 292.5 } }
        },
        "X8": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 337.5 } }
        }
      },
      "highlight": ["NE", "NW", "SW", "SE"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw a vertical line through each of E and W. Draw a horizontal line through each of N and S. These lines make a square with corners J, K, L and M. Join J, K, L and M to mark the tile that repeats.",
      "create": {
        "tE": { "line": { "through": "E", "perpendicularTo": "h" } },
        "tW": { "line": { "through": "W", "perpendicularTo": "h" } },
        "tN": { "line": { "through": "N", "perpendicularTo": "v" } },
        "tS": { "line": { "through": "S", "perpendicularTo": "v" } },
        "J": { "point": { "meet": ["tE", "tN"] } },
        "K": { "point": { "meet": ["tN", "tW"] } },
        "L": { "point": { "meet": ["tW", "tS"] } },
        "M": { "point": { "meet": ["tS", "tE"] } },
        "cell": { "polygon": ["J", "K", "L", "M"] }
      },
      "highlight": ["E", "N", "W", "S"],
      "animate": "ruler"
    },
    {
