{
  "format": 0,
  "id": "four-fold-ring-of-circles",
  "title": "Four-fold ring of circles",
  "fold": 4,
  "style": "Mughal",
  "level": "advanced",
  "construction": {
    "basis": "instructions",
    "fidelity": "adapted",
    "note": "The ring circles, squares and ink follow Sandy Kurt’s 4fold Pattern Tutorial. The work log records an exact final-ink overlay.",
    "changes": "The app groups the square sides by direction and draws shared long lines once. The current 12 steps are not the PDF’s 12 numbered operations; later simplification also removed intermediate mark points. No monument match is established.",
    "reviewed": "2026-10-21"
  },
  "credits": [
    {
      "source": "4fold Pattern Tutorial",
      "creator": "Sandy Kurt",
      "url": "https://static.showit.co/file/JehTNJA6SfGzf5iSMbgYiw/141862/4fold_pattern.pdf",
      "note": "The ring of small circles touching the axes and diagonals, a lying and a standing square in each, and the choice of lines to ink follow this tutorial; our steps group the drawing differently and the text is our own.",
      "steps": [
        7,
        8,
        9,
        10,
        11,
        12
      ],
      "kind": "tutorial"
    }
  ],
  "given": {
    "O": "The centre of the drawing.",
    "A": "Any point to the right of O. The distance OA is the radius, and the unit for every length."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a circle with centre O through A.",
      "create": { "c": { "circle": { "centre": "O", "through": "A" } } },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a horizontal straight line through O and A. Draw a vertical line through O. The two lines cross the circle at E, N, W and S. These letters stand for east, north, west and south.",
      "create": {
        "h": { "line": { "through": ["O", "A"] } },
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "E": { "point": { "meet": ["c", "h"], "pick": { "angle": 0 } } },
        "N": { "point": { "meet": ["c", "v"], "pick": { "angle": 90 } } },
        "W": { "point": { "meet": ["c", "h"], "pick": { "angle": 180 } } },
        "S": { "point": { "meet": ["c", "v"], "pick": { "angle": 270 } } }
      },
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw the lines through O that halve the angles at O between E and N, and between N and W. These lines cross the circle at NE, NW, SW and SE.",
      "create": {
        "d1": { "line": { "through": "O", "bisects": ["E", "O", "N"] } },
        "d2": { "line": { "through": "O", "bisects": ["N", "O", "W"] } },
        "NE": { "point": { "meet": ["c", "d1"], "pick": { "angle": 45 } } },
        "NW": { "point": { "meet": ["c", "d2"], "pick": { "angle": 135 } } },
        "SW": { "point": { "meet": ["c", "d1"], "pick": { "angle": 225 } } },
        "SE": { "point": { "meet": ["c", "d2"], "pick": { "angle": 315 } } }
      },
      "highlight": ["h", "v"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Join E, N, W and S with straight lines. This square stands on its corner.",
      "create": { "dynamic": { "polygon": ["E", "N", "W", "S"] } },
      "highlight": ["E", "N", "W", "S"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Join NE, NW, SW and SE with straight lines. This square sits flat. The two squares cross at X1 to X8.",
      "create": {
        "static": { "polygon": ["NE", "NW", "SW", "SE"] },
        "X1": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 22.5 } }
        },
        "X2": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 67.5 } }
        },
        "X3": {
