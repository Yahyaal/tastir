{
  "format": 0,
  "id": "isfahan-seyyed-stars",
  "title": "Stars and pentagons of the Seyyed mosque (Isfahan)",
  "short": "Seyyed mosque stars",
  "subtitle": "Masjid-e Sayyed, Isfahan",
  "given": {"O": "The centre of a blue star.", "A": "A point of that star."},
  "fold": 4,
  "star": 8,
  "style": "Persian",
  "region": "Iran",
  "level": "advanced",
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s IRAN2 drawing. Its tile corners were snapped to the square-root-of-two grid with the star’s point radius as the unit. The stars stand two apart along the lines of a larger pattern, so every line is at one of four distances from O, or at the same distances from the corner of the tile. The drawing gives no steps; we devised the construction.",
    "changes": "The compass steps, their order and the named points are ours. The tile edges follow the plain drawing; its white strokes over the joints are not bands. The colours follow Wichmann’s drawing: blue stars and blue ten-sided crosses mark the larger pattern among the gold stars. His second drawing of the panel (IRAN4) draws that larger pattern as lines over the same pieces; the lines are not inked here. No photograph was checked.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data209/IRAN2: Masjid-e Sayyed, Isfahan",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data209/IRAN2.html",
      "note": "Read from his finished drawing, not construction instructions. His reference is a Flickr photograph, IranD47, of a low-level pattern at the Seyyed mosque, Isfahan (personal communication)."
    }
  ],
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at C and D. The horizontal line crosses the circle at B on the left. Draw a vertical line through A. Draw a horizontal line through C. They cross at E. Draw a straight line through O and E. Draw a line through O at 90° to line OE. The circle crosses the four lines through O at S1 to S8.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "ax": {"line": {"through": "A", "perpendicularTo": "h"}},
        "cy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "E": {"point": {"meet": ["ax", "cy"]}},
        "d45": {"line": {"through": ["O", "E"]}},
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}},
        "S1": {"point": {"meet": ["c", "h"], "pick": {"angle": 0.0}}},
        "S2": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "S3": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "S4": {"point": {"meet": ["c", "d135"], "pick": {"angle": 135.0}}},
        "S5": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "S6": {"point": {"meet": ["c", "d45"], "pick": {"angle": 225.0}}},
        "S7": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "S8": {"point": {"meet": ["c", "d135"], "pick": {"angle": 315.0}}}
      },
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw the star at O as two squares.",
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S3, S3 and S5, S5 and S7, and S7 and S1. Draw each line long, beyond the circle.",
          "create": {
            "q01": {"line": {"through": ["S1", "S3"]}},
            "q02": {"line": {"through": ["S3", "S5"]}},
            "q03": {"line": {"through": ["S5", "S7"]}},
            "q04": {"line": {"through": ["S7", "S1"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S4, S4 and S6, S6 and S8, and S8 and S2. Draw each line long, beyond the circle.",
          "create": {
            "q11": {"line": {"through": ["S2", "S4"]}},
            "q12": {"line": {"through": ["S4", "S6"]}},
            "q13": {"line": {"through": ["S6", "S8"]}},
            "q14": {"line": {"through": ["S8", "S2"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 4,
      "text": "Keep the compass open to OA. Draw circles with centres A, F1 and F2 in turn. Each circle crosses the horizontal line to the right at F1, F2 and F.",
      "create": {
        "cf0": {"circle": {"centre": "A", "radiusOf": "c"}},
        "F1": {"point": {"meet": ["cf0", "h"], "pick": {"farthest": "O"}}},
        "cf1": {"circle": {"centre": "F1", "radiusOf": "c"}},
        "F2": {"point": {"meet": ["cf1", "h"], "pick": {"farthest": "O"}}},
        "cf2": {"circle": {"centre": "F2", "radiusOf": "c"}},
        "F": {"point": {"meet": ["cf2", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Keep the compass open to OE. Draw circles with centres F and G1 in turn. Each circle crosses the horizontal line to the right at G1 and G2.",
      "create": {
        "cg1": {"circle": {"centre": "F", "radiusFrom": ["O", "E"]}},
        "G1": {"point": {"meet": ["cg1", "h"], "pick": {"farthest": "O"}}},
        "cg2": {"circle": {"centre": "G1", "radiusFrom": ["O", "E"]}},
        "G2": {"point": {"meet": ["cg2", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "Draw a circle with centre O through G2. It crosses the horizontal and vertical lines at T1 to T4.",
      "create": {
        "co": {"circle": {"centre": "O", "through": "G2"}},
        "T1": {"point": {"meet": ["co", "h"], "pick": {"angle": 0.0}}},
        "T2": {"point": {"meet": ["co", "v"], "pick": {"angle": 90.0}}},
        "T3": {"point": {"meet": ["co", "h"], "pick": {"angle": 180.0}}},
        "T4": {"point": {"meet": ["co", "v"], "pick": {"angle": 270.0}}}
      },
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Draw a vertical line through each of T1 and T3. Draw a horizontal line through each of T2 and T4. They make a square with corners K1, K2, K3 and K4.",
      "create": {
        "gx": {"line": {"through": "T1", "parallelTo": "v"}},
        "gy": {"line": {"through": "T2", "parallelTo": "h"}},
        "gxw": {"line": {"through": "T3", "parallelTo": "v"}},
        "gys": {"line": {"through": "T4", "parallelTo": "h"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "The vertical side from S8 to S2 crosses the horizontal line at P. Draw a circle with centre F1 and radius OP. It crosses the horizontal line at M and N. Draw a circle with centre P and radius OE. It crosses the horizontal line at J, beyond P. Draw a vertical line through each of J, M and N. Turn the three new lines round O by 90°, three times.",
      "create": {
        "P": {"point": {"meet": ["q14", "h"]}},
        "cx": {"circle": {"centre": "F1", "radiusFrom": ["O", "P"]}},
        "M": {"point": {"meet": ["cx", "h"], "pick": {"nearest": "O"}}},
        "N": {"point": {"meet": ["cx", "h"], "pick": {"farthest": "O"}}},
        "cp": {"circle": {"centre": "P", "radiusFrom": ["O", "E"]}},
        "J": {"point": {"meet": ["cp", "h"], "pick": {"angle": 0.0}}},
        "vJ": {"line": {"through": "J", "parallelTo": "v"}},
        "vM": {"line": {"through": "M", "parallelTo": "v"}},
        "vN": {"line": {"through": "N", "parallelTo": "v"}},
        "vp": {"repeat": {"of": ["vJ", "vM", "vN"], "by": "rot4"}}
      },
      "animate": "compass"
    },
    {
      "id": 9,
      "text": "Draw four circles with centre K1. Their radii are OP, OJ, OM and ON. They cross the vertical side through T1 at Z1, Z2, Z3 and Z4. Draw a horizontal line through each of Z1 to Z4. Turn the four new lines round O by 90°, three times.",
      "create": {
        "ck1": {"circle": {"centre": "K1", "radiusFrom": ["O", "P"]}},
        "Z1": {"point": {"meet": ["ck1", "gx"], "pick": {"angle": 41.875}}},
        "hz1": {"line": {"through": "Z1", "parallelTo": "h"}},
        "ck2": {"circle": {"centre": "K1", "radiusFrom": ["O", "J"]}},
        "Z2": {"point": {"meet": ["ck2", "gx"], "pick": {"angle": 34.58}}},
        "hz2": {"line": {"through": "Z2", "parallelTo": "h"}},
        "ck3": {"circle": {"centre": "K1", "radiusFrom": ["O", "M"]}},
        "Z3": {"point": {"meet": ["ck3", "gx"], "pick": {"angle": 39.03}}},
        "hz3": {"line": {"through": "Z3", "parallelTo": "h"}},
        "ck4": {"circle": {"centre": "K1", "radiusFrom": ["O", "N"]}},
        "Z4": {"point": {"meet": ["ck4", "gx"], "pick": {"angle": 31.113}}},
        "hz4": {"line": {"through": "Z4", "parallelTo": "h"}},
        "hzp": {"repeat": {"of": ["hz1", "hz2", "hz3", "hz4"], "by": "rot4"}}
      },
      "animate": "compass"
    },
    {
      "id": 10,
      "text": "Draw the diagonals at the same distances from O and from K1.",
      "animate": "compass",
      "parts": [
        {
          "text": "The vertical line through Z4, turned by 270°, crosses the horizontal line at Q. Draw circles with centre O through J, M, N and Q. They cross line OE at R1 to R4. Draw a line through each of R1 to R4 at 90° to line OE. Turn the four new lines round O by 90°, three times.",
          "create": {
            "Q": {"point": {"meet": ["hz4@3", "h"]}},
            "co1": {"circle": {"centre": "O", "through": "J"}},
            "R1": {"point": {"meet": ["co1", "d45"], "pick": {"angle": 45.0}}},
            "dr1": {"line": {"through": "R1", "perpendicularTo": "d45"}},
            "co2": {"circle": {"centre": "O", "through": "M"}},
            "R2": {"point": {"meet": ["co2", "d45"], "pick": {"angle": 45.0}}},
            "dr2": {"line": {"through": "R2", "perpendicularTo": "d45"}},
            "co3": {"circle": {"centre": "O", "through": "N"}},
            "R3": {"point": {"meet": ["co3", "d45"], "pick": {"angle": 45.0}}},
            "dr3": {"line": {"through": "R3", "perpendicularTo": "d45"}},
            "co4": {"circle": {"centre": "O", "through": "Q"}},
            "R4": {"point": {"meet": ["co4", "d45"], "pick": {"angle": 45.0}}},
            "dr4": {"line": {"through": "R4", "perpendicularTo": "d45"}},
            "drp": {"repeat": {"of": ["dr1", "dr2", "dr3", "dr4"], "by": "rot4"}}
          },
          "animate": "compass"
        },
        {
          "text": "Draw a circle with centre K1 and radius OQ. It and the four other circles with centre K1 cross line OE at W1 to W5. Draw a line through each of W1 to W5 at 90° to line OE. Turn the five new lines round O by 90°, three times.",
          "create": {
            "ck5": {"circle": {"centre": "K1", "radiusFrom": ["O", "Q"]}},
            "W1": {"point": {"meet": ["ck1", "d45"], "pick": {"nearest": "O"}}},
            "dw1": {"line": {"through": "W1", "perpendicularTo": "d45"}},
            "W2": {"point": {"meet": ["ck2", "d45"], "pick": {"nearest": "O"}}},
            "dw2": {"line": {"through": "W2", "perpendicularTo": "d45"}},
            "W3": {"point": {"meet": ["ck3", "d45"], "pick": {"nearest": "O"}}},
            "dw3": {"line": {"through": "W3", "perpendicularTo": "d45"}},
            "W4": {"point": {"meet": ["ck4", "d45"], "pick": {"nearest": "O"}}},
            "dw4": {"line": {"through": "W4", "perpendicularTo": "d45"}},
            "W5": {"point": {"meet": ["ck5", "d45"], "pick": {"nearest": "O"}}},
            "dw5": {"line": {"through": "W5", "perpendicularTo": "d45"}},
            "dwp": {"repeat": {"of": ["dw1", "dw2", "dw3", "dw4", "dw5"], "by": "rot4"}}
          },
          "animate": "compass"
        }
      ]
    },
