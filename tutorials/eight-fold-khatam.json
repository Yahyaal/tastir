        "d1": { "line": { "through": "O", "bisects": ["E", "O", "N"] } },
        "d2": { "line": { "through": "O", "bisects": ["N", "O", "W"] } },
        "NE": { "point": { "meet": ["c", "d1"], "pick": { "angle": 45 } } },
        "NW": { "point": { "meet": ["c", "d2"], "pick": { "angle": 135 } } },
        "SW": { "point": { "meet": ["c", "d1"], "pick": { "angle": 225 } } },
        "SE": { "point": { "meet": ["c", "d2"], "pick": { "angle": 315 } } }
      },
      "highlight": ["h", "v"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Join E, N, W and S with straight lines. This square stands on its corner. Its sides cross the lines through NE and NW at M1, M2, M3 and M4.",
      "create": {
        "dynamic": { "polygon": ["E", "N", "W", "S"] },
        "M1": { "point": { "meet": ["dynamic", "d1"], "pick": { "angle": 45 } } },
        "M2": { "point": { "meet": ["dynamic", "d2"], "pick": { "angle": 135 } } },
        "M3": { "point": { "meet": ["dynamic", "d1"], "pick": { "angle": 225 } } },
        "M4": { "point": { "meet": ["dynamic", "d2"], "pick": { "angle": 315 } } }
      },
      "highlight": ["E", "N", "W", "S"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw a horizontal line through N. Draw a horizontal line through S. Draw a vertical line through E. Draw a vertical line through W. Join T1, T2, T3 and T4, where they cross: this square is the tile. Join M1, M2, M3 and M4 with straight lines. They cross the horizontal and vertical lines at J1 to J4, halfway out.",
      "textWithoutHelpers": "Draw a horizontal line through N. Draw a vertical line through E. Draw a vertical line through W. Join T1, T2, T3 and T4: this square is the tile. Join M1, M2, M3 and M4 with straight lines. They cross the horizontal and vertical lines at J1 to J4, halfway out.",
      "create": {
        "hTop": { "line": { "through": "N", "parallelTo": "h" } },
        "hBot": { "line": { "through": "S", "parallelTo": "h" } },
        "vRight": { "line": { "through": "E", "parallelTo": "v" } },
