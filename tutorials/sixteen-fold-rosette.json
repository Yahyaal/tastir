{
  "format": 0,
  "id": "sixteen-fold-rosette",
  "title": "Sixteen-fold rosette",
  "fold": 16,
  "style": "Moroccan",
  "level": "advanced",
  "construction": {
    "basis": "original",
    "fidelity": "not-applicable",
    "note": "This was developed by extending Tastir’s simpler eight-fold rosette to sixteen divisions. The creation commit describes that generalisation; no published sequence is credited.",
    "changes": "It is a construction study, not a reconstruction of the Bou Inania wall. The photographed Bou Inania rosette used in the early comparison was later identified as twelve-fold, and its surrounding network differs substantially.",
    "reviewed": "2026-10-21"
  },
  "credits": [],
  "given": {
    "O": "The centre of the rosette.",
    "A": "Any point to the right of O. The distance OA is the unit for every length."
  },
  "steps": [
    {
      "id": 1,
      "text": "Put the compass point on the centre and draw a circle. Its radius is the unit for the whole pattern.",
      "create": {
        "c": {
          "circle": {
            "centre": "O",
            "through": "A"
          }
        }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw the horizontal through the centre and the vertical at right angles to it. They cut the circle at four points.",
      "create": {
        "h": {
          "line": {
            "through": [
              "O",
              "A"
            ]
          }
        },
        "v": {
          "line": {
            "through": "O",
            "perpendicularTo": "h"
          }
        },
        "E": {
          "point": {
            "meet": [
              "c",
              "h"
            ],
            "pick": {
              "angle": 0
            }
          }
        },
        "N": {
          "point": {
            "meet": [
              "c",
              "v"
            ],
            "pick": {
              "angle": 90
            }
          }
        },
        "W": {
          "point": {
            "meet": [
              "c",
              "h"
            ],
            "pick": {
              "angle": 180
            }
          }
        },
        "S": {
          "point": {
            "meet": [
              "c",
              "v"
            ],
            "pick": {
              "angle": 270
            }
          }
        }
      },
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Halve the four right angles with two diagonals, cutting the circle into eight.",
      "create": {
        "d1": {
          "line": {
            "through": "O",
            "bisects": [
              "E",
              "O",
              "N"
            ]
          }
        },
        "d2": {
          "line": {
            "through": "O",
            "bisects": [
              "N",
              "O",
              "W"
            ]
          }
        },
        "NE": {
          "point": {
            "meet": [
              "c",
              "d1"
            ],
            "pick": {
              "angle": 45
            }
          }
        },
        "NW": {
          "point": {
            "meet": [
              "c",
              "d2"
            ],
            "pick": {
              "angle": 135
            }
          }
        },
        "SW": {
          "point": {
            "meet": [
              "c",
              "d1"
            ],
            "pick": {
              "angle": 225
            }
          }
        },
        "SE": {
          "point": {
            "meet": [
              "c",
              "d2"
            ],
            "pick": {
              "angle": 315
            }
          }
        }
      },
      "highlight": [
        "h",
        "v"
      ],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw the square that just touches the circle at the ends of the horizontal and the vertical. This square is the tile that repeats.",
      "textWithoutHelpers": "Draw the square that just touches the circle at the ends of the horizontal and the vertical (its bottom side is not needed as a line). This square is the tile that repeats.",
      "create": {
        "tE": {
          "line": {
            "through": "E",
            "perpendicularTo": "h"
          }
        },
        "tN": {
          "line": {
            "through": "N",
            "perpendicularTo": "v"
          }
        },
        "tW": {
          "line": {
            "through": "W",
            "perpendicularTo": "h"
          }
        },
        "tS": {
          "line": {
            "through": "S",
            "perpendicularTo": "v"
          }
        },
        "c1": {
          "point": {
            "meet": [
              "tE",
              "tN"
            ]
          }
        },
        "c2": {
          "point": {
            "meet": [
              "tN",
              "tW"
            ]
          }
        },
        "c3": {
          "point": {
            "meet": [
              "tW",
              "tS"
            ]
          }
        },
        "c4": {
          "point": {
            "meet": [
              "tS",
              "tE"
            ]
          }
        },
        "cell": {
          "polygon": [
            "c1",
            "c2",
            "c3",
            "c4"
          ]
        }
      },
      "highlight": [
        "E",
        "N",
        "W",
        "S"
      ],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Halve each of the eight parts with a line through the centre. The circle is now cut into sixteen; mark the new points on it.",
      "textWithoutHelpers": "Halve the first of the eight parts with a line through the centre, and mark the new points on the circle: it is now cut into sixteen.",
      "create": {
        "s1": {
          "line": {
            "through": "O",
            "bisects": [
              "E",
              "O",
              "NE"
            ]
          }
        },
        "s2": {
          "line": {
            "through": "O",
            "bisects": [
              "NE",
              "O",
              "N"
            ]
          }
        },
        "s3": {
          "line": {
            "through": "O",
            "bisects": [
              "N",
              "O",
              "NW"
            ]
          }
        },
        "s4": {
          "line": {
            "through": "O",
            "bisects": [
              "NW",
              "O",
              "W"
            ]
          }
        },
        "m": {
          "point": {
            "meet": [
              "c",
              "s1"
            ],
            "pick": {
              "angle": 22.5
            }
          }
        },
        "mids": {
          "repeat": {
            "of": [
              "m"
            ],
            "by": "rot8"
          }
        }
      },
      "highlight": [
        "E",
        "NE"
      ],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw the line that touches the circle at the first new point. Where it crosses the side of the square is a corner of the sixteen-sided figure that holds the rosette.",
      "create": {
        "tm": {
          "line": {
            "through": "m",
            "perpendicularTo": "s1"
          }
        },
        "a": {
          "point": {
            "meet": [
              "tE",
              "tm"
            ]
          }
        }
      },
      "highlight": [
        "m",
        "tE"
      ],
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Join the centre to that corner. Put the compass point on the corner, open it to the end of the horizontal, and mark where the arc cuts the line to the centre. Do the same all the way round, sixteen times.",
      "create": {
        "sp": {
          "line": {
            "through": [
              "O",
              "a"
            ]
          }
        },
        "q": {
          "circle": {
            "centre": "a",
            "through": "E"
          }
        },
        "C": {
          "point": {
            "meet": [
              "q",
              "sp"
            ],
            "pick": {
              "nearest": "O"
            }
          }
        },
        "marks": {
          "repeat": {
            "of": [
              "q",
              "C"
            ],
            "by": "rot16"
          }
        }
      },
      "highlight": [
        "a",
        "E"
      ],
      "animate": "compass"
    },
    {
      "id": 8,
      "text": "Join each mark to the seventh mark along, all the way round. The sixteen lines make the star at the heart of the rosette.",
      "create": {
        "t": {
          "line": {
            "through": [
              "C",
              "C@7"
            ]
          }
        },
        "star": {
          "repeat": {
            "of": [
              "t"
            ],
            "by": "rot16"
          }
        }
      },
      "highlight": [
        "C",
        "C@7"
      ],
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "From each of the sixteen points on the circle, draw two lines leaning inwards, parallel to the lines from the centre to the fourth and fifth marks. Where they meet the star lines they turn into petals.",
      "textWithoutHelpers": "From each of the sixteen points on the circle, draw two lines leaning inwards, at the slant of the lines from the centre to the fourth and fifth marks. Where they meet the star lines they turn into petals.",
      "create": {
        "r1": {
          "line": {
            "through": [
              "O",
              "C@4"
            ]
          }
        },
        "r2": {
          "line": {
            "through": [
              "O",
              "C@3"
            ]
          }
        },
        "p": {
          "line": {
            "through": "E",
            "parallelTo": "r1"
          }
        },
        "pm": {
          "line": {
            "through": "E",
            "parallelTo": "r2"
          }
        },
        "petals": {
          "repeat": {
            "of": [
              "p",
              "pm"
            ],
            "by": "rot16"
          }
        }
      },
      "highlight": [
        "E",
        "C@3",
        "C@4"
      ],
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "Mark where each leaning line meets its star line, and where each star line crosses the next line through the centre. These are the corners of the petals and the points of the star.",
      "create": {
        "G": {
          "point": {
            "meet": [
              "p",
              "t"
            ]
          }
        },
        "P": {
          "point": {
            "meet": [
              "t",
              "s1"
            ]
          }
        },
        "Gm": {
          "point": {
            "meet": [
              "pm",
              "t@8"
            ]
          }
        },
        "Pm": {
          "point": {
            "meet": [
              "t@8",
              "s4"
            ]
          }
        },
        "corners": {
          "repeat": {
            "of": [
              "G",
              "P",
              "Gm",
              "Pm"
            ],
            "by": "rot16"
          }
        }
      },
      "animate": "fade"
    }
  ],
