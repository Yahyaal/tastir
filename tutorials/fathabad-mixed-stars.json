      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Draw a circle with centre A through O. It crosses the horizontal line at N3, right of A. Draw a circle with centre N3 and opening OA. It crosses that line at N4, right of N3.",
      "create": {
        "two": {"circle": {"centre": "A", "through": "O"}},
        "N3": {"point": {"meet": ["two", "h"], "pick": {"farthest": "O"}}},
