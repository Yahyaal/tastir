{
  "format": 0,
  "id": "damascus-fountain-stars",
  "title": "Star surround of a Damascus fountain",
  "short": "Damascus fountain stars",
  "subtitle": "Fountain surround, Damascus",
  "fold": 6,
  "star": 12,
  "style": "Syrian",
  "level": "advanced",
  "given": {"O": "The centre of a twelve-pointed star.", "A": "Sets its point radius."},
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s DM1 drawing. The drawing gives no steps. The three-square star opening, a square diagonal, compass transfers and one midpoint fix the repeat and every parallel family.",
    "changes": "The teaching frame turns−15°. The plain source boundaries are retained. The compass steps, order and named points are ours. The palette is illustrative. No fountain photograph was independently checked.",
    "reviewed": "2026-10-27"
  },
  "credits": [
    {
      "source": "Tiling Search, data204/DM1: Damascus fountain surround",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data204/DM1.html",
      "note": "The page credits Richard Henry’s photograph of an exterior fountain surround in Damascus, Syria, described as a six-fold cut-stone pattern, supplied by personal communication. The photograph was not independently checked."
    }
  ],
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size for the next steps.",
      "create": {"h": {"line": {"through": ["O", "A"]}}, "c": {"circle": {"centre": "O", "through": "A"}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a circle with centre A through O. Draw a circle with centre G through O, where the line crosses the first circle on the left.",
      "create": {
        "G": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "cE": {"circle": {"centre": "A", "radiusOf": "c"}},
        "cW": {"circle": {"centre": "G", "radiusOf": "c"}}
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a vertical line through O. It crosses the first circle at D and K. Draw a circle with centre D through O. Draw a circle with centre K through O.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "K": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "cN": {"circle": {"centre": "D", "radiusOf": "c"}},
        "cS": {"circle": {"centre": "K", "radiusOf": "c"}}
      },
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a straight line through B and H, C and J, E and L, and F and M. B, C, E, F, H, J, L and M are where the four new circles cross the first circle. The first circle is now cut into twelve.",
      "create": {
        "C": {"point": {"meet": ["c", "cE"], "pick": {"angle": 60.0}}},
        "L": {"point": {"meet": ["c", "cE"], "pick": {"angle": 300.0}}},
        "E": {"point": {"meet": ["c", "cW"], "pick": {"angle": 120.0}}},
        "J": {"point": {"meet": ["c", "cW"], "pick": {"angle": 240.0}}},
        "B": {"point": {"meet": ["c", "cN"], "pick": {"angle": 30.0}}},
        "F": {"point": {"meet": ["c", "cN"], "pick": {"angle": 150.0}}},
        "H": {"point": {"meet": ["c", "cS"], "pick": {"angle": 210.0}}},
        "M": {"point": {"meet": ["c", "cS"], "pick": {"angle": 330.0}}},
        "r30": {"line": {"through": ["B", "H"]}},
        "r60": {"line": {"through": ["C", "J"]}},
        "r120": {"line": {"through": ["E", "L"]}},
        "r150": {"line": {"through": ["F", "M"]}}
      },
      "highlight": ["cE", "cW", "cN", "cS"],
      "animate": "ruler",
      "textWithoutHelpers": "The four circles cross the first circle at B, C, E, F, H, J, L and M. Draw a straight line through B and H, E and L, and F and M."
    },
    {
      "id": 5,
      "text": "Draw the lines through O that halve angles AOB, BOC and COD. Draw a line through O at 90° to each new line. The circle’s twelve points on these lines are S1 to S12, counted round it.",
      "create": {
        "r15": {"line": {"through": "O", "bisects": ["A", "O", "B"]}},
        "r45": {"line": {"through": "O", "bisects": ["B", "O", "C"]}},
        "r75": {"line": {"through": "O", "bisects": ["C", "O", "D"]}},
        "r105": {"line": {"through": "O", "perpendicularTo": "r15"}},
        "r135": {"line": {"through": "O", "perpendicularTo": "r45"}},
        "r165": {"line": {"through": "O", "perpendicularTo": "r75"}},
        "S1": {"point": {"meet": ["c", "r15"], "pick": {"angle": 15.0}}},
        "S2": {"point": {"meet": ["c", "r45"], "pick": {"angle": 45.0}}},
        "S3": {"point": {"meet": ["c", "r75"], "pick": {"angle": 75.0}}},
        "S4": {"point": {"meet": ["c", "r105"], "pick": {"angle": 105.0}}},
        "S5": {"point": {"meet": ["c", "r135"], "pick": {"angle": 135.0}}},
        "S6": {"point": {"meet": ["c", "r165"], "pick": {"angle": 165.0}}},
        "S7": {"point": {"meet": ["c", "r15"], "pick": {"angle": 195.0}}},
        "S8": {"point": {"meet": ["c", "r45"], "pick": {"angle": 225.0}}},
        "S9": {"point": {"meet": ["c", "r75"], "pick": {"angle": 255.0}}},
        "S10": {"point": {"meet": ["c", "r105"], "pick": {"angle": 285.0}}},
        "S11": {"point": {"meet": ["c", "r135"], "pick": {"angle": 315.0}}},
        "S12": {"point": {"meet": ["c", "r165"], "pick": {"angle": 345.0}}}
      },
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw the three squares that make the twelve-pointed star.",
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S4, S4 and S7, S7 and S10, and S10 and S1.",
          "create": {
            "st0": {"line": {"through": ["S1", "S4"]}},
            "st3": {"line": {"through": ["S4", "S7"]}},
            "st6": {"line": {"through": ["S7", "S10"]}},
            "st9": {"line": {"through": ["S10", "S1"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S5, S5 and S8, S8 and S11, and S11 and S2.",
          "create": {
            "st1": {"line": {"through": ["S2", "S5"]}},
            "st4": {"line": {"through": ["S5", "S8"]}},
            "st7": {"line": {"through": ["S8", "S11"]}},
            "st10": {"line": {"through": ["S11", "S2"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S3 and S6, S6 and S9, S9 and S12, and S12 and S3.",
          "create": {
            "st2": {"line": {"through": ["S3", "S6"]}},
            "st5": {"line": {"through": ["S6", "S9"]}},
            "st8": {"line": {"through": ["S9", "S12"]}},
            "st11": {"line": {"through": ["S12", "S3"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 7,
      "text": "Draw a vertical line through A. Draw a horizontal line through D. They cross at P1. Draw a circle with centre O through P1. It crosses the horizontal line at N1, right of A.",
      "create": {
        "ax": {"line": {"through": "A", "parallelTo": "v"}},
        "dy": {"line": {"through": "D", "parallelTo": "h"}},
        "P1": {"point": {"meet": ["ax", "dy"]}},
        "root2": {"circle": {"centre": "O", "through": "P1"}},
        "N1": {"point": {"meet": ["root2", "h"], "pick": {"angle": 0.0}}}
      },
      "animate": "compass",
      "textWithoutHelpers": "P1 is where the vertical through A crosses the horizontal through D. Draw a circle with centre O through P1. It crosses the horizontal line at N1, right of A."
    },
    {
      "id": 8,
      "text": "Draw a vertical line through S1. It crosses the horizontal line at N2. Draw a circle with centre N1 and opening from O to N2. It crosses the horizontal line at N3, right of N1. Draw a circle with centre N3, with the same opening. It crosses the horizontal line at N4, right of N3.",
      "create": {
        "projection": {"line": {"through": "S1", "parallelTo": "v"}},
        "N2": {"point": {"meet": ["projection", "h"]}},
        "c3": {"circle": {"centre": "N1", "radiusFrom": ["O", "N2"]}},
        "N3": {"point": {"meet": ["c3", "h"], "pick": {"farthest": "O"}}},
        "c4": {"circle": {"centre": "N3", "radiusFrom": ["O", "N2"]}},
        "N4": {"point": {"meet": ["c4", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 9,
      "text": "Draw a vertical line through N4. Turn it round O by 60°, five times. The six lines frame the tile, with corners T1 to T6.",
      "create": {
        "frame": {"line": {"through": "N4", "parallelTo": "v"}},
        "frames": {"repeat": {"of": ["frame"], "by": "rot6"}},
        "T1": {"point": {"meet": ["frame", "frame@1"]}},
        "T2": {"point": {"meet": ["frame@1", "frame@2"]}},
        "T3": {"point": {"meet": ["frame@2", "frame@3"]}},
        "T4": {"point": {"meet": ["frame@3", "frame@4"]}},
        "T5": {"point": {"meet": ["frame@4", "frame@5"]}},
        "T6": {"point": {"meet": ["frame@5", "frame"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "Draw a line through N4 parallel to line OB. Turn it round O by 60°, five times.",
      "create": {
        "gl0": {"line": {"through": "N4", "parallelTo": "r30"}},
        "copies0": {"repeat": {"of": ["gl0"], "by": "rot6"}}
      },
      "animate": "ruler"
    },
    {
      "id": 11,
      "text": "The new line crosses the line at 105° from OA at Q1, below O. Draw a horizontal line through Q1. Turn it round O by 60°, five times.",
      "create": {
        "Q1": {"point": {"meet": ["r105", "gl0"]}},
        "gl1": {"line": {"through": "Q1", "parallelTo": "h"}},
        "copies1": {"repeat": {"of": ["gl1"], "by": "rot6"}}
      },
      "animate": "ruler"
    },
    {
      "id": 12,
      "text": "The horizontal line through Q1 crosses the line from S10 to S1 at Q2. Draw a line through Q2 parallel to line OB. Turn it round O by 60°, five times.",
      "create": {
        "Q2": {"point": {"meet": ["st9", "gl1"]}},
        "gl2": {"line": {"through": "Q2", "parallelTo": "r30"}},
        "copies2": {"repeat": {"of": ["gl2"], "by": "rot6"}}
      },
      "animate": "ruler"
    },
    {
      "id": 13,
      "text": "The new line crosses line OE at Q3, below O. Draw a vertical line through Q3. Turn it round O by 60°, five times.",
      "create": {
        "Q3": {"point": {"meet": ["r120", "gl2"]}},
        "gl3": {"line": {"through": "Q3", "parallelTo": "v"}},
        "copies3": {"repeat": {"of": ["gl3"], "by": "rot6"}}
      },
      "animate": "ruler"
    },
    {
      "id": 14,
      "text": "The line through Q2 at 30° from OA crosses the right tile side at Q4. Draw a line through Q4 parallel to line FM. Turn it round O by 60°, five times.",
      "create": {
        "Q4": {"point": {"meet": ["frame", "gl2"]}},
        "gl4": {"line": {"through": "Q4", "parallelTo": "r150"}},
        "copies4": {"repeat": {"of": ["gl4"], "by": "rot6"}}
      },
      "animate": "ruler"
    },
    {
      "id": 15,
      "text": "The vertical through Q3, turned by 300°, crosses the last line at Q5. Draw a vertical line through Q5. Turn it round O by 60°, five times.",
      "create": {
        "Q5": {"point": {"meet": ["gl3@5", "gl4"]}},
        "gl5": {"line": {"through": "Q5", "parallelTo": "v"}},
        "copies5": {"repeat": {"of": ["gl5"], "by": "rot6"}}
      },
      "animate": "ruler"
    },
    {
      "id": 16,
      "text": "Draw a horizontal line through S1. It crosses the vertical line through O at N5. Draw circles with centres O and N5 through each other. Draw a straight line through their crossings, P2 and P3. It crosses the vertical line at N6.",
      "create": {
        "sineProjection": {"line": {"through": "S1", "parallelTo": "h"}},
        "N5": {"point": {"meet": ["sineProjection", "v"]}},
        "sine": {"circle": {"centre": "O", "through": "N5"}},
        "halfSine": {"circle": {"centre": "N5", "through": "O"}},
        "P2": {"point": {"meet": ["sine", "halfSine"], "pick": {"angle": 30.0}}},
        "P3": {"point": {"meet": ["sine", "halfSine"], "pick": {"angle": 150.0}}},
        "midpoint": {"line": {"through": ["P2", "P3"]}},
        "N6": {"point": {"meet": ["midpoint", "v"]}}
      },
      "animate": "compass"
    },
    {
      "id": 17,
      "text": "Draw a circle with centre N5 through N6. It crosses the vertical line again at N7, above N5. Draw a circle with centre O through N7. It crosses the horizontal line at N8, right of O.",
      "create": {
        "threeHalves": {"circle": {"centre": "N5", "through": "N6"}},
        "N7": {"point": {"meet": ["threeHalves", "v"], "pick": {"farthest": "O"}}},
        "cx": {"circle": {"centre": "O", "through": "N7"}},
        "N8": {"point": {"meet": ["cx", "h"], "pick": {"angle": 0.0}}}
      },
      "animate": "compass"
    },
    {
      "id": 18,
      "text": "Draw a vertical line through N8. Turn it round O by 60°, five times.",
      "create": {
        "xv": {"line": {"through": "N8", "parallelTo": "v"}},
        "xs": {"repeat": {"of": ["xv"], "by": "rot6"}}
      },
      "animate": "ruler"
    },
    {
      "id": 19,
      "text": "Draw a circle with centre N4 and opening from O to N8. It crosses the horizontal line at N9, towards O. Draw a vertical line through N9. Turn it round O by 60°, five times.",
      "create": {
        "cy": {"circle": {"centre": "N4", "radiusFrom": ["O", "N8"]}},
        "N9": {"point": {"meet": ["cy", "h"], "pick": {"nearest": "O"}}},
        "yv": {"line": {"through": "N9", "parallelTo": "v"}},
        "ys": {"repeat": {"of": ["yv"], "by": "rot6"}}
      },
      "animate": "compass"
    },
    {
      "id": 20,
      "text": "Join T1, T2, T3, T4, T5 and T6 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["T1", "T2", "T3", "T4", "T5", "T6"]}},
      "animate": "fade"
    }
