      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass",
      "textWithoutHelpers": "Draw a circle with centre O through A."
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at S5. Draw the line through O that halves the angle between the horizontal and the vertical line. It crosses the circle at S3. Draw a line through O at 90° to it. Draw the line through O that halves the angle between the horizontal line and the line through S3. It crosses the circle at S2. Turn this line round O by 45°, three times. The lines through O cross the circle at S1 to S16, with S1 at A.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "S5": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "d45": {"line": {"through": "O", "bisects": ["A", "O", "S5"]}},
        "S3": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "r2": {"line": {"through": "O", "bisects": ["A", "O", "S3"]}},
        "S2": {"point": {"meet": ["c", "r2"], "pick": {"angle": 22.5}}},
        "r2r": {"repeat": {"of": ["r2"], "by": "rot8", "distinct": true}},
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}},
        "S1": {"point": {"meet": ["c", "h"], "pick": {"angle": 0.0}}},
        "S4": {"point": {"meet": ["c", "r2@1"], "pick": {"angle": 67.5}}},
