  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s P065 drawing of Bourgoin’s plate 65: sixteen-pointed stars on a square grid, with octagons between them. Every edge runs at a multiple of 22.5°, and every line is one of three sets of lines about the star: the sixteen lines joining points of the circle 90° apart, sixteen lines parallel to them nearer O, and eight more. Each runs through a crossing of earlier lines. The drawing gives no steps; we devised the construction.",
    "changes": "The compass steps, their order and the named points are ours. Colours follow Wichmann’s drawing. No photograph was checked.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data168/P065: Bourgoin, plate 65",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data168/P065.html",
      "note": "Read from his finished drawing, not construction instructions. His reference is Jules Bourgoin, Arabic Geometrical Pattern and Design (Dover, 1973), plate 65."
    }
  ],
  "steps": [
