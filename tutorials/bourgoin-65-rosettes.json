      "highlight": ["c", "h"],
      "animate": "ruler",
      "textWithoutHelpers": "Draw a vertical line through O. It crosses the circle at S5. Draw the 45° line through O. It crosses the circle at S3. Draw a line through O at 90° to it. Mark the points S1 to S16 that divide the circle into sixteen equal parts, with S1 at A."
    },
    {
      "id": 3,
      "text": "Draw a straight line through S1 and S5. Turn it round O by 22.5°, fifteen times. These sixteen lines make the large star at O.",
      "create": {"t": {"line": {"through": ["S1", "S5"]}}, "tr": {"repeat": {"of": ["t"], "by": "rot16"}}},
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw a vertical line through A. Turn it round O by 90°, three times. The four lines make a square with corners K1, K2, K3 and K4.",
      "create": {
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gr": {"repeat": {"of": ["gx"], "by": "rot4"}},
        "K1": {"point": {"meet": ["gx", "gx@1"]}},
        "K2": {"point": {"meet": ["gx@1", "gx@2"]}},
        "K3": {"point": {"meet": ["gx@2", "gx@3"]}},
        "K4": {"point": {"meet": ["gx@3", "gx"]}}
      },
      "animate": "ruler",
      "textWithoutHelpers": "Draw a vertical line through A. Turn it round O by 90°, twice. These are three sides of a square with corners K1, K2, K3 and K4. Its fourth side is not drawn."
    },
    {
      "id": 5,
      "text": "The line through S2 and S6 crosses the line through S4 and S8 at X, above O. Open the compass from X to S5. Draw a circle with this opening and centre O. It crosses the vertical line through O at Y, above O. Draw a horizontal line through Y. Turn it round O by 22.5°, fifteen times.",
      "create": {
        "X": {"point": {"meet": ["t@1", "t@3"]}},
        "kx": {"circle": {"centre": "O", "radiusFrom": ["X", "S5"]}},
        "Y": {"point": {"meet": ["kx", "v"], "pick": {"angle": 90.0}}},
        "a": {"line": {"through": "Y", "perpendicularTo": "v"}},
        "ar": {"repeat": {"of": ["a"], "by": "rot16"}}
      },
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "The line through S14 and S2 crosses the vertical line through A at P1. Draw a line through P1 parallel to the 112.5° line through O. Turn it round O by 45°, seven times.",
      "create": {
        "P1": {"point": {"meet": ["t@13", "gx"]}},
        "m1": {"line": {"through": "P1", "parallelTo": "r2@2"}},
        "mr1": {"repeat": {"of": ["m1"], "by": "rot8"}}
      },
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
