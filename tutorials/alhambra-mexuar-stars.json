{
  "format": 0,
  "id": "alhambra-mexuar-stars",
  "title": "Mexuar stars",
  "fold": 4,
  "star": 8,
  "style": "Nasrid",
  "level": "intermediate",
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "This uses Manuel Martínez Vela’s published grid method and drawing 3 on the eight-pointed-star grid in ALZADA 115, page 45. We read the outlines and supplied the compass construction and step grouping.",
    "changes": "The article explains the shared grid and shows the completed tracing. It does not give this pattern’s numbered app sequence. Its separate nine-step Partal example is a different pattern. Source credits identify the design and method, not a verbatim sequence.",
    "reviewed": "2026-10-21"
  },
  "credits": [
    {
      "source": "La Alhambra con regla y compás: el trazado de los diseños geométricos nazaríes (ALZADA 115, 2017)",
      "creator": "Manuel Martínez Vela",
      "url": "https://www.riarte.es/handle/20.500.12251/633",
      "note": "The grid of eight-pointed stars and the tracing of this panel (the article's drawing 3) follow this article.",
      "steps": [
        1,
        2,
        3,
        4,
        5
      ],
      "kind": "drawing"
    }
  ],
  "given": {
    "O": "The centre of one eight-pointed star.",
    "A": "Any point to the right of O. The distance OA is one square of the grid."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size while you build the grid. The distance OA is one square of the grid.",
      "create": {
        "h": { "line": { "through": ["O", "A"] } },
        "c": { "circle": { "centre": "O", "through": "A" } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the first circle at E and G. The horizontal line crosses it at A and C. Draw circles with centres A and C, through O. They cross the horizontal line again at B and D. Draw circles with centres E and G, through O. They cross the vertical line again at F and H.",
      "create": {
        "C": { "point": { "meet": ["c", "h"], "pick": { "angle": 180 } } },
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "E": { "point": { "meet": ["c", "v"], "pick": { "angle": 90 } } },
        "G": { "point": { "meet": ["c", "v"], "pick": { "angle": 270 } } },
        "cx1": { "circle": { "centre": "A", "radiusOf": "c" } },
        "B": { "point": { "meet": ["cx1", "h"], "pick": { "farthest": "O" } } },
        "cy1": { "circle": { "centre": "E", "radiusOf": "c" } },
        "F": { "point": { "meet": ["cy1", "v"], "pick": { "farthest": "O" } } },
        "cxm1": { "circle": { "centre": "C", "radiusOf": "c" } },
        "D": { "point": { "meet": ["cxm1", "h"], "pick": { "farthest": "O" } } },
        "cym1": { "circle": { "centre": "G", "radiusOf": "c" } },
        "H": { "point": { "meet": ["cym1", "v"], "pick": { "farthest": "O" } } }
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a vertical line through each of D, C, A and B. Draw a horizontal line through each of H, G, E and F. The lines make a square grid.",
      "create": {
        "Vm2": { "line": { "through": "D", "perpendicularTo": "h" } },
        "Hm2": { "line": { "through": "H", "perpendicularTo": "v" } },
        "Vm1": { "line": { "through": "C", "perpendicularTo": "h" } },
        "Hm1": { "line": { "through": "G", "perpendicularTo": "v" } },
        "V1": { "line": { "through": "A", "perpendicularTo": "h" } },
        "H1": { "line": { "through": "E", "perpendicularTo": "v" } },
        "V2": { "line": { "through": "B", "perpendicularTo": "h" } },
        "H2": { "line": { "through": "F", "perpendicularTo": "v" } }
      },
      "highlight": ["h", "v"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw a circle with centre O through Q16, the top right corner of the grid square. Draw circles with centres D and B, the same size. They cross the horizontal line at U, Q11, Q12 and V. Draw the lines through O that halve the angles AOE and EOC. Draw two lines through each of U, Q11, Q12 and V, parallel to these two lines.",
      "create": {
        "Q16": { "point": { "meet": ["V1", "H1"] } },
        "s": { "circle": { "centre": "O", "through": "Q16" } },
        "d1": { "line": { "through": "O", "bisects": ["A", "O", "E"] } },
        "d2": { "line": { "through": "O", "bisects": ["E", "O", "C"] } },
        "sm2": { "circle": { "centre": "D", "radiusOf": "s" } },
        "U": { "point": { "meet": ["sm2", "h"], "pick": { "farthest": "O" } } },
        "Q11": { "point": { "meet": ["sm2", "h"], "pick": { "nearest": "O" } } },
        "s2": { "circle": { "centre": "B", "radiusOf": "s" } },
        "Q12": { "point": { "meet": ["s2", "h"], "pick": { "nearest": "O" } } },
        "V": { "point": { "meet": ["s2", "h"], "pick": { "farthest": "O" } } },
        "Pm2n": { "line": { "through": "U", "parallelTo": "d2" } },
        "Mm2n": { "line": { "through": "U", "parallelTo": "d1" } },
        "Pm2p": { "line": { "through": "Q11", "parallelTo": "d2" } },
        "Mm2p": { "line": { "through": "Q11", "parallelTo": "d1" } },
        "P2n": { "line": { "through": "Q12", "parallelTo": "d2" } },
        "M2n": { "line": { "through": "Q12", "parallelTo": "d1" } },
        "P2p": { "line": { "through": "V", "parallelTo": "d2" } },
        "M2p": { "line": { "through": "V", "parallelTo": "d1" } }
      },
      "highlight": ["Q16"],
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Join Q1, Q2, Q3 and Q4 to mark the tile that repeats. Its sides run along the grid, two squares from O. The points where the design turns come by themselves.",
      "create": {
        "Q1": { "point": { "meet": ["V2", "H2"] } },
        "Q2": { "point": { "meet": ["Vm2", "H2"] } },
        "Q3": { "point": { "meet": ["Vm2", "Hm2"] } },
        "Q4": { "point": { "meet": ["Hm2", "V2"] } },
        "Q5": { "point": { "meet": ["Hm2", "Pm2n"] } },
        "Q6": { "point": { "meet": ["Hm2", "Pm2p"] } },
        "Q7": { "point": { "meet": ["Vm1", "Hm1"] } },
        "Q8": { "point": { "meet": ["Hm1", "M2n"] } },
        "Q9": { "point": { "meet": ["Hm1", "V1"] } },
        "Q10": { "point": { "meet": ["Hm1", "P2n"] } },
        "Q13": { "point": { "meet": ["H1", "Pm2p"] } },
        "Q14": { "point": { "meet": ["Vm1", "H1"] } },
        "Q15": { "point": { "meet": ["H1", "Mm2p"] } },
        "Q17": { "point": { "meet": ["Vm2", "Mm2n"] } },
        "Q18": { "point": { "meet": ["H2", "Mm2n"] } },
        "Q19": { "point": { "meet": ["V1", "Mm2p"] } },
        "Q20": { "point": { "meet": ["H2", "Mm2p"] } },
        "Q21": { "point": { "meet": ["Vm1", "M2n"] } },
        "Q22": { "point": { "meet": ["V2", "P2n"] } },
        "Q23": { "point": { "meet": ["Vm2", "Pm2n"] } },
        "Q24": { "point": { "meet": ["Vm1", "Pm2p"] } },
        "Q25": { "point": { "meet": ["v", "Pm2p"] } },
        "Q26": { "point": { "meet": ["v", "Mm2p"] } },
        "Q27": { "point": { "meet": ["V1", "P2n"] } },
        "Q28": { "point": { "meet": ["V2", "M2n"] } },
        "tile": { "polygon": ["Q1", "Q2", "Q3", "Q4"] }
      },
      "animate": "fade"
    }
  ],
  "ink": {
