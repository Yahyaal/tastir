        "H6_11": {"point": {"meet": ["s6", "o11"]}},
        "X6_9": {"point": {"meet": ["s6", "s9"]}},
        "H6_6": {"point": {"meet": ["s6", "o6"]}},
        "H7_0": {"point": {"meet": ["s7", "o0"]}},
        "X7_10": {"point": {"meet": ["s7", "s10"]}},
        "H7_7": {"point": {"meet": ["s7", "o7"]}},
        "H8_1": {"point": {"meet": ["s8", "o1"]}},
        "X8_11": {"point": {"meet": ["s8", "s11"]}},
