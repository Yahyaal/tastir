        "H9_2": {"point": {"meet": ["s9", "o2"]}},
        "H9_9": {"point": {"meet": ["s9", "o9"]}},
        "H10_3": {"point": {"meet": ["s10", "o3"]}},
        "H10_10": {"point": {"meet": ["s10", "o10"]}},
        "H11_4": {"point": {"meet": ["s11", "o4"]}},
        "H11_11": {"point": {"meet": ["s11", "o11"]}},
        "E0b": {"point": {"meet": ["o0", "gN"]}},
        "E1a": {"point": {"meet": ["o1", "gE"]}},
        "E1b": {"point": {"meet": ["o1", "gN"]}},
        "E2a": {"point": {"meet": ["o2", "gE"]}},
        "E3b": {"point": {"meet": ["o3", "gW"]}},
        "E4a": {"point": {"meet": ["o4", "gN"]}},
        "E4b": {"point": {"meet": ["o4", "gW"]}},
        "E5a": {"point": {"meet": ["o5", "gN"]}},
        "E6b": {"point": {"meet": ["o6", "gS"]}},
        "E7a": {"point": {"meet": ["o7", "gW"]}},
        "E7b": {"point": {"meet": ["o7", "gS"]}},
        "E8a": {"point": {"meet": ["o8", "gW"]}},
        "E9b": {"point": {"meet": ["o9", "gE"]}},
        "E10a": {"point": {"meet": ["o10", "gS"]}},
        "E10b": {"point": {"meet": ["o10", "gE"]}},
        "E11a": {"point": {"meet": ["o11", "gS"]}}
      },
      "animate": "fade"
    }
  ],
  "ink": {
    "text": "Ink each star line from the outline inwards, stopping where it meets the line at right angles to it. Ink the outline lines from where a star line meets them, out through the outline’s corner to the edge of the tile, but not between the two star lines on each side.",
    "paths": [
