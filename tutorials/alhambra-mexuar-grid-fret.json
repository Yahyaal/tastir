{
  "format": 0,
  "id": "alhambra-mexuar-grid-fret",
  "title": "Grid fret of the Sala del Mexuar patio (Alhambra)",
  "short": "Mexuar grid fret",
  "subtitle": "Sala del Mexuar patio, Alhambra",
  "given": {
    "O": "A centre of quarter turning in the fret.",
    "A": "Halfway to the next such centre along the cell."
  },
  "fold": 4,
  "style": "Nasrid",
  "level": "advanced",
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s data192/ALH1 drawing. After taking the 8 pt band centre lines and turning the frame by 45 degrees, the corners lie on a rational grid in tenths of OA. Line K4F gives a fifth, and line E1E2 halves it to a tenth; compass transfers make the odd tenths. The drawing gives no steps; we devised the construction.",
    "changes": "The compass steps, their order and the named points are ours. The tutorial draws band centre lines. The square cell follows the primitive diagonal lattice; the change of frame preserves the drawing’s handedness. Wichmann notes two reversed hexagons in the real panel’s upper left; this tutorial follows his regular repeat. The palette is illustrative; no photograph was checked.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data192/ALH1: Sala del Mexuar patio, Alhambra",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data192/ALH1.html",
      "note": "Read from his finished drawing, not construction instructions. His source is Tony Lee, personal communication, for the carved stucco panel above the southern entrance of the small open patio south of the Sala del Mexuar. This data192/ALH1 entry is distinct from data190/ALH1."
    }
  ],
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The circle crosses the two lines at A, B, C and D. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and D. The four corners are K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "B", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "D", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K1"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw a straight line through A and C. It crosses the line from O to K1 at M. Draw a horizontal line through M. It crosses the vertical line through O at F.",
      "create": {
        "ac": {"line": {"through": ["A", "C"]}},
        "M": {"point": {"meet": ["ac", "d45"]}},
        "mh": {"line": {"through": "M", "parallelTo": "h"}},
        "F": {"point": {"meet": ["mh", "v"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw a straight line through K4 and F. It crosses the line from O to K1 at E. Draw a vertical line through E. It crosses the horizontal line at E1. Draw a horizontal line through E. It crosses the vertical line through O at E2. Draw a straight line through E1 and E2. It crosses the line from O to K1 at G.",
      "create": {
        "kf": {"line": {"through": ["K4", "F"]}},
        "E": {"point": {"meet": ["kf", "d45"]}},
        "ev": {"line": {"through": "E", "parallelTo": "v"}},
        "eh": {"line": {"through": "E", "parallelTo": "h"}},
        "E1": {"point": {"meet": ["ev", "h"]}},
        "E2": {"point": {"meet": ["eh", "v"]}},
        "ee": {"line": {"through": ["E1", "E2"]}},
        "G": {"point": {"meet": ["ee", "d45"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw a vertical line through G. It crosses the horizontal line at H.",
      "create": {"gv": {"line": {"through": "G", "parallelTo": "v"}}, "H": {"point": {"meet": ["gv", "h"]}}},
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Keep the compass open to the distance from O to E1. Draw circles with centres H, P1, P2 and P3 in turn. Each circle crosses the horizontal line to the right at P1, P2, P3 and P4.",
      "create": {
        "cp1": {"circle": {"centre": "H", "radiusFrom": ["O", "E1"]}},
        "P1": {"point": {"meet": ["cp1", "h"], "pick": {"angle": 0.0}}},
        "cp2": {"circle": {"centre": "P1", "radiusFrom": ["O", "E1"]}},
        "P2": {"point": {"meet": ["cp2", "h"], "pick": {"farthest": "O"}}},
        "cp3": {"circle": {"centre": "P2", "radiusFrom": ["O", "E1"]}},
        "P3": {"point": {"meet": ["cp3", "h"], "pick": {"farthest": "O"}}},
        "cp4": {"circle": {"centre": "P3", "radiusFrom": ["O", "E1"]}},
        "P4": {"point": {"meet": ["cp4", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Draw a vertical line through each of P1, P2, P3 and P4. Turn these four lines and the vertical line through G round O by 90°, three times.",
      "create": {
        "p1v": {"line": {"through": "P1", "parallelTo": "v"}},
        "p2v": {"line": {"through": "P2", "parallelTo": "v"}},
        "p3v": {"line": {"through": "P3", "parallelTo": "v"}},
        "p4v": {"line": {"through": "P4", "parallelTo": "v"}},
        "vpcopies": {"repeat": {"of": ["gv", "p1v", "p2v", "p3v", "p4v"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Draw a circle with centre A and radius OH. It crosses the horizontal line at Q, beyond A.",
      "create": {
        "ca": {"circle": {"centre": "A", "radiusFrom": ["O", "H"]}},
        "Q": {"point": {"meet": ["ca", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 9,
      "text": "Draw a line through each of H, P1, P2, P3, P4 and Q parallel to line AC. Turn all six lines round O by 90°, three times.",
      "create": {
        "dd0": {"line": {"through": "H", "parallelTo": "ac"}},
        "dd1": {"line": {"through": "P1", "parallelTo": "ac"}},
        "dd2": {"line": {"through": "P2", "parallelTo": "ac"}},
        "dd3": {"line": {"through": "P3", "parallelTo": "ac"}},
        "dd4": {"line": {"through": "P4", "parallelTo": "ac"}},
        "dd5": {"line": {"through": "Q", "parallelTo": "ac"}},
        "dcopies": {"repeat": {"of": ["dd0", "dd1", "dd2", "dd3", "dd4", "dd5"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
