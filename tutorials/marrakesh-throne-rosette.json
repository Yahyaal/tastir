  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s C126B drawing. Its tile corners were snapped to the square-root-of-two grid in small-star-radius units. The unit-star opening and square-diagonal compass transfers are shared with the Rabat throne-room octagons; different crossings complete the rosette, the crosses and the octagons. The drawing gives no steps; we devised the construction.",
    "changes": "The compass steps, their order and the named points are ours. The tile edges follow the plain drawing; its white strokes over the joints are not bands. The colours follow Wichmann’s drawing, mapped to the Alhambra palette: the teal and blue octagons turn in a pinwheel, though the lines themselves are mirror-symmetric. No photograph was checked.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data152/C126B: Royal Palace throne room, Marrakesh",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data152/C126B.html",
      "note": "Read from his finished drawing, not construction instructions. His references are Jean-Marc Castéra, Arabesques: Decorative Art in Morocco (1999), page 126, figure 3, Royal Palace throne room, Marrakesh; Wichmann and Wade, Islamic Design: a Mathematical Approach (2017), figure 9.8b; and André Paccard, Traditional Islamic Craft in Moroccan Architecture (1980), volume 2, page 76, Royal Palace, Ifrane."
    }
  ],
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at C and D. The horizontal line crosses the circle at B on the left. Draw a vertical line through A. Draw a horizontal line through C. They cross at E. Draw a straight line through O and E. Draw a line through O at 90° to line OE. The circle crosses the four lines through O at S1 to S8.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "ax": {"line": {"through": "A", "perpendicularTo": "h"}},
        "cy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "E": {"point": {"meet": ["ax", "cy"]}},
        "d45": {"line": {"through": ["O", "E"]}},
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}},
        "S1": {"point": {"meet": ["c", "h"], "pick": {"angle": 0.0}}},
        "S2": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "S3": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "S4": {"point": {"meet": ["c", "d135"], "pick": {"angle": 135.0}}},
        "S5": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "S6": {"point": {"meet": ["c", "d45"], "pick": {"angle": 225.0}}},
        "S7": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "S8": {"point": {"meet": ["c", "d135"], "pick": {"angle": 315.0}}}
      },
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw the star at O as two squares.",
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S3, S3 and S5, S5 and S7, and S7 and S1. Draw each line long, beyond the circle.",
          "create": {
            "q01": {"line": {"through": ["S1", "S3"]}},
            "q02": {"line": {"through": ["S3", "S5"]}},
            "q03": {"line": {"through": ["S5", "S7"]}},
            "q04": {"line": {"through": ["S7", "S1"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S4, S4 and S6, S6 and S8, and S8 and S2. Draw each line long, beyond the circle.",
          "create": {
            "q11": {"line": {"through": ["S2", "S4"]}},
            "q12": {"line": {"through": ["S4", "S6"]}},
            "q13": {"line": {"through": ["S6", "S8"]}},
            "q14": {"line": {"through": ["S8", "S2"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 4,
      "text": "Keep the compass open to OA. Draw circles with centres A, F1 and F2 in turn. Each circle crosses the horizontal line to the right at F1, F2 and F.",
      "create": {
        "cf0": {"circle": {"centre": "A", "radiusOf": "c"}},
        "F1": {"point": {"meet": ["cf0", "h"], "pick": {"farthest": "O"}}},
        "cf1": {"circle": {"centre": "F1", "radiusOf": "c"}},
        "F2": {"point": {"meet": ["cf1", "h"], "pick": {"farthest": "O"}}},
        "cf2": {"circle": {"centre": "F2", "radiusOf": "c"}},
        "F": {"point": {"meet": ["cf2", "h"], "pick": {"farthest": "O"}}}
