      "animate": "ruler"
    },
    {
      "id": 16,
      "text": "The vertical line through Q crosses the diagonal through R, turned by 270°, at Z. Draw a line through Z parallel to the line from S1 to S3. Turn it round O by 90°, three times.",
      "create": {
        "Z": {"point": {"meet": ["qv", "rd@3"]}},
