    },
    {
      "id": 15,
      "text": "The vertical line through T1 crosses the diagonal through W, turned by 270°, at Y2. Draw a line through Y2 parallel to the line from S1 to S3. Turn it round O by 90°, three times.",
      "create": {
        "Y2": {"point": {"meet": ["gx", "wd@3"]}},
        "y2d": {"line": {"through": "Y2", "parallelTo": "q01"}},
        "y2copies": {"repeat": {"of": ["y2d"], "by": "rot4"}}
