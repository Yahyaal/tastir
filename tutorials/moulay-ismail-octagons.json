      "animate": "ruler"
    },
    {
      "id": 14,
      "text": "The vertical line through W crosses the line from S7 to S1 at Y1. Draw a line through Y1 parallel to the line from S1 to S3. Turn it round O by 90°, three times.",
      "create": {
        "Y1": {"point": {"meet": ["wv", "q04"]}},
        "y1d": {"line": {"through": "Y1", "parallelTo": "q01"}},
        "y1copies": {"repeat": {"of": ["y1d"], "by": "rot4"}}
