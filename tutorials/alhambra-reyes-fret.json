  "given": {"O": "The centre of a cross.", "A": "Halfway from O to the next cross."},
  "steps": [
    {
      "id": 1,
      "text": "Rule a horizontal line through O and A and draw a circle about O through A. A cross will sit at O and at every point of the grid two radii away.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Rule the vertical through O. At the four points where the circle meets the two lines, rule lines at right angles to them: the square cell. Rule its diagonal through O and the corner K.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "P90": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "P180": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "P270": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "P180", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "P90", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "P270", "perpendicularTo": "v"}},
        "K": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Divide OA into thirds. Rule the line from the bottom corner K4 to the top of the circle: it crosses the diagonal at T, a third of the way to K. Rule a vertical and a horizontal through T; they meet the horizontal and vertical through O at D and D′, a third of OA from O.",
      "create": {
        "kp": {"line": {"through": ["K4", "P90"]}},
        "T": {"point": {"meet": ["kp", "d45"]}},
        "tv": {"line": {"through": "T", "parallelTo": "v"}},
        "th": {"line": {"through": "T", "parallelTo": "h"}},
        "D": {"point": {"meet": ["tv", "h"]}},
        "D2": {"point": {"meet": ["th", "v"]}}
      },
      "highlight": ["K4", "P90"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Join D and D′: the line crosses the diagonal at S, a sixth of the way to K. Join A to the top of the circle: it crosses the diagonal halfway, at H. Draw the circle about H through S; it crosses the diagonal again at S′, five sixths of the way.",
      "create": {
        "dd": {"line": {"through": ["D", "D2"]}},
        "S": {"point": {"meet": ["dd", "d45"]}},
        "ap": {"line": {"through": ["A", "P90"]}},
        "H": {"point": {"meet": ["ap", "d45"]}},
        "ch": {"circle": {"centre": "H", "through": "S"}},
        "S5": {"point": {"meet": ["ch", "d45"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Through S, H and S′ rule horizontals: the lines of the bands at a sixth, a half and five sixths of OA above O.",
      "create": {
        "y1": {"line": {"through": "S", "parallelTo": "h"}},
        "y3": {"line": {"through": "H", "parallelTo": "h"}},
        "y5": {"line": {"through": "S5", "parallelTo": "h"}}
      },
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw the circle about O through S. Where it crosses the horizontal, at E1, is the inner corner of a small diamond centred at D. Draw the circle about D through E1: it marks the diamond’s outer corner E2.",
      "create": {
        "cs": {"circle": {"centre": "O", "through": "S"}},
        "E1": {"point": {"meet": ["cs", "h"], "pick": {"angle": 0.0}}},
        "cd": {"circle": {"centre": "D", "through": "E1"}},
        "E2": {"point": {"meet": ["cd", "h"], "pick": {"farthest": "O"}}}
      },
      "highlight": ["O", "S"],
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "The same diamond sits round A and two thirds beyond it. Open the compass to DE1 and mark it either side of A; then put the compass on A and carry E1 and E2 across to the far side.",
      "create": {
        "ca": {"circle": {"centre": "A", "radiusFrom": ["D", "E1"]}},
        "F1": {"point": {"meet": ["ca", "h"], "pick": {"nearest": "O"}}},
        "F2": {"point": {"meet": ["ca", "h"], "pick": {"farthest": "O"}}},
        "ca2": {"circle": {"centre": "A", "through": "E2"}},
        "G1": {"point": {"meet": ["ca2", "h"], "pick": {"farthest": "O"}}},
        "ca3": {"circle": {"centre": "A", "through": "E1"}},
        "G2": {"point": {"meet": ["ca3", "h"], "pick": {"farthest": "O"}}}
      },
      "highlight": ["A"],
      "animate": "compass"
    },
    {
      "id": 8,
      "text": "Through each of the six marks rule the two lines at 45° to the horizontal: the sides of the diamonds, carried on as the slanting edges of the frets.",
      "create": {
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}},
        "E1a": {"line": {"through": "E1", "parallelTo": "d45"}},
        "E1b": {"line": {"through": "E1", "parallelTo": "d135"}},
        "E2a": {"line": {"through": "E2", "parallelTo": "d45"}},
        "E2b": {"line": {"through": "E2", "parallelTo": "d135"}},
        "F1a": {"line": {"through": "F1", "parallelTo": "d45"}},
        "F1b": {"line": {"through": "F1", "parallelTo": "d135"}},
        "F2a": {"line": {"through": "F2", "parallelTo": "d45"}},
        "F2b": {"line": {"through": "F2", "parallelTo": "d135"}},
        "G1a": {"line": {"through": "G1", "parallelTo": "d45"}},
        "G1b": {"line": {"through": "G1", "parallelTo": "d135"}},
        "G2a": {"line": {"through": "G2", "parallelTo": "d45"}},
        "G2b": {"line": {"through": "G2", "parallelTo": "d135"}}
      },
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "Turn all these lines about O by quarter turns, so the cell has them in every direction.",
      "create": {
        "cp": {
          "repeat": {
            "of": [
              "y1",
              "y3",
              "y5",
              "E1a",
              "E1b",
              "E2a",
              "E2b",
              "F1a",
              "F1b",
              "F2a",
              "F2b",
              "G1a",
              "G1b",
              "G2a",
              "G2b"
            ],
            "by": "rot4"
          }
        }
      },
      "animate": "ruler"
    },
