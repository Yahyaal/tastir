  "given": {
    "O": "The centre of a cross.",
    "A": "Halfway from O to the next cross."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {
        "c": { "circle": { "centre": "O", "through": "A" } },
        "h": { "line": { "through": ["O", "A"] } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and N. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and N. These lines make the square cell, with corners K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "C": { "point": { "meet": ["c", "v"], "pick": { "angle": 90.0 } } },
        "B": { "point": { "meet": ["c", "h"], "pick": { "angle": 180.0 } } },
        "N": { "point": { "meet": ["c", "v"], "pick": { "angle": 270.0 } } },
        "gx": { "line": { "through": "A", "perpendicularTo": "h" } },
        "gxw": { "line": { "through": "B", "perpendicularTo": "h" } },
        "gy": { "line": { "through": "C", "perpendicularTo": "v" } },
        "gys": { "line": { "through": "N", "perpendicularTo": "v" } },
        "K1": { "point": { "meet": ["gx", "gy"] } },
        "K2": { "point": { "meet": ["gxw", "gy"] } },
        "K3": { "point": { "meet": ["gxw", "gys"] } },
        "K4": { "point": { "meet": ["gx", "gys"] } },
        "d45": { "line": { "through": ["O", "K1"] } }
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw a straight line through K4 and C. It crosses the line from O to K1 at T, a third of the way to K1. Draw a vertical line and a horizontal line through T. They cross the lines through O at D1 and D2.",
      "create": {
        "kp": { "line": { "through": ["K4", "C"] } },
        "T": { "point": { "meet": ["kp", "d45"] } },
        "tv": { "line": { "through": "T", "parallelTo": "v" } },
        "th": { "line": { "through": "T", "parallelTo": "h" } },
        "D1": { "point": { "meet": ["tv", "h"] } },
        "D2": { "point": { "meet": ["th", "v"] } }
      },
      "highlight": ["K4", "C"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw a straight line through D1 and D2. It crosses the line from O to K1 at S1. Draw a straight line through A and C. It crosses the line from O to K1 at H, halfway. Draw a circle with centre H through S1. It crosses the line from O to K1 again at S2.",
      "create": {
        "dd": { "line": { "through": ["D1", "D2"] } },
        "S1": { "point": { "meet": ["dd", "d45"] } },
        "ap": { "line": { "through": ["A", "C"] } },
        "H": { "point": { "meet": ["ap", "d45"] } },
        "ch": { "circle": { "centre": "H", "through": "S1" } },
        "S2": { "point": { "meet": ["ch", "d45"], "pick": { "farthest": "O" } } }
      },
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Draw a horizontal line through each of S1, H and S2. These are the lines of the bands.",
      "create": {
        "y1": { "line": { "through": "S1", "parallelTo": "h" } },
        "y3": { "line": { "through": "H", "parallelTo": "h" } },
        "y5": { "line": { "through": "S2", "parallelTo": "h" } }
      },
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw a circle with centre O through S1. It crosses the horizontal line at E1. Draw a circle with centre D1 through E1. It crosses the horizontal line again at E2. E1 and E2 are corners of a small diamond.",
      "create": {
        "cs": { "circle": { "centre": "O", "through": "S1" } },
        "E1": { "point": { "meet": ["cs", "h"], "pick": { "angle": 0.0 } } },
        "cd": { "circle": { "centre": "D1", "through": "E1" } },
        "E2": { "point": { "meet": ["cd", "h"], "pick": { "farthest": "O" } } }
      },
      "highlight": ["O", "S1"],
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Draw a circle with centre A whose radius is the distance from D1 to E1. It crosses the horizontal line at F1 and F2. Draw a circle with centre A through E2. It crosses the line beyond A at G1. Draw a circle with centre A through E1. It crosses the line beyond A at G2.",
      "create": {
        "ca": { "circle": { "centre": "A", "radiusFrom": ["D1", "E1"] } },
        "F1": { "point": { "meet": ["ca", "h"], "pick": { "nearest": "O" } } },
        "F2": { "point": { "meet": ["ca", "h"], "pick": { "farthest": "O" } } },
        "ca2": { "circle": { "centre": "A", "through": "E2" } },
        "G1": { "point": { "meet": ["ca2", "h"], "pick": { "farthest": "O" } } },
        "ca3": { "circle": { "centre": "A", "through": "E1" } },
        "G2": { "point": { "meet": ["ca3", "h"], "pick": { "farthest": "O" } } }
      },
      "highlight": ["A"],
      "animate": "compass"
    },
    {
      "id": 8,
      "text": "Draw a line through O at 90° to the line from O to K1. Draw two lines through each of E1, E2, F1, F2, G1 and G2, parallel to these two lines through O. They are the sides of the diamonds and the slanting edges of the frets.",
      "create": {
        "d135": { "line": { "through": "O", "perpendicularTo": "d45" } },
        "E1a": { "line": { "through": "E1", "parallelTo": "d45" } },
        "E1b": { "line": { "through": "E1", "parallelTo": "d135" } },
        "E2a": { "line": { "through": "E2", "parallelTo": "d45" } },
        "E2b": { "line": { "through": "E2", "parallelTo": "d135" } },
        "F1a": { "line": { "through": "F1", "parallelTo": "d45" } },
