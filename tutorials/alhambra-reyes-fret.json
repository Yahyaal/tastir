        "G1a": { "line": { "through": "G1", "parallelTo": "d45" } },
        "G1b": { "line": { "through": "G1", "parallelTo": "d135" } },
        "G2a": { "line": { "through": "G2", "parallelTo": "d45" } },
        "G2b": { "line": { "through": "G2", "parallelTo": "d135" } }
      },
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "Turn the lines of the last four steps round O by 90°, three times.",
