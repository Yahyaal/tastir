        "bs270": { "line": { "through": ["S7", "S1"] } },
        "bd315": { "line": { "through": ["S8", "S2"] } }
      },
      "highlight": ["cb"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw a circle with centre A through S1. It crosses the horizontal line again at N. Draw a line through N parallel to the line from S1 to S3. Draw a line through N parallel to the line from S7 to S1. These are two sides of the next star along.",
      "create": {
        "ca": { "circle": { "centre": "A", "through": "S1" } },
        "N": { "point": { "meet": ["ca", "h"], "pick": { "farthest": "O" } } },
        "n1": { "line": { "through": "N", "parallelTo": "bs0" } },
        "n2": { "line": { "through": "N", "parallelTo": "bs270" } }
