        "S1": { "point": { "meet": ["cb", "h"], "pick": { "angle": 0.0 } } },
        "S3": { "point": { "meet": ["cb", "v"], "pick": { "angle": 90.0 } } },
        "S5": { "point": { "meet": ["cb", "h"], "pick": { "angle": 180.0 } } },
