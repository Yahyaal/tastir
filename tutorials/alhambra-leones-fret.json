  "given": {"O": "The centre of a star.", "A": "Halfway from O to the next star."},
  "steps": [
    {
      "id": 1,
      "text": "Rule a horizontal line through O and A and draw a circle about O through A. A star will sit at O and at every point of the grid two radii away.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Rule the vertical through O. At the four points where the circle meets the two lines, rule lines at right angles to them: the square cell. Rule its two diagonals through O.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "P90": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "P180": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "P270": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "P180", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "P90", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "P270", "perpendicularTo": "v"}},
        "K": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K"]}},
        "d135": {"line": {"through": ["O", "K2"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Join the four points on the circle: a square standing on its corner. Its sides and the two diagonals are the lines the frets run along.",
      "create": {
        "f1": {"line": {"through": ["A", "P90"]}},
        "f2": {"line": {"through": ["P90", "P180"]}},
        "f3": {"line": {"through": ["P180", "P270"]}},
        "f4": {"line": {"through": ["P270", "A"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Rule the line from A to the corner K2; it crosses the vertical halfway up, at M. Mark where the 45° diagonal crosses the circle, and rule a line from there through M to the other diagonal: it lands on the star’s point. Draw the circle about O through it.",
      "create": {
        "ak": {"line": {"through": ["A", "K2"]}},
        "M": {"point": {"meet": ["ak", "v"]}},
        "D": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "dm": {"line": {"through": ["D", "M"]}},
        "B135": {"point": {"meet": ["dm", "d135"]}},
        "cb": {"circle": {"centre": "O", "through": "B135"}}
      },
      "highlight": ["A", "K2"],
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "The star is two squares in this circle. Mark where it meets the horizontal, the vertical and the diagonals, and join every other mark. Rule each side as a full line.",
      "create": {
        "B0": {"point": {"meet": ["cb", "h"], "pick": {"angle": 0.0}}},
        "B90": {"point": {"meet": ["cb", "v"], "pick": {"angle": 90.0}}},
        "B180": {"point": {"meet": ["cb", "h"], "pick": {"angle": 180.0}}},
        "B270": {"point": {"meet": ["cb", "v"], "pick": {"angle": 270.0}}},
        "B45": {"point": {"meet": ["cb", "d45"], "pick": {"angle": 45.0}}},
        "B225": {"point": {"meet": ["cb", "d45"], "pick": {"angle": 225.0}}},
        "B315": {"point": {"meet": ["cb", "d135"], "pick": {"angle": 315.0}}},
        "bs0": {"line": {"through": ["B0", "B90"]}},
        "bd45": {"line": {"through": ["B45", "B135"]}},
        "bs90": {"line": {"through": ["B90", "B180"]}},
        "bd135": {"line": {"through": ["B135", "B225"]}},
        "bs180": {"line": {"through": ["B180", "B270"]}},
        "bd225": {"line": {"through": ["B225", "B315"]}},
        "bs270": {"line": {"through": ["B270", "B0"]}},
        "bd315": {"line": {"through": ["B315", "B45"]}}
      },
      "highlight": ["cb"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "The next star along sits two units away, so its point lies as far beyond A as this star’s point lies before it. Put the compass on A, open it to B0 and mark the other side. Through that mark rule lines parallel to the star’s sides B0–B90 and B270–B0: the sides of the neighbouring star that reach into the cell.",
      "create": {
        "ca": {"circle": {"centre": "A", "through": "B0"}},
        "N0": {"point": {"meet": ["ca", "h"], "pick": {"farthest": "O"}}},
        "n1": {"line": {"through": "N0", "parallelTo": "bs0"}},
        "n2": {"line": {"through": "N0", "parallelTo": "bs270"}}
      },
      "highlight": ["A", "B0"],
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Copy the neighbouring star’s sides to the other three sides of the cell, turning them about O.",
      "create": {"cp": {"repeat": {"of": ["n1", "n2"], "by": "rot4"}}},
      "animate": "ruler"
    },
    {
      "id": 8,
      "hidden": true,
      "text": "Mark the corners of the pattern: every point where the outline of a piece turns.",
      "create": {
        "M2": {"point": {"meet": ["d45", "n1@2"]}},
        "M3": {"point": {"meet": ["gxw", "bs90"]}},
        "M4": {"point": {"meet": ["f3", "bd225"]}},
        "M5": {"point": {"meet": ["gxw", "bs180"]}},
        "M6": {"point": {"meet": ["f2", "bs180"]}},
        "M7": {"point": {"meet": ["d135", "n1@1"]}},
        "M8": {"point": {"meet": ["f2", "bd45"]}},
        "M9": {"point": {"meet": ["gy", "bs0"]}},
        "M10": {"point": {"meet": ["bd135", "bs180"]}},
        "M11": {"point": {"meet": ["bs90", "bd135"]}},
        "M12": {"point": {"meet": ["gys", "bs270"]}},
        "M13": {"point": {"meet": ["f3", "bs270"]}},
        "M14": {"point": {"meet": ["f3", "bd135"]}},
        "M15": {"point": {"meet": ["bs180", "bd225"]}},
        "M16": {"point": {"meet": ["f2", "bd135"]}},
        "M17": {"point": {"meet": ["bd45", "bs90"]}},
        "M18": {"point": {"meet": ["f4", "bd315"]}},
        "M19": {"point": {"meet": ["bd225", "bs270"]}},
        "M20": {"point": {"meet": ["bs0", "bd45"]}},
        "M21": {"point": {"meet": ["f1", "bs90"]}},
        "M22": {"point": {"meet": ["f1", "dm"]}},
        "M23": {"point": {"meet": ["gy", "bs90"]}},
        "M24": {"point": {"meet": ["bs270", "bd315"]}},
        "M25": {"point": {"meet": ["f4", "bd225"]}},
        "M26": {"point": {"meet": ["bs0", "bd315"]}},
        "M27": {"point": {"meet": ["f1", "bd45"]}},
        "M28": {"point": {"meet": ["gys", "bs180"]}},
        "M29": {"point": {"meet": ["d135", "n2"]}},
        "M30": {"point": {"meet": ["f4", "bs0"]}},
        "M31": {"point": {"meet": ["d45", "n1"]}},
        "M32": {"point": {"meet": ["gx", "bs270"]}},
        "M33": {"point": {"meet": ["gx", "bs0"]}}
      },
      "animate": "fade"
    },
    {
      "id": 9,
      "text": "The tile is the square cell.",
      "create": {"tile": {"polygon": ["K", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
