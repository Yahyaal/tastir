  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {
        "c": { "circle": { "centre": "O", "through": "A" } },
        "h": { "line": { "through": ["O", "A"] } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through A. Draw a vertical line through C. Draw a horizontal line through B. Draw a horizontal line through D. These lines make the square cell, with corners E, F, G and H. Draw a straight line through O and E. Draw a straight line through O and F.",
      "create": {
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "B": { "point": { "meet": ["c", "v"], "pick": { "angle": 90.0 } } },
        "C": { "point": { "meet": ["c", "h"], "pick": { "angle": 180.0 } } },
        "D": { "point": { "meet": ["c", "v"], "pick": { "angle": 270.0 } } },
        "gx": { "line": { "through": "A", "perpendicularTo": "h" } },
        "gxw": { "line": { "through": "C", "perpendicularTo": "h" } },
        "gy": { "line": { "through": "B", "perpendicularTo": "v" } },
        "gys": { "line": { "through": "D", "perpendicularTo": "v" } },
        "E": { "point": { "meet": ["gx", "gy"] } },
        "F": { "point": { "meet": ["gxw", "gy"] } },
        "G": { "point": { "meet": ["gxw", "gys"] } },
        "H": { "point": { "meet": ["gx", "gys"] } },
        "d45": { "line": { "through": ["O", "E"] } },
        "d135": { "line": { "through": ["O", "F"] } }
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Join A, B, C and D with straight lines. This square stands on its corner. The frets run along its sides and along lines OE and OF.",
      "create": {
        "f1": { "line": { "through": ["A", "B"] } },
        "f2": { "line": { "through": ["B", "C"] } },
        "f3": { "line": { "through": ["C", "D"] } },
        "f4": { "line": { "through": ["D", "A"] } }
      },
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw a straight line through A and F. It crosses the vertical line at M, halfway up. Draw a straight line through R and M. R is where line OE crosses the circle. The line crosses line OF at S4. Draw a circle with centre O through S4.",
      "create": {
        "ak": { "line": { "through": ["A", "F"] } },
        "M": { "point": { "meet": ["ak", "v"] } },
        "R": { "point": { "meet": ["c", "d45"], "pick": { "angle": 45.0 } } },
        "dm": { "line": { "through": ["R", "M"] } },
        "S4": { "point": { "meet": ["dm", "d135"] } },
        "cb": { "circle": { "centre": "O", "through": "S4" } }
      },
      "highlight": ["A", "F"],
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Join S1, S3, S5 and S7 with straight lines. Join S2, S4, S6 and S8 with straight lines. S1 to S8 are where the circle through S4 crosses the lines through O. The two squares make the star.",
