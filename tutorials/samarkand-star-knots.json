{
  "format": 0,
  "id": "samarkand-star-knots",
  "title": "Four- and six-pointed star knots, Samarkand",
  "short": "Samarkand star knots",
  "subtitle": "Samarkand, after Tony Lee’s drawing",
  "fold": 4,
  "chiral": true,
  "star": 6,
  "style": "Central Asian",
  "level": "advanced",
  "given": {"O": "The centre of a four-pointed star.", "A": "Sets its point radius."},
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s SAM1 drawing. The drawing gives no steps. A four-pointed star, two compass transfers and parallels through earlier crossings fix the mesh.",
    "changes": "The 10pt bands are represented by their centre lines. The square repeat preserves the p4g pattern’s handed arrangement round its fourfold centres. The steps, order and named points are ours. The palette is illustrative. No historical photograph was checked.",
    "reviewed": "2026-10-27"
  },
  "credits": [
    {
      "source": "Tiling Search, data184/SAM1: Samarkand",
      "creator": "Brian Wichmann",
