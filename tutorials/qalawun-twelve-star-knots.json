  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size for the next steps.",
      "create": {"h": {"line": {"through": ["O", "A"]}}, "c": {"circle": {"centre": "O", "through": "A"}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a circle with centre A through O. Draw a circle with centre G through O, where the line crosses the first circle on the left.",
      "create": {
        "G": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "cE": {"circle": {"centre": "A", "radiusOf": "c"}},
        "cW": {"circle": {"centre": "G", "radiusOf": "c"}}
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a vertical line through O. It crosses the first circle at D and K. Draw a circle with centre D through O. Draw a circle with centre K through O.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "K": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "cN": {"circle": {"centre": "D", "radiusOf": "c"}},
        "cS": {"circle": {"centre": "K", "radiusOf": "c"}}
      },
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a straight line through B and H, C and J, E and L, and F and M. B, C, E, F, H, J, L and M are where the four new circles cross the first circle. The first circle is now cut into twelve.",
      "create": {
        "C": {"point": {"meet": ["c", "cE"], "pick": {"angle": 60.0}}},
        "L": {"point": {"meet": ["c", "cE"], "pick": {"angle": 300.0}}},
        "E": {"point": {"meet": ["c", "cW"], "pick": {"angle": 120.0}}},
        "J": {"point": {"meet": ["c", "cW"], "pick": {"angle": 240.0}}},
        "B": {"point": {"meet": ["c", "cN"], "pick": {"angle": 30.0}}},
        "F": {"point": {"meet": ["c", "cN"], "pick": {"angle": 150.0}}},
        "H": {"point": {"meet": ["c", "cS"], "pick": {"angle": 210.0}}},
        "M": {"point": {"meet": ["c", "cS"], "pick": {"angle": 330.0}}},
        "r30": {"line": {"through": ["B", "H"]}},
        "r60": {"line": {"through": ["C", "J"]}},
        "r120": {"line": {"through": ["E", "L"]}},
        "r150": {"line": {"through": ["F", "M"]}}
      },
      "highlight": ["cE", "cW", "cN", "cS"],
      "animate": "ruler",
      "textWithoutHelpers": "The four circles cross the first circle at B, C, E, F, H, J, L and M. Draw a straight line through B and H. Draw a straight line through F and M."
    },
    {
      "id": 5,
      "text": "Draw the lines through O that halve angles AOB, BOC and COD. Draw a line through O at 90° to each new line. The circle’s twelve points on these lines are S1 to S12, counted round it.",
      "create": {
        "r15": {"line": {"through": "O", "bisects": ["A", "O", "B"]}},
        "r45": {"line": {"through": "O", "bisects": ["B", "O", "C"]}},
        "r75": {"line": {"through": "O", "bisects": ["C", "O", "D"]}},
        "r105": {"line": {"through": "O", "perpendicularTo": "r15"}},
        "r135": {"line": {"through": "O", "perpendicularTo": "r45"}},
        "r165": {"line": {"through": "O", "perpendicularTo": "r75"}},
        "S1": {"point": {"meet": ["c", "r15"], "pick": {"angle": 15.0}}},
        "S2": {"point": {"meet": ["c", "r45"], "pick": {"angle": 45.0}}},
        "S3": {"point": {"meet": ["c", "r75"], "pick": {"angle": 75.0}}},
        "S4": {"point": {"meet": ["c", "r105"], "pick": {"angle": 105.0}}},
        "S5": {"point": {"meet": ["c", "r135"], "pick": {"angle": 135.0}}},
        "S6": {"point": {"meet": ["c", "r165"], "pick": {"angle": 165.0}}},
        "S7": {"point": {"meet": ["c", "r15"], "pick": {"angle": 195.0}}},
        "S8": {"point": {"meet": ["c", "r45"], "pick": {"angle": 225.0}}},
        "S9": {"point": {"meet": ["c", "r75"], "pick": {"angle": 255.0}}},
        "S10": {"point": {"meet": ["c", "r105"], "pick": {"angle": 285.0}}},
        "S11": {"point": {"meet": ["c", "r135"], "pick": {"angle": 315.0}}},
        "S12": {"point": {"meet": ["c", "r165"], "pick": {"angle": 345.0}}}
      },
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw the three squares that make the twelve-pointed star.",
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S4, S4 and S7, S7 and S10, and S10 and S1.",
          "create": {
            "st0": {"line": {"through": ["S1", "S4"]}},
            "st3": {"line": {"through": ["S4", "S7"]}},
            "st6": {"line": {"through": ["S7", "S10"]}},
            "st9": {"line": {"through": ["S10", "S1"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S5, S5 and S8, S8 and S11, and S11 and S2.",
          "create": {
            "st1": {"line": {"through": ["S2", "S5"]}},
            "st4": {"line": {"through": ["S5", "S8"]}},
            "st7": {"line": {"through": ["S8", "S11"]}},
            "st10": {"line": {"through": ["S11", "S2"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S3 and S6, S6 and S9, S9 and S12, and S12 and S3.",
          "create": {
            "st2": {"line": {"through": ["S3", "S6"]}},
            "st5": {"line": {"through": ["S6", "S9"]}},
            "st8": {"line": {"through": ["S9", "S12"]}},
            "st11": {"line": {"through": ["S12", "S3"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 7,
      "text": "The first circle crosses the line at 45° from OA at P1, above O. Draw a circle with centre O and opening AE. It crosses that line at P2, above O. Draw vertical lines through P1 and P2. They cross the horizontal line at N1 and N2.",
      "create": {
        "P1": {"point": {"meet": ["c", "r45"], "pick": {"angle": 45.0}}},
        "root3": {"circle": {"centre": "O", "radiusFrom": ["A", "E"]}},
        "P2": {"point": {"meet": ["root3", "r45"], "pick": {"angle": 45.0}}},
        "N1v": {"line": {"through": "P1", "parallelTo": "v"}},
        "N1": {"point": {"meet": ["N1v", "h"]}},
        "N2v": {"line": {"through": "P2", "parallelTo": "v"}},
        "N2": {"point": {"meet": ["N2v", "h"]}}
      },
      "animate": "compass"
    },
    {
      "id": 8,
      "text": "Draw a circle with centre N1 through O. It crosses the horizontal line again at N3, right of N1. Draw a circle with centre N3 and opening from O to N1. It crosses that line at N4, right of N3.",
      "create": {
        "double": {"circle": {"centre": "N1", "through": "O"}},
        "N3": {"point": {"meet": ["double", "h"], "pick": {"farthest": "O"}}},
        "triple": {"circle": {"centre": "N3", "radiusFrom": ["O", "N1"]}},
        "N4": {"point": {"meet": ["triple", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 9,
      "text": "Draw a circle with centre N4 and opening from O to N2. It crosses the horizontal line at N5, towards O. Draw a circle with centre N5 through O. It crosses that line again at N6, right of N5.",
      "create": {
        "difference": {"circle": {"centre": "N4", "radiusFrom": ["O", "N2"]}},
        "N5": {"point": {"meet": ["difference", "h"], "pick": {"nearest": "O"}}},
        "apothem": {"circle": {"centre": "N5", "through": "O"}},
        "N6": {"point": {"meet": ["apothem", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 10,
      "text": "Draw a vertical line through N6. Turn it round O by 60°, five times. The six lines frame the tile, with corners T1 to T6.",
      "create": {
        "frame": {"line": {"through": "N6", "parallelTo": "v"}},
        "frames": {"repeat": {"of": ["frame"], "by": "rot6"}},
        "T1": {"point": {"meet": ["frame", "frame@1"]}},
        "T2": {"point": {"meet": ["frame@1", "frame@2"]}},
        "T3": {"point": {"meet": ["frame@2", "frame@3"]}},
        "T4": {"point": {"meet": ["frame@3", "frame@4"]}},
        "T5": {"point": {"meet": ["frame@4", "frame@5"]}},
        "T6": {"point": {"meet": ["frame@5", "frame"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 11,
      "text": "Draw a circle with centre N2 through O. It crosses the horizontal line again at N7, right of N2. Draw a circle with centre N7 and opening from O to N1. It crosses that line at N8, towards O.",
      "create": {
        "twiceRoot": {"circle": {"centre": "N2", "through": "O"}},
        "N7": {"point": {"meet": ["twiceRoot", "h"], "pick": {"farthest": "O"}}},
        "height": {"circle": {"centre": "N7", "radiusFrom": ["O", "N1"]}},
        "N8": {"point": {"meet": ["height", "h"], "pick": {"nearest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 12,
      "text": "Draw a circle with centre O through N8. It crosses the vertical line at N9, above O. Draw a horizontal line through N9. Turn it round O by 60°, five times.",
      "create": {
        "heightCircle": {"circle": {"centre": "O", "through": "N8"}},
        "N9": {"point": {"meet": ["heightCircle", "v"], "pick": {"angle": 90.0}}},
        "yh": {"line": {"through": "N9", "parallelTo": "h"}},
        "yhCopies": {"repeat": {"of": ["yh"], "by": "rot6"}}
      },
      "animate": "compass"
    },
    {
      "id": 13,
      "text": "The right tile side crosses the line through N9 turned by 300° at Q. Draw a line through Q parallel to line OC. Turn it round O by 60°, five times.",
      "create": {
        "Q": {"point": {"meet": ["frame", "yh@5"]}},
        "gl0": {"line": {"through": "Q", "parallelTo": "r60"}},
        "copies0": {"repeat": {"of": ["gl0"], "by": "rot6"}}
      },
      "animate": "ruler"
    },
    {
      "id": 14,
      "text": "Join T1, T2, T3, T4, T5 and T6 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["T1", "T2", "T3", "T4", "T5", "T6"]}},
      "animate": "fade"
    }
  ],
