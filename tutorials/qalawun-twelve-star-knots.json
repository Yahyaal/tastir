  "title": "Twelve-star knots of Qalawun’s mausoleum",
  "short": "Qalawun twelve-star knots",
  "subtitle": "Qalawun mausoleum, Cairo",
  "fold": 6,
  "star": 12,
  "style": "Mamluk",
  "region": "Egypt, Syria and Iraq",
  "level": "advanced",
  "given": {"O": "The centre of a twelve-pointed star.", "A": "Sets its full point radius."},
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s DS1 drawing. The drawing gives no steps. Three squares make the twelve-pointed star. Compass transfers set the hexagonal repeat and one height; a parallel through a crossing completes the mesh.",
    "changes": "The 10pt bands are represented by their centre lines. The teaching frame turns15°. The steps, order and named points are ours. The palette is illustrative. No monument photograph was independently checked.",
    "reviewed": "2026-10-27"
  },
  "credits": [
    {
      "source": "Tiling Search, data184/DS1: Qalawun mausoleum",
