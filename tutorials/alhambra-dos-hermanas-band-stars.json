    {
      "id": 14,
      "text": "Draw a circle with centre K1 and radius OA. It crosses line OE at Q, towards O. Draw a vertical line through Q. Turn it round O by 90°, three times.",
      "create": {
        "ck": {"circle": {"centre": "K1", "radiusOf": "c"}},
        "Q": {"point": {"meet": ["ck", "d45"], "pick": {"nearest": "O"}}},
        "qv": {"line": {"through": "Q", "parallelTo": "v"}},
        "qp": {"repeat": {"of": ["qv"], "by": "rot4"}}
