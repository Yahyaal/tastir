      "animate": "ruler"
    },
    {
      "id": 12,
      "text": "The vertical line through J1 crosses the horizontal line through R at X. Draw a line through X parallel to the line from S1 to S3. Turn it round O by 90°, three times.",
      "create": {
        "X": {"point": {"meet": ["jv1", "rh"]}},
        "xd": {"line": {"through": "X", "parallelTo": "q01"}},
        "xcopies": {"repeat": {"of": ["xd"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 13,
      "text": "The vertical line through W crosses the horizontal line at U. Draw a circle with centre U and radius OE. It crosses the horizontal line at N, to the right. Draw a vertical line through N. Turn it round O by 90°, three times.",
      "create": {
        "U": {"point": {"meet": ["wv", "h"]}},
        "cu": {"circle": {"centre": "U", "radiusFrom": ["O", "E"]}},
        "N": {"point": {"meet": ["cu", "h"], "pick": {"farthest": "O"}}},
        "nv": {"line": {"through": "N", "parallelTo": "v"}},
        "np": {"repeat": {"of": ["nv"], "by": "rot4"}}
