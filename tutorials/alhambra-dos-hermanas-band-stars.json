    },
    {
      "id": 15,
      "text": "Draw a circle with centre F and radius OA. It crosses the horizontal line at Z, beyond F. Draw a line through each of F2 and Z parallel to the line from S1 to S3. Turn both lines round O by 90°, three times.",
      "create": {
        "cz": {"circle": {"centre": "F", "radiusFrom": ["O", "A"]}},
        "Z": {"point": {"meet": ["cz", "h"], "pick": {"farthest": "O"}}},
        "fd": {"line": {"through": "F2", "parallelTo": "q01"}},
        "zd": {"line": {"through": "Z", "parallelTo": "q01"}},
        "fz": {"repeat": {"of": ["fd", "zd"], "by": "rot4"}}
