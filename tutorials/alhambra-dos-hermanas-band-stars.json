      "animate": "compass"
    },
    {
      "id": 16,
      "text": "Draw circles with centre K1 and radii OA, the distance from O to F2, and OZ. They cross the vertical line through T1 at Q1, Q2 and Q3, towards T1. Draw a line through each crossing parallel to the line from S1 to S3. Turn these three lines round O by 90°, three times.",
      "create": {
        "ck1": {"circle": {"centre": "K1", "radiusFrom": ["O", "A"]}},
        "Q1": {"point": {"meet": ["ck1", "gx"], "pick": {"angle": 40.483}}},
        "qd1": {"line": {"through": "Q1", "parallelTo": "q01"}},
        "ck2": {"circle": {"centre": "K1", "radiusFrom": ["O", "F2"]}},
        "Q2": {"point": {"meet": ["ck2", "gx"], "pick": {"angle": 29.278}}},
        "qd2": {"line": {"through": "Q2", "parallelTo": "q01"}},
        "ck3": {"circle": {"centre": "K1", "radiusFrom": ["O", "Z"]}},
        "Q3": {"point": {"meet": ["ck3", "gx"], "pick": {"angle": 14.99}}},
        "qd3": {"line": {"through": "Q3", "parallelTo": "q01"}},
        "qdp": {"repeat": {"of": ["qd1", "qd2", "qd3"], "by": "rot4"}}
      },
      "animate": "compass"
    },
    {
      "id": 17,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
