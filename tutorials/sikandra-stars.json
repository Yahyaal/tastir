  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Brian Wichmann’s IND0703 drawing, its corners snapped to exact values in thirds of OA. We devised the construction: a star at T, a third of the way to K1, turned round O, and two more kinds of line through P and Z. The drawing gives no steps.",
    "changes": "The compass steps, their order and the named points are ours. The comparison with the drawing checks the finished lines, not how the design was first laid out. David Wade’s photo of the tomb, which Wichmann drew from, was not checked.",
    "reviewed": "2026-10-25"
  },
  "credits": [
    {
      "source": "Tiling Search, data172/IND0703: Akbar’s Tomb, Sikandra",
      "creator": "Brian Wichmann",
      "url": "https://tilingsearch.mit.edu/HTML/data172/IND0703.html",
      "kind": "drawing",
      "note": "The design was read from his drawing, made from David Wade’s photo IND 0703 of Akbar’s mausoleum at Sikandra (1613) and shown in Brian Wichmann and David Wade, Islamic Design: a Mathematical Approach (Springer, 2017), figure 9.7c. The construction is ours."
    }
  ],
  "given": {
    "O": "The centre of a cross with four stars round it.",
    "A": "Halfway from O to the next cross of the same kind."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and D. These lines make the square cell, with corners K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "B", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "D", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K1"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler",
      "textWithoutHelpers": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through A. Draw a horizontal line through C. They cross at K1, a corner of the cell. Draw a straight line through O and K1."
    },
    {
      "id": 3,
      "text": "Draw a straight line through K2 and A. It crosses the line from O to K1 at T.",
      "create": {"ka": {"line": {"through": ["K2", "A"]}}, "T": {"point": {"meet": ["ka", "d45"]}}},
      "highlight": ["K2", "A", "T"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw a vertical line through T. Draw a horizontal line through T. Draw the line through T at 90° to the line from O to K1. The vertical line through T crosses the horizontal line at N. Draw a circle with centre T through N. It crosses the four lines through T at S1 to S8.",
      "create": {
        "tv": {"line": {"through": "T", "parallelTo": "v"}},
        "th": {"line": {"through": "T", "parallelTo": "h"}},
        "tp": {"line": {"through": "T", "perpendicularTo": "d45"}},
        "N": {"point": {"meet": ["tv", "h"]}},
        "ct": {"circle": {"centre": "T", "through": "N"}},
        "S1": {"point": {"meet": ["ct", "th"], "pick": {"angle": 26.565}}},
        "S2": {"point": {"meet": ["ct", "d45"], "pick": {"farthest": "O"}}},
        "S3": {"point": {"meet": ["ct", "tv"], "pick": {"angle": 63.435}}},
        "S4": {"point": {"meet": ["ct", "tp"], "pick": {"angle": 80.264}}},
        "S5": {"point": {"meet": ["ct", "th"], "pick": {"angle": 90.0}}},
        "S6": {"point": {"meet": ["ct", "d45"], "pick": {"nearest": "O"}}},
        "S7": {"point": {"meet": ["ct", "tv"], "pick": {"angle": 0.0}}},
        "S8": {"point": {"meet": ["ct", "tp"], "pick": {"angle": 9.736}}}
      },
      "highlight": ["T", "N"],
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Draw the star at T as two squares.",
      "highlight": ["ct"],
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S3, S3 and S5, S5 and S7, and S7 and S1. Draw each line long.",
          "create": {
            "q01": {"line": {"through": ["S1", "S3"]}},
            "q02": {"line": {"through": ["S3", "S5"]}},
            "q03": {"line": {"through": ["S5", "S7"]}},
            "q04": {"line": {"through": ["S7", "S1"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S4, S4 and S6, S6 and S8, and S8 and S2. Draw each line long.",
          "create": {
            "q11": {"line": {"through": ["S2", "S4"]}},
            "q12": {"line": {"through": ["S4", "S6"]}},
            "q13": {"line": {"through": ["S6", "S8"]}},
            "q14": {"line": {"through": ["S8", "S2"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 6,
      "text": "Turn the eight sides of the star round O by 90°, three times. They make a star round each of the other three corners of the square round O.",
      "create": {
        "qr": {"repeat": {"of": ["q01", "q02", "q03", "q04", "q11", "q12", "q13", "q14"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "The line through S5 and S7 crosses the line through S6 and S8 at P. Draw a line through P parallel to the line from O to K1.",
      "create": {
        "P": {"point": {"meet": ["q03", "q13"]}},
        "pd": {"line": {"through": "P", "parallelTo": "d45"}}
      },
      "highlight": ["P"],
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Look at the star to the left of T. The line through T and S4 crosses its right side at Z. Draw a horizontal line through Z.",
      "create": {
        "Z": {"point": {"meet": ["tp", "q13@1"]}},
        "zh": {"line": {"through": "Z", "parallelTo": "h"}}
      },
      "highlight": ["Z"],
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "Turn the lines through P and Z round O by 90°, three times.",
      "create": {"pz": {"repeat": {"of": ["pd", "zh"], "by": "rot4"}}},
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
