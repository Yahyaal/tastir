  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. The rosettes sit on a square grid, twice OA apart.",
      "create": {
        "c": { "circle": { "centre": "O", "through": "A" } },
        "h": { "line": { "through": ["O", "A"] } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at N. Draw a vertical line through A. Draw a horizontal line through N. These grid lines cross at K, a corner of the tile. Draw a straight line through O and K.",
      "create": {
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "N": { "point": { "meet": ["c", "v"], "pick": { "angle": 90 } } },
        "gx": { "line": { "through": "A", "perpendicularTo": "h" } },
        "gy": { "line": { "through": "N", "perpendicularTo": "v" } },
        "K": { "point": { "meet": ["gx", "gy"] } },
        "r45": { "line": { "through": ["O", "K"] } }
      },
      "highlight": ["h", "c"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw a circle with centre A through O. It crosses the first circle at P60. Draw a straight line through O and P60. Draw the lines through O that halve the angles, and the lines at 90° to them. There is now a line through O every 15°.",
      "textWithoutHelpers": "Draw a circle with centre A through O. It crosses the first circle at P60. Draw a straight line through O and P60. Draw the lines through O that halve the angles, at 15°, 30°, 45°, 75° and 90°.",
      "create": {
        "cA": { "circle": { "centre": "A", "through": "O" } },
        "P60": { "point": { "meet": ["c", "cA"], "pick": { "angle": 60 } } },
        "r60": { "line": { "through": ["O", "P60"] } },
        "r30": { "line": { "through": "O", "bisects": ["A", "O", "P60"] } },
        "P30": { "point": { "meet": ["c", "r30"], "pick": { "angle": 30 } } },
        "r15": { "line": { "through": "O", "bisects": ["A", "O", "P30"] } },
        "r75": { "line": { "through": "O", "bisects": ["P60", "O", "N"] } },
        "r105": { "line": { "through": "O", "perpendicularTo": "r15" } },
        "r120": { "line": { "through": "O", "perpendicularTo": "r30" } },
        "r135": { "line": { "through": "O", "perpendicularTo": "r45" } },
        "r150": { "line": { "through": "O", "perpendicularTo": "r60" } },
        "r165": { "line": { "through": "O", "perpendicularTo": "r75" } }
      },
      "highlight": ["c", "A"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a straight line through P45 and P255. They are points of the circle, 150° apart. Turn this line round O by 30°, eleven times. These are the twelve star lines.",
      "create": {
        "P45": { "point": { "meet": ["c", "r45"], "pick": { "angle": 45 } } },
        "P255": { "point": { "meet": ["c", "r75"], "pick": { "angle": 255 } } },
        "F2": { "line": { "through": ["P45", "P255"] } },
        "F2s": { "repeat": { "of": ["F2"], "by": "rot12" } }
      },
      "highlight": ["P45", "P255"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw a straight line through A and N. It crosses the first star line at V9, a corner of the rosette. Draw a line through V9 at 30° to the horizontal. Turn it round O.",
      "create": {
        "an": { "line": { "through": ["A", "N"] } },
        "V9": { "point": { "meet": ["an", "F2"] } },
        "F1": { "line": { "through": "V9", "parallelTo": "r30" } },
        "F1s": { "repeat": { "of": ["F1"], "by": "rot12" } }
      },
      "highlight": ["A", "N", "F2"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw a circle with centre W whose radius is the distance from O to K. W is the corner like V9, below and to the left of O. The circle crosses the horizontal line at V13, the outer tip of the rosette. Draw a line through V13 at 135°. Turn it round O.",
      "create": {
        "W": { "point": { "meet": ["F1@1", "F2@11"] } },
        "ck": { "circle": { "centre": "W", "radiusFrom": ["O", "K"] } },
        "V13": { "point": { "meet": ["ck", "h"], "pick": { "angle": 0 } } },
        "F3": { "line": { "through": "V13", "parallelTo": "r135" } },
        "F3s": { "repeat": { "of": ["F3"], "by": "rot12" } }
      },
      "highlight": ["O", "K", "W"],
      "animate": "compass"
    },
    {
