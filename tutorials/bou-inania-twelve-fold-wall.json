{
  "format": 0,
  "id": "bou-inania-twelve-fold-wall",
  "title": "Bou Inania twelve-fold wall",
  "fold": 4,
  "style": "Marinid zellige (Fès)",
  "level": "advanced",
  "credits": [
    {
      "source": "Photograph of the zellige dado of the Bou Inania madrasa, Fès (Wikimedia Commons, File:Bou_inania_DSCF2978.jpg)",
      "url": "https://commons.wikimedia.org/wiki/File:Bou_inania_DSCF2978.jpg",
      "note": "The design was read from this photo; the construction is our own reconstruction, not a published one."
    }
  ],
  "given": {"O": "centre of a rosette", "A": "halfway to the next rosette"},
  "steps": [
    {
      "id": 1,
      "text": "Draw a circle about the centre O through A, and the horizontal line through both. A is halfway to the next rosette: the rosettes of this wall sit on a square grid, two radii apart.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw the vertical through O. Through A and through the top of the circle draw lines at right angles to these: they are lines of the grid, and where they cross is the corner K of the tile, where an eight-pointed star will sit.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "N": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "N", "perpendicularTo": "v"}},
        "K": {"point": {"meet": ["gx", "gy"]}}
      },
      "highlight": ["h", "c"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Divide the circle into twelve: with the compass still open to OA, put its point on A and mark where it cuts the circle at 60°. Join O to that mark, and halve the angles between the lines through O, so you have a line through O every 15°.",
      "create": {
        "cA": {"circle": {"centre": "A", "through": "O"}},
        "P60": {"point": {"meet": ["c", "cA"], "pick": {"angle": 60.0}}},
        "r60": {"line": {"through": ["O", "P60"]}},
        "r45": {"line": {"through": ["O", "K"]}},
        "r30": {"line": {"through": "O", "bisects": ["A", "O", "P60"]}},
        "P30": {"point": {"meet": ["c", "r30"], "pick": {"angle": 30.0}}},
        "r15": {"line": {"through": "O", "bisects": ["A", "O", "P30"]}},
        "r75": {"line": {"through": "O", "bisects": ["P60", "O", "N"]}},
        "r105": {"line": {"through": "O", "perpendicularTo": "r15"}},
        "r120": {"line": {"through": "O", "perpendicularTo": "r30"}},
        "r135": {"line": {"through": "O", "perpendicularTo": "r45"}},
        "r150": {"line": {"through": "O", "perpendicularTo": "r60"}},
        "r165": {"line": {"through": "O", "perpendicularTo": "r75"}}
      },
      "highlight": ["c", "A"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Join A to the top of the circle. Where this line crosses the line through the 45° point of the circle at 60° is the first corner of the rosette. Copy it round the rosette: mirror it in the horizontal, then turn both copies twelve times.",
      "create": {
        "an": {"line": {"through": ["A", "N"]}},
        "c45": {"point": {"meet": ["c", "r45"], "pick": {"angle": 45.0}}},
        "l9": {"line": {"through": "c45", "parallelTo": "r60"}},
        "V9": {"point": {"meet": ["an", "l9"]}},
        "V9_p": {"line": {"through": "V9", "perpendicularTo": "h"}},
        "V9_c": {"circle": {"centre": "O", "through": "V9"}},
        "W9": {"point": {"meet": ["V9_p", "V9_c"], "pick": {"angle": 321.333}}},
        "V9s": {"repeat": {"of": ["V9", "W9"], "by": "rot12"}}
      },
      "highlight": ["A", "N"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Open the compass from O to the corner K. Put its point on the copy of that first corner down and to the left of O, and mark where the arc crosses the horizontal on the right: this is the tip of the rosette’s outer ring. Copy it round.",
      "create": {
        "ck": {"circle": {"centre": "W9@9", "radiusFrom": ["O", "K"]}},
        "V13": {"point": {"meet": ["ck", "h"], "pick": {"angle": 0.0}}},
        "V13s": {"repeat": {"of": ["V13"], "by": "rot12"}}
      },
      "highlight": ["O", "K", "W9@9"],
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "Through the first corner draw a line at 30°, and through the outer tip a line at 75°; they cross at the next corner. Copy it round.",
      "create": {
        "L8_30": {"line": {"through": "V9@11", "parallelTo": "r30"}},
        "L8_75": {"line": {"through": "V13@1", "parallelTo": "r75"}},
        "V8": {"point": {"meet": ["L8_30", "L8_75"]}},
        "V8_p": {"line": {"through": "V8", "perpendicularTo": "h"}},
        "V8_c": {"circle": {"centre": "O", "through": "V8"}},
        "W8": {"point": {"meet": ["V8_p", "V8_c"], "pick": {"angle": 353.43}}},
        "V8s": {"repeat": {"of": ["V8", "W8"], "by": "rot12"}}
      },
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Through the outer tip draw a line at 135°, and through the first corner one at 150°: they cross at the corner beside the tip. Copy it round.",
      "create": {
        "L12_135": {"line": {"through": "V13", "parallelTo": "r135"}},
        "L12_150": {"line": {"through": "V9@11", "parallelTo": "r150"}},
        "V12": {"point": {"meet": ["L12_135", "L12_150"]}},
        "V12_p": {"line": {"through": "V12", "perpendicularTo": "h"}},
        "V12_c": {"circle": {"centre": "O", "through": "V12"}},
        "W12": {"point": {"meet": ["V12_p", "V12_c"], "pick": {"angle": 356.822}}},
        "V12s": {"repeat": {"of": ["V12", "W12"], "by": "rot12"}}
      },
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Where the 15° line from O meets the 135° line through the first corner is the point of a shield between two petals. Copy it round.",
      "create": {
        "L10_15": {"line": {"through": "O", "parallelTo": "r15"}},
        "L10_135": {"line": {"through": "W9@2", "parallelTo": "r135"}},
        "V10": {"point": {"meet": ["L10_15", "L10_135"]}},
        "V10s": {"repeat": {"of": ["V10"], "by": "rot12"}}
      },
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "Lines at 135° and 75° through the corners beside the tips meet near the middle, at the inner end of a petal. Copy it round.",
      "create": {
        "L2_135": {"line": {"through": "W12@11", "parallelTo": "r135"}},
        "L2_75": {"line": {"through": "V12@2", "parallelTo": "r75"}},
        "V2": {"point": {"meet": ["L2_135", "L2_75"]}},
        "V2s": {"repeat": {"of": ["V2"], "by": "rot12"}}
      },
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "The 150° line through that petal end meets the horizontal at the point between two petals. Copy it round.",
      "create": {
        "L3_150": {"line": {"through": "V2", "parallelTo": "r150"}},
        "L3_0": {"line": {"through": "V13", "parallelTo": "h"}},
        "V3": {"point": {"meet": ["L3_150", "L3_0"]}},
        "V3s": {"repeat": {"of": ["V3"], "by": "rot12"}}
      },
      "animate": "ruler"
    },
    {
      "id": 11,
      "text": "A 120° line and a 165° line through corners beside the tips meet at the shoulder of a petal. Copy it round.",
      "create": {
        "L5_120": {"line": {"through": "V12@11", "parallelTo": "r120"}},
        "L5_165": {"line": {"through": "W12", "parallelTo": "r165"}},
        "V5": {"point": {"meet": ["L5_120", "L5_165"]}},
        "V5_p": {"line": {"through": "V5", "perpendicularTo": "h"}},
        "V5_c": {"circle": {"centre": "O", "through": "V5"}},
        "W5": {"point": {"meet": ["V5_p", "V5_c"], "pick": {"angle": 355.201}}},
        "V5s": {"repeat": {"of": ["V5", "W5"], "by": "rot12"}}
      },
      "animate": "ruler"
    },
    {
      "id": 12,
      "text": "The level line through the first corner and the 60° line through the shoulder meet at the next corner. Copy it round.",
      "create": {
        "L6_0": {"line": {"through": "V9@11", "parallelTo": "h"}},
        "L6_60": {"line": {"through": "V5", "parallelTo": "r60"}},
        "V6": {"point": {"meet": ["L6_0", "L6_60"]}},
        "V6_p": {"line": {"through": "V6", "perpendicularTo": "h"}},
        "V6_c": {"circle": {"centre": "O", "through": "V6"}},
        "W6": {"point": {"meet": ["V6_p", "V6_c"], "pick": {"angle": 348.516}}},
        "V6s": {"repeat": {"of": ["V6", "W6"], "by": "rot12"}}
      },
      "animate": "ruler"
    },
    {
      "id": 13,
      "text": "A 150° line through that corner meets the level line through the 30° corner. Copy it round.",
      "create": {
        "L7_150": {"line": {"through": "V6", "parallelTo": "r150"}},
        "L7_0": {"line": {"through": "V8", "parallelTo": "h"}},
        "V7": {"point": {"meet": ["L7_150", "L7_0"]}},
        "V7_p": {"line": {"through": "V7", "perpendicularTo": "h"}},
        "V7_c": {"circle": {"centre": "O", "through": "V7"}},
        "W7": {"point": {"meet": ["V7_p", "V7_c"], "pick": {"angle": 352.738}}},
        "V7s": {"repeat": {"of": ["V7", "W7"], "by": "rot12"}}
      },
      "animate": "ruler"
    },
    {
      "id": 14,
      "text": "The level line through the first corner meets the 105° line through the corner beside the tip. Copy it round.",
      "create": {
        "L11_0": {"line": {"through": "V9@11", "parallelTo": "h"}},
        "L11_105": {"line": {"through": "V12", "parallelTo": "r105"}},
        "V11": {"point": {"meet": ["L11_0", "L11_105"]}},
        "V11_p": {"line": {"through": "V11", "perpendicularTo": "h"}},
        "V11_c": {"circle": {"centre": "O", "through": "V11"}},
        "W11": {"point": {"meet": ["V11_p", "V11_c"], "pick": {"angle": 352.314}}},
        "V11s": {"repeat": {"of": ["V11", "W11"], "by": "rot12"}}
