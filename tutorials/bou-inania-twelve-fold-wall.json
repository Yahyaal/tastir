        "Ugx0": {"point": {"meet": ["co", "gx"], "pick": {"angle": 27.157}}},
        "ULgx0": {"line": {"through": "Ugx0", "perpendicularTo": "gx"}},
        "Ugx1": {"point": {"meet": ["co", "gx"], "pick": {"angle": 56.08}}},
