    {
      "id": 11,
      "text": "Draw a circle with centre E and opening OA. It crosses the horizontal line through O at Z, right of E.",
      "create": {
        "cz": {"circle": {"centre": "E", "radiusFrom": ["O", "A"]}},
        "Z": {"point": {"meet": ["cz", "h"], "pick": {"farthest": "O"}}}
