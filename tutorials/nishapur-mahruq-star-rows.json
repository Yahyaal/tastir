      "highlight": ["B", "K1", "P"],
      "animate": "compass"
    },
    {
      "id": 10,
      "text": "Draw a circle with centre A and opening from O to K1. It crosses the horizontal line through O at J, right of A.",
      "create": {
        "cj": {"circle": {"centre": "A", "radiusOf": "ck"}},
        "J": {"point": {"meet": ["cj", "h"], "pick": {"angle": 0.0}}}
      },
      "highlight": ["A", "K1", "J"],
