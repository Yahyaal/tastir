    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Brian Wichmann’s F109 drawing and its corners snapped to exact values. OA is the star’s point radius. Compass transfers of the square diagonal and of OA give the longer rectangular repeat. The drawing gives no steps; we devised the construction.",
    "changes": "The plain tile boundaries are retained. The palette is illustrative. The source says the original colouring had extensive ornamentation, which is not reconstructed here. No tomb photograph was checked. The compass steps, their order and the named points are ours.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data16/F109: Mahruq imamzadeh, Nishapur",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data16/F109.html",
      "note": "Read from his finished drawing, not construction instructions. Mahmood Maher al-Naqsh, Design and execution of drawing in Iranian tilework, Islamic period (Reza Abbasi Museum, 1983), volume 3, figure 109, page 144; Mahruq imamzadeh, Nishabur, Iran."
    }
  ],
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and D. They cross at K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "B", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "D", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K1"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler",
      "textWithoutHelpers": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through A. Draw a horizontal line through C. They cross at K1. Draw a straight line through O and K1."
    },
    {
      "id": 3,
      "text": "The line from O to K1 crosses the circle at F. Draw a vertical line through F. It crosses the horizontal line through O at M. Turn the vertical line round O by 90°, three times.",
      "create": {
        "F": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "fv": {"line": {"through": "F", "parallelTo": "v"}},
        "M": {"point": {"meet": ["fv", "h"]}},
        "square": {"repeat": {"of": ["fv"], "by": "rot4"}}
      },
      "highlight": ["F", "M"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw a straight line through A and C. Turn it round O by 90°, three times.",
      "create": {"ac": {"line": {"through": ["A", "C"]}}, "diamond": {"repeat": {"of": ["ac"], "by": "rot4"}}},
      "highlight": ["A", "C"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw a circle with centre O through K1. It crosses the vertical line through O at V, above O. Draw a circle with centre A through O. It crosses the horizontal line through O again at E, right of A.",
      "create": {
        "ck": {"circle": {"centre": "O", "through": "K1"}},
        "V": {"point": {"meet": ["ck", "v"], "pick": {"angle": 90.0}}},
        "ce": {"circle": {"centre": "A", "through": "O"}},
        "E": {"point": {"meet": ["ce", "h"], "pick": {"farthest": "O"}}}
      },
      "highlight": ["K1", "V", "E"],
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "Draw a circle with centre E and opening from O to K1. It crosses the horizontal line through O at X, right of E.",
      "create": {
        "cx": {"circle": {"centre": "E", "radiusOf": "ck"}},
        "X": {"point": {"meet": ["cx", "h"], "pick": {"farthest": "O"}}}
      },
      "highlight": ["E", "K1", "X"],
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Draw a vertical line through X. Draw a horizontal line through V. Turn both lines round O by 180°. They cross at N1, N2, N3 and N4.",
      "create": {
        "sideX": {"line": {"through": "X", "parallelTo": "v"}},
        "sideY": {"line": {"through": "V", "parallelTo": "h"}},
        "frame": {"repeat": {"of": ["sideX", "sideY"], "by": "rot2"}},
        "N1": {"point": {"meet": ["sideX", "sideY"]}},
        "N2": {"point": {"meet": ["sideX@1", "sideY"]}},
        "N3": {"point": {"meet": ["sideX@1", "sideY@1"]}},
        "N4": {"point": {"meet": ["sideX", "sideY@1"]}}
      },
      "highlight": ["X", "V"],
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Draw a circle with centre E and opening OM. It crosses the horizontal line through O at W, right of E. Draw a vertical line through W. Turn it round O by 180°.",
      "create": {
        "cw": {"circle": {"centre": "E", "radiusFrom": ["O", "M"]}},
        "W": {"point": {"meet": ["cw", "h"], "pick": {"farthest": "O"}}},
        "wx": {"line": {"through": "W", "parallelTo": "v"}},
        "wxPair": {"repeat": {"of": ["wx"], "by": "rot2"}}
      },
      "highlight": ["E", "M", "W"],
      "animate": "compass"
    },
    {
      "id": 9,
      "text": "Draw a circle with centre B and opening from O to K1. It crosses the horizontal line through O at P, right of O.",
      "create": {
        "cp": {"circle": {"centre": "B", "radiusOf": "ck"}},
        "P": {"point": {"meet": ["cp", "h"], "pick": {"angle": 0.0}}}
