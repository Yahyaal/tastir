    {
      "id": 12,
      "text": "Draw a circle with centre J and opening from O to K1. It crosses the horizontal line through O at R, right of J. Draw a circle with centre P, with the same opening. It crosses the horizontal line through O at S, right of P.",
      "create": {
        "cr": {"circle": {"centre": "J", "radiusOf": "ck"}},
        "R": {"point": {"meet": ["cr", "h"], "pick": {"farthest": "O"}}},
        "cs": {"circle": {"centre": "P", "radiusOf": "ck"}},
        "S": {"point": {"meet": ["cs", "h"], "pick": {"angle": 0.0}}}
      },
      "highlight": ["J", "P", "K1", "R", "S"],
      "animate": "compass"
    },
    {
      "id": 13,
      "text": "Draw a line through Z at 90° to the line from O to K1. Turn the lines round O by 90°, three times.",
      "create": {
        "diagonal_Z": {"line": {"through": "Z", "perpendicularTo": "d45"}},
        "copies_Z": {"repeat": {"of": ["diagonal_Z"], "by": "rot4"}}
      },
      "highlight": ["Z", "K1"],
      "animate": "ruler"
    },
    {
      "id": 14,
      "text": "Draw a line through each of R and S at 90° to the line from O to K1. Turn the lines round O by 90°, three times.",
      "create": {
        "diagonal_R": {"line": {"through": "R", "perpendicularTo": "d45"}},
        "diagonal_S": {"line": {"through": "S", "perpendicularTo": "d45"}},
        "copies_R": {"repeat": {"of": ["diagonal_R", "diagonal_S"], "by": "rot4"}}
      },
      "highlight": ["R", "S", "K1"],
      "animate": "ruler"
    },
    {
      "id": 15,
      "text": "Join N1, N2, N3 and N4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["N1", "N2", "N3", "N4"]}},
      "animate": "fade"
    }
  ],
