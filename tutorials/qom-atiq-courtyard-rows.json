  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Brian Wichmann’s P105 drawing and its corners snapped to exact values. OA is a small square’s half-diagonal. Compass transfers of OA, OM and the unit-square diagonal give the rectangular repeat. The drawing gives no steps; we devised the construction.",
    "changes": "The plain boundaries and three source fill classes are retained. The numeric palette is illustrative. No courtyard photograph was checked. The compass steps, their order and the named points are ours.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data181/P105: Atiq courtyard, Qom, Iran",
