      "highlight": ["N1", "N2", "N3", "N4"],
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "The same star sits at each corner of the tile.",
      "highlight": ["K1"],
      "animate": "compass",
      "parts": [
        {
          "text": "Draw a circle with centre K1 and the same radius as the small circle. It crosses the vertical line through N1 at P. It crosses the horizontal line through N2 at Q. Draw a straight line through P and Q.",
          "create": {
            "ck": {"circle": {"centre": "K1", "radiusOf": "cs"}},
            "P": {"point": {"meet": ["ck", "tE"], "pick": {"angle": 38.411}}},
            "Q": {"point": {"meet": ["ck", "tN"], "pick": {"angle": 51.589}}},
            "pq": {"line": {"through": ["P", "Q"]}}
          },
          "animate": "compass",
          "highlight": ["K1", "cs"]
        },
        {
          "text": "The line through S2 and S8 crosses the horizontal line at W. Draw a circle with centre A through W. It crosses the horizontal line again at X. Draw a vertical line through X.",
          "create": {
            "W": {"point": {"meet": ["q14", "h"]}},
            "cw": {"circle": {"centre": "A", "through": "W"}},
            "X": {"point": {"meet": ["cw", "h"], "pick": {"farthest": "O"}}},
            "xv": {"line": {"through": "X", "parallelTo": "v"}}
          },
          "animate": "compass",
          "highlight": ["S2", "S8"]
        }
      ]
    },
    {
      "id": 9,
      "text": "Draw a circle with centre N1 and the same radius as the small circle. It crosses the horizontal line at T and U. T is nearer to O. Draw a line through each of T and U parallel to the line through S1 and S3.",
      "create": {
        "cn1": {"circle": {"centre": "N1", "radiusOf": "cs"}},
        "T": {"point": {"meet": ["cn1", "h"], "pick": {"nearest": "O"}}},
        "U": {"point": {"meet": ["cn1", "h"], "pick": {"farthest": "O"}}},
        "tl": {"line": {"through": "T", "parallelTo": "q01"}},
        "ul": {"line": {"through": "U", "parallelTo": "q01"}}
      },
      "highlight": ["N1", "S1", "S3"],
      "animate": "compass"
    },
    {
      "id": 10,
      "text": "Draw a circle with centre O through T. It crosses line OE at V. Draw a vertical line through V.",
      "create": {
        "ct": {"circle": {"centre": "O", "through": "T"}},
        "V": {"point": {"meet": ["ct", "d45"], "pick": {"angle": 45.0}}},
        "vv": {"line": {"through": "V", "parallelTo": "v"}}
      },
      "highlight": ["T"],
      "animate": "compass"
    },
    {
      "id": 11,
      "text": "Turn the lines of the last three steps round O by 90°, three times.",
      "create": {"cp": {"repeat": {"of": ["pq", "xv", "tl", "ul", "vv"], "by": "rot4"}}},
      "animate": "ruler"
    },
    {
      "id": 12,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
