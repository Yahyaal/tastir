        "tE": {"line": {"through": "N1", "perpendicularTo": "h"}},
        "tW": {"line": {"through": "N3", "perpendicularTo": "h"}},
        "tN": {"line": {"through": "N2", "perpendicularTo": "v"}},
        "tS": {"line": {"through": "N4", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["tE", "tN"]}},
        "K2": {"point": {"meet": ["tN", "tW"]}},
        "K3": {"point": {"meet": ["tW", "tS"]}},
        "K4": {"point": {"meet": ["tS", "tE"]}}
