  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Brian Wichmann’s F219 drawing, its corners snapped to exact values. We devised the construction: a star at O and one at each corner of the tile, the same size, and nearly every line a side of a star, carried on. The drawing gives no steps.",
    "changes": "The compass steps, their order and the named points are ours. The comparison with the drawing checks the finished lines, not how the design was first laid out. No photo of the real mosaic was checked.",
    "reviewed": "2026-10-25"
  },
  "credits": [
    {
      "source": "Tiling Search, data150/F219: Alhambra, Salón de Comares",
      "creator": "Brian Wichmann",
      "url": "https://tilingsearch.mit.edu/HTML/data150/F219.html",
      "kind": "drawing",
      "note": "The design was read from his drawing of the tile mosaic on the jambs of the double window in the throne alcove of the Salón de Comares, in its original black and white, after Antonio Fernández-Puertas, The Alhambra, vol. I (1997), p. 417, fig. 219. The construction is ours."
    }
  ],
  "given": {
    "O": "The centre of an eight-pointed star.",
    "A": "A quarter of the way from O to the next star on the horizontal line."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at B. Draw a vertical line through A. Draw a horizontal line through B. They cross at E. Draw a straight line through O and E.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "B": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "ga": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gb": {"line": {"through": "B", "perpendicularTo": "v"}},
        "E": {"point": {"meet": ["ga", "gb"]}},
        "d45": {"line": {"through": ["O", "E"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "The circle crosses line OE at F. Draw a circle with centre E through F. Draw a circle with centre O and the same radius.",
      "create": {
        "F": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "ce": {"circle": {"centre": "E", "through": "F"}},
        "cs": {"circle": {"centre": "O", "radiusOf": "ce"}}
      },
      "highlight": ["E"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw the line through O at 90° to line OE. The small circle with centre O crosses the four lines through O at S1 to S8.",
      "create": {
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}},
        "S1": {"point": {"meet": ["cs", "h"], "pick": {"angle": 0.0}}},
        "S2": {"point": {"meet": ["cs", "d45"], "pick": {"angle": 45.0}}},
        "S3": {"point": {"meet": ["cs", "v"], "pick": {"angle": 90.0}}},
        "S4": {"point": {"meet": ["cs", "d135"], "pick": {"angle": 135.0}}},
        "S5": {"point": {"meet": ["cs", "h"], "pick": {"angle": 180.0}}},
        "S6": {"point": {"meet": ["cs", "d45"], "pick": {"angle": 225.0}}},
        "S7": {"point": {"meet": ["cs", "v"], "pick": {"angle": 270.0}}},
        "S8": {"point": {"meet": ["cs", "d135"], "pick": {"angle": 315.0}}}
      },
      "highlight": ["cs"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw the star at O as two squares.",
      "highlight": ["cs"],
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S3, S3 and S5, S5 and S7, and S7 and S1. Draw each line long.",
          "create": {
            "q01": {"line": {"through": ["S1", "S3"]}},
            "q02": {"line": {"through": ["S3", "S5"]}},
            "q03": {"line": {"through": ["S5", "S7"]}},
            "q04": {"line": {"through": ["S7", "S1"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S4, S4 and S6, S6 and S8, and S8 and S2. Draw each line long.",
          "create": {
            "q11": {"line": {"through": ["S2", "S4"]}},
            "q12": {"line": {"through": ["S4", "S6"]}},
            "q13": {"line": {"through": ["S6", "S8"]}},
            "q14": {"line": {"through": ["S8", "S2"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 6,
      "text": "Draw a circle with centre A through O. It crosses the horizontal line again at N1. Draw a circle with centre O through N1. It crosses the two lines through O at N1, N2, N3 and N4.",
      "create": {
        "cao": {"circle": {"centre": "A", "through": "O"}},
        "N1": {"point": {"meet": ["cao", "h"], "pick": {"farthest": "O"}}},
        "cn": {"circle": {"centre": "O", "through": "N1"}},
        "N2": {"point": {"meet": ["cn", "v"], "pick": {"angle": 90.0}}},
        "N3": {"point": {"meet": ["cn", "h"], "pick": {"angle": 180.0}}},
        "N4": {"point": {"meet": ["cn", "v"], "pick": {"angle": 270.0}}}
      },
      "highlight": ["A"],
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Draw a vertical line through each of N1 and N3. Draw a horizontal line through each of N2 and N4. These lines make the square tile, with corners K1, K2, K3 and K4.",
