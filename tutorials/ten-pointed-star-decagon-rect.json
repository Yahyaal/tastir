        "U1": { "point": { "meet": ["s0", "s8"] } },
        "U2": { "point": { "meet": ["s1", "s9"] } },
        "U3": { "point": { "meet": ["s0", "s2"] } },
        "U4": { "point": { "meet": ["s1", "s3"] } },
        "U5": { "point": { "meet": ["s2", "s4"] } },
        "U6": { "point": { "meet": ["s3", "s5"] } },
        "U7": { "point": { "meet": ["s4", "s6"] } },
        "U8": { "point": { "meet": ["s5", "s7"] } },
        "U9": { "point": { "meet": ["s6", "s8"] } },
        "U10": { "point": { "meet": ["s7", "s9"] } }
      },
      "animate": "ruler"
    }
  ],
