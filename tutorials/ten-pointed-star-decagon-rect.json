  "given": {
    "O": "The centre of the decagram.",
    "A": "Any point to the right of O. OA is the radius of the decagram’s circle."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. This is the circle of the ten-pointed star.",
      "create": {
        "c": { "circle": { "centre": "O", "through": "A" } },
        "h": { "line": { "through": ["O", "A"] } },
        "F": { "point": { "meet": ["c", "h"], "pick": { "angle": 180.0 } } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at N and S.",
      "create": {
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "N": { "point": { "meet": ["c", "v"], "pick": { "angle": 90.0 } } },
        "S": { "point": { "meet": ["c", "v"], "pick": { "angle": 270.0 } } }
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw a circle with centre F through O. F is where the line crosses the circle on the left. The new circle crosses the first at Y1 and Y2. Draw a straight line through Y1 and Y2. It crosses the horizontal line at M, halfway from O to F.",
      "create": {
        "cW": { "circle": { "centre": "F", "through": "O" } },
        "Y1": { "point": { "meet": ["c", "cW"], "pick": { "angle": 120.0 } } },
        "Y2": { "point": { "meet": ["c", "cW"], "pick": { "angle": 240.0 } } },
        "m": { "line": { "through": ["Y1", "Y2"] } },
        "M": { "point": { "meet": ["m", "h"] } }
      },
      "highlight": ["F"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a circle with centre M through N. It crosses the horizontal line at R. The distance OR is a tenth of the way round the circle.",
      "create": {
        "cM": { "circle": { "centre": "M", "through": "N" } },
        "R": { "point": { "meet": ["cM", "h"], "pick": { "angle": 0.0 } } }
      },
      "highlight": ["M"],
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Draw a circle with centre A whose radius is the distance from O to R. It crosses the circle at B and K. Draw circles of the same size round the circle, each centred where the last one crosses it. They mark C, D, E, G, H and J. The circle is now cut into ten.",
      "create": {
        "cF0": { "circle": { "centre": "A", "radiusFrom": ["O", "R"] } },
        "B": { "point": { "meet": ["c", "cF0"], "pick": { "angle": 36.0 } } },
        "K": { "point": { "meet": ["c", "cF0"], "pick": { "angle": 324.0 } } },
        "cF1": { "circle": { "centre": "B", "radiusFrom": ["O", "R"] } },
        "C": { "point": { "meet": ["c", "cF1"], "pick": { "angle": 72.0 } } },
        "cF2": { "circle": { "centre": "C", "radiusFrom": ["O", "R"] } },
        "D": { "point": { "meet": ["c", "cF2"], "pick": { "angle": 108.0 } } },
        "cF3": { "circle": { "centre": "D", "radiusFrom": ["O", "R"] } },
        "E": { "point": { "meet": ["c", "cF3"], "pick": { "angle": 144.0 } } },
        "cF9": { "circle": { "centre": "K", "radiusFrom": ["O", "R"] } },
        "J": { "point": { "meet": ["c", "cF9"], "pick": { "angle": 288.0 } } },
        "cF8": { "circle": { "centre": "J", "radiusFrom": ["O", "R"] } },
        "H": { "point": { "meet": ["c", "cF8"], "pick": { "angle": 252.0 } } },
        "cF7": { "circle": { "centre": "H", "radiusFrom": ["O", "R"] } },
        "G": { "point": { "meet": ["c", "cF7"], "pick": { "angle": 216.0 } } }
      },
      "highlight": ["R"],
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "Draw a straight line through A and D, B and E, C and F, and D and G. Draw a straight line through E and H, F and J, G and K, and H and A. Draw a straight line through J and B, and K and C. The ten lines make the ten-pointed star.",
      "create": {
        "s0": { "line": { "through": ["A", "D"] } },
        "s1": { "line": { "through": ["B", "E"] } },
        "s2": { "line": { "through": ["C", "F"] } },
        "s3": { "line": { "through": ["D", "G"] } },
        "s4": { "line": { "through": ["E", "H"] } },
        "s5": { "line": { "through": ["F", "J"] } },
        "s6": { "line": { "through": ["G", "K"] } },
        "s7": { "line": { "through": ["H", "A"] } },
        "s8": { "line": { "through": ["J", "B"] } },
        "s9": { "line": { "through": ["K", "C"] } }
      },
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Join A, B, C, D, E, F, G, H, J and K with straight lines. This is the decagon.",
      "create": {
        "decagon": { "polygon": ["A", "B", "C", "D", "E", "F", "G", "H", "J", "K"] }
      },
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Join V1, V2, V3 and V4 to mark the rectangle tile that repeats. V1 to V4 are where the star lines cross outside the circle.",
      "create": {
        "V1": { "point": { "meet": ["s2", "s8"] } },
        "V2": { "point": { "meet": ["s0", "s4"] } },
        "V3": { "point": { "meet": ["s3", "s7"] } },
        "V4": { "point": { "meet": ["s5", "s9"] } },
        "tile": { "polygon": ["V1", "V2", "V3", "V4"] }
      },
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "Mark X1 to X10, where the star lines cross nearest O. Mark U1 to U10, where they cross next.",
      "create": {
        "X1": { "point": { "meet": ["s8", "s9"] } },
        "X2": { "point": { "meet": ["s0", "s9"] } },
        "X3": { "point": { "meet": ["s0", "s1"] } },
        "X4": { "point": { "meet": ["s1", "s2"] } },
        "X5": { "point": { "meet": ["s2", "s3"] } },
