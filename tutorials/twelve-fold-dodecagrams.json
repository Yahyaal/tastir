    "parts": [
      {
        "text": "Ink the first star: from K1 through H1, K2, H2 and on round the star, back to K1. Its points are H1 to H6, and its inner corners K1 to K6.",
        "paths": 1
      },
      {
        "text": "Ink the second star: from A through J1, B, J2 and on round the star, back to A. Its points are A, B, C, D, E and F.",
        "paths": 1
      }
    ]
  },
  "pattern": {
    "cell": "tile",
    "text": "Put copies of the hexagon side by side. Neighbouring stars touch point to point. The space between three stars stays open.",
    "palette": "Timurid tile",
