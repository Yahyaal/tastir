{
  "format": 0,
  "id": "twelve-fold-dodecagrams",
  "title": "Twelve-pointed stars",
  "fold": 6,
  "star": 12,
  "style": "Seljuk",
  "level": "beginner",
  "construction": {
    "basis": "instructions",
    "fidelity": "close",
    "note": "The two six-pointed stars turned 30° apart follow the Tuts+ construction. The work log records a measured, exact overlay of the repeated stars on its final drawing.",
    "changes": "The app expands the shared six-fold foundation and represents the repeat with a tangent hexagon. This is a documented drawing match; no matching monument photo was established.",
    "reviewed": "2026-10-21"
  },
  "credits": [
    {
      "source": "Geometric Design: Working With 6 and 12 (Dodecagram Pattern)",
      "creator": "Envato Tuts+",
      "url": "https://design.tutsplus.com/tutorials/geometric-design-working-with-6-and-12--cms-22872",
      "note": "The pattern of two six-pointed stars in each circle of the seven-circle grid follows this tutorial.",
      "steps": [6, 7]
    }
  ],
  "given": {
    "O": "The centre of the star.",
    "A": "Any point to the right of O. The distance OA is the radius of the first circle, and the unit for every length."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size until the end.",
      "create": {
        "h": { "line": { "through": ["O", "A"] } },
        "c": { "circle": { "centre": "O", "through": "A" } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a circle with centre A through O. Draw a circle with centre D through O, where the line crosses the first circle on the left. The two new circles touch at O.",
      "create": {
        "D": { "point": { "meet": ["c", "h"], "pick": { "angle": 180 } } },
        "cE": { "circle": { "centre": "A", "radiusOf": "c" } },
        "cW": { "circle": { "centre": "D", "radiusOf": "c" } }
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a circle with centre B through O. Draw a circle with centre C through O. Draw a circle with centre E through O. Draw a circle with centre F through O. B, C, E and F are where the two new circles cross the first one. Six circles now ring the first circle.",
      "create": {
        "B": { "point": { "meet": ["c", "cE"], "pick": { "angle": 60 } } },
        "F": { "point": { "meet": ["c", "cE"], "pick": { "angle": 300 } } },
        "C": { "point": { "meet": ["c", "cW"], "pick": { "angle": 120 } } },
        "E": { "point": { "meet": ["c", "cW"], "pick": { "angle": 240 } } },
        "c60": { "circle": { "centre": "B", "radiusOf": "c" } },
        "c120": { "circle": { "centre": "C", "radiusOf": "c" } },
        "c240": { "circle": { "centre": "E", "radiusOf": "c" } },
        "c300": { "circle": { "centre": "F", "radiusOf": "c" } }
      },
      "highlight": ["cE", "cW"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a straight line through O and P1, O and P2, and O and P3. P1, P2 and P3 are the tips of the large petals outside the first circle.",
      "create": {
        "P1": { "point": { "meet": ["cE", "c60"], "pick": { "farthest": "O" } } },
        "P2": { "point": { "meet": ["c60", "c120"], "pick": { "farthest": "O" } } },
        "P3": { "point": { "meet": ["c120", "cW"], "pick": { "farthest": "O" } } },
        "m30": { "line": { "through": ["O", "P1"] } },
        "m90": { "line": { "through": ["O", "P2"] } },
        "m150": { "line": { "through": ["O", "P3"] } }
      },
      "highlight": ["cE", "c60", "c120", "cW"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Join H1, H2, H3, H4, H5 and H6 with straight lines. H1 to H6 are where the three lines cross the first circle. The circle is now divided into twelve.",
      "create": {
        "H1": { "point": { "meet": ["c", "m30"], "pick": { "angle": 30 } } },
        "H2": { "point": { "meet": ["c", "m90"], "pick": { "angle": 90 } } },
        "H3": { "point": { "meet": ["c", "m150"], "pick": { "angle": 150 } } },
        "H4": { "point": { "meet": ["c", "m30"], "pick": { "angle": 210 } } },
        "H5": { "point": { "meet": ["c", "m90"], "pick": { "angle": 270 } } },
        "H6": { "point": { "meet": ["c", "m150"], "pick": { "angle": 330 } } },
        "hex": { "polygon": ["H1", "H2", "H3", "H4", "H5", "H6"] }
      },
      "highlight": ["m30", "m90", "m150"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Join H2, H4 and H6 with straight lines. Join H1, H3 and H5 with straight lines. The two triangles make a six-pointed star. They cross at K1 to K6.",
      "create": {
        "up": { "polygon": ["H2", "H4", "H6"] },
        "down": { "polygon": ["H1", "H3", "H5"] },
        "K1": { "point": { "meet": ["up", "down"], "pick": { "angle": 0 } } },
        "K2": { "point": { "meet": ["up", "down"], "pick": { "angle": 60 } } },
        "K3": { "point": { "meet": ["up", "down"], "pick": { "angle": 120 } } },
        "K4": { "point": { "meet": ["up", "down"], "pick": { "angle": 180 } } },
        "K5": { "point": { "meet": ["up", "down"], "pick": { "angle": 240 } } },
        "K6": { "point": { "meet": ["up", "down"], "pick": { "angle": 300 } } }
      },
      "highlight": ["H1", "H2", "H3", "H4", "H5", "H6"],
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Join A, C and E with straight lines. Join B, D and F with straight lines. They make a second six-pointed star, turned 30° from the first. Its triangles cross at J1 to J6.",
      "create": {
        "right": { "polygon": ["A", "C", "E"] },
        "left": { "polygon": ["B", "D", "F"] },
        "J1": { "point": { "meet": ["right", "left"], "pick": { "angle": 30 } } },
        "J2": { "point": { "meet": ["right", "left"], "pick": { "angle": 90 } } },
        "J3": { "point": { "meet": ["right", "left"], "pick": { "angle": 150 } } },
        "J4": { "point": { "meet": ["right", "left"], "pick": { "angle": 210 } } },
        "J5": { "point": { "meet": ["right", "left"], "pick": { "angle": 270 } } },
        "J6": { "point": { "meet": ["right", "left"], "pick": { "angle": 330 } } }
      },
      "highlight": ["A", "B", "C", "D", "E", "F"],
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Draw the tile.",
      "parts": [
        {
          "text": "Draw a line through each of H1, H2, H3, H4, H5 and H6, at 90° to its line from O. The six lines just touch the circle. They make a hexagon with corners T1 to T6.",
          "create": {
            "tan30": { "line": { "through": "H1", "perpendicularTo": "m30" } },
            "tan90": { "line": { "through": "H2", "perpendicularTo": "m90" } },
            "tan150": { "line": { "through": "H3", "perpendicularTo": "m150" } },
            "tan210": { "line": { "through": "H4", "perpendicularTo": "m30" } },
            "tan270": { "line": { "through": "H5", "perpendicularTo": "m90" } },
            "tan330": { "line": { "through": "H6", "perpendicularTo": "m150" } },
            "T1": { "point": { "meet": ["tan30", "tan330"] } },
            "T2": { "point": { "meet": ["tan90", "tan30"] } },
            "T3": { "point": { "meet": ["tan150", "tan90"] } },
            "T4": { "point": { "meet": ["tan210", "tan150"] } },
            "T5": { "point": { "meet": ["tan270", "tan210"] } },
            "T6": { "point": { "meet": ["tan330", "tan270"] } }
          },
          "highlight": ["H1", "H2", "H3", "H4", "H5", "H6"],
          "animate": "ruler"
        },
        {
          "text": "Join T1, T2, T3, T4, T5 and T6 to mark the tile that repeats.",
          "create": { "tile": { "polygon": ["T1", "T2", "T3", "T4", "T5", "T6"] } },
          "animate": "fade"
        }
      ]
    }
  ],
  "ink": {
    "text": "Ink the outline of each six-pointed star. Together they make a twelve-pointed star.",
    "paths": [
