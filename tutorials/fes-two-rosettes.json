    {
      "id": 11,
      "text": "The vertical line through P9 crosses the horizontal line through P12 at P13. The vertical line through P1, turned by 135°, crosses the horizontal line through P12 at P14. Draw a line through P2 at 90° to line OE. Draw a line through P13 at 90° to line OE. Draw a line through P14 at 90° to line OE. Turn the new lines round O by 90°, three times.",
      "create": {
        "P13": {"point": {"meet": ["m9", "m12"]}},
        "P14": {"point": {"meet": ["m1@3", "m12"]}},
        "m13": {"line": {"through": "P2", "parallelTo": "d135"}},
        "m14": {"line": {"through": "P13", "parallelTo": "d135"}},
        "m15": {"line": {"through": "P14", "parallelTo": "d135"}},
