  "given": {
    "O": "The centre of a framed star.",
    "A": "Halfway from O to the next framed star."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {
        "c": { "circle": { "centre": "O", "through": "A" } },
        "h": { "line": { "through": ["O", "A"] } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and N. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and N. These lines make the square cell, with corners K1, K2, K3 and K4. Draw a straight line through O and K1. Draw a straight line through O and K2.",
      "textWithoutHelpers": "Draw a vertical line through O. The two lines cross the circle at A, B, C and N. Draw a vertical line through each of A and B. Draw a horizontal line through C. These lines make three sides of the square cell, with corners K1 and K2. Draw a straight line through O and K1. Draw a straight line through O and K2.",
      "create": {
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "C": { "point": { "meet": ["c", "v"], "pick": { "angle": 90.0 } } },
        "B": { "point": { "meet": ["c", "h"], "pick": { "angle": 180.0 } } },
        "N": { "point": { "meet": ["c", "v"], "pick": { "angle": 270.0 } } },
        "gx": { "line": { "through": "A", "perpendicularTo": "h" } },
        "gxw": { "line": { "through": "B", "perpendicularTo": "h" } },
        "gy": { "line": { "through": "C", "perpendicularTo": "v" } },
        "gys": { "line": { "through": "N", "perpendicularTo": "v" } },
        "K1": { "point": { "meet": ["gx", "gy"] } },
        "K2": { "point": { "meet": ["gxw", "gy"] } },
        "K3": { "point": { "meet": ["gxw", "gys"] } },
        "K4": { "point": { "meet": ["gx", "gys"] } },
        "d45": { "line": { "through": ["O", "K1"] } },
        "d135": { "line": { "through": ["O", "K2"] } }
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw a vertical line through R, where the circle crosses the line from O to K1. It crosses the horizontal line at E. Draw a circle with centre O whose radius is the distance from E to A. It crosses the horizontal line at T1, a point of the star.",
      "create": {
        "R": { "point": { "meet": ["c", "d45"], "pick": { "angle": 45.0 } } },
        "dv": { "line": { "through": "R", "perpendicularTo": "h" } },
        "E": { "point": { "meet": ["dv", "h"] } },
        "cs": { "circle": { "centre": "O", "radiusFrom": ["E", "A"] } },
        "T1": { "point": { "meet": ["cs", "h"], "pick": { "angle": 0.0 } } }
      },
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw two lines through T1, parallel to the lines from O to K1 and from O to K2. Draw a vertical line through S, where the small circle crosses the line from O to K1.",
      "create": {
        "e1": { "line": { "through": "T1", "parallelTo": "d135" } },
        "e2": { "line": { "through": "T1", "parallelTo": "d45" } },
        "S": { "point": { "meet": ["cs", "d45"], "pick": { "angle": 45.0 } } },
        "x1": { "line": { "through": "S", "parallelTo": "v" } }
      },
      "highlight": ["cs"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "The vertical line through S crosses a line through T1 at V. Draw a horizontal line through V. It crosses the other line through T1 at F. Draw a vertical line through F. It is a side of the frame round the star.",
      "create": {
        "V": { "point": { "meet": ["x1", "e1"] } },
        "vh": { "line": { "through": "V", "parallelTo": "h" } },
        "F": { "point": { "meet": ["vh", "e2"] } },
        "fr": { "line": { "through": "F", "parallelTo": "v" } }
      },
      "highlight": ["S", "T1"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "The vertical line through S crosses the horizontal line at S1. Draw a circle with centre A whose radius is the distance from O to S1. It crosses the horizontal line at Q1 and Q2. Draw a vertical line through each of Q1 and Q2. Draw a circle with centre A through T1. It crosses the line beyond A at T2. Draw a line through T2 parallel to the line from O to K2.",
      "textWithoutHelpers": "The vertical line through S crosses the horizontal line at S1. Draw a circle with centre A whose radius is the distance from O to S1. It crosses the horizontal line at Q1 and Q2. Draw a vertical line through Q1. Draw a circle with centre A through T1. It crosses the line beyond A at T2. Draw a line through T2 parallel to the line from O to K2.",
      "create": {
        "S1": { "point": { "meet": ["x1", "h"] } },
        "cq": { "circle": { "centre": "A", "radiusFrom": ["O", "S1"] } },
        "Q1": { "point": { "meet": ["cq", "h"], "pick": { "nearest": "O" } } },
        "Q2": { "point": { "meet": ["cq", "h"], "pick": { "farthest": "O" } } },
        "x2": { "line": { "through": "Q1", "parallelTo": "v" } },
        "x3": { "line": { "through": "Q2", "parallelTo": "v" } },
        "ct": { "circle": { "centre": "A", "through": "T1" } },
        "T2": { "point": { "meet": ["ct", "h"], "pick": { "farthest": "O" } } },
        "e3": { "line": { "through": "T2", "parallelTo": "d135" } }
      },
      "highlight": ["A"],
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Draw a circle with centre A whose radius is the distance from V to T1. It crosses the horizontal line at G1 and G2. Draw a line through each of G1 and G2, parallel to the line from O to K2. They are sides of the small diamond at A.",
      "create": {
        "cc": { "circle": { "centre": "A", "radiusFrom": ["V", "T1"] } },
        "G1": { "point": { "meet": ["cc", "h"], "pick": { "nearest": "O" } } },
        "G2": { "point": { "meet": ["cc", "h"], "pick": { "farthest": "O" } } },
        "g1": { "line": { "through": "G1", "parallelTo": "d135" } },
        "g2": { "line": { "through": "G2", "parallelTo": "d135" } }
      },
      "highlight": ["V", "T1"],
      "animate": "compass"
    },
    {
