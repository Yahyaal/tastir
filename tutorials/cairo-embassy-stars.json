        "cg": {"circle": {"centre": "G", "through": "O"}},
        "K1": {"point": {"meet": ["cg", "h"], "pick": {"farthest": "O"}}},
        "K2": {"point": {"meet": ["cg", "v"], "pick": {"farthest": "O"}}},
        "ck": {"circle": {"centre": "O", "through": "K1"}},
        "K3": {"point": {"meet": ["ck", "h"], "pick": {"angle": 180.0}}},
        "K4": {"point": {"meet": ["ck", "v"], "pick": {"angle": 270.0}}}
      },
      "highlight": ["G", "K1", "K2"],
      "animate": "compass"
    },
    {
      "id": 8,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
