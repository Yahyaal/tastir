    {
      "id": 4,
      "text": "Draw a straight line through A and C. Draw a straight line through U1 and U2. U1 and U2 are where the circle crosses the vertical line through A and the horizontal line through C. Draw a vertical line through each of T1 and T2.",
      "create": {
        "s1": {"line": {"through": ["A", "C"]}},
        "s3": {"line": {"through": ["U1", "U2"]}},
