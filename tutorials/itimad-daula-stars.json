  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Brian Wichmann’s F78 drawing, the centre lines of its bands snapped to exact values. We devised the construction. Every line is a side of a star of two squares, carried on: the star at O, which is the star of the Leones doors, and a star of the same size at T, two on each side of the cell. The drawing gives no steps.",
    "changes": "The compass steps, their order and the named points are ours. The comparison with the drawing checks the finished lines, not how the design was first laid out. Wichmann draws the lines as interlaced bands; the tutorial draws their centre lines. No photo of the tomb was checked.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data153/F78: Mausoleum of Itimad al-Daula, Agra",
      "creator": "Brian Wichmann",
      "url": "https://tilingsearch.mit.edu/HTML/data153/F78.html",
      "kind": "drawing",
      "note": "The design was read from his drawing. He takes it from Clévenot, figure 78 (ornament on a pillar of the tomb of Itimad al-Daula, Agra, 1622), and lists the same design in David Wade’s photos IND 0414 (the same tomb), IRA 1002 (the Hakim mosque, Isfahan) and TRA 0506 (the Tillya-Kari madrasa, Samarkand), and at the Nim Avard madrasa, Isfahan. The construction is ours."
    }
  ],
  "given": {
    "O": "The centre of an eight-pointed star.",
    "A": "Halfway across the cell on the horizontal line."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and D. These lines make the square cell, with corners K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "B", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "D", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K1"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler",
      "textWithoutHelpers": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through A. Draw a horizontal line through C. They cross at K1, a corner of the cell. Draw a straight line through O and K1."
    },
    {
      "id": 3,
      "text": "The circle crosses the line from O to K1 at F. Draw a circle with centre K1 through F. Draw a circle with centre O and the same radius.",
      "create": {
        "F": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "ck": {"circle": {"centre": "K1", "through": "F"}},
        "cs": {"circle": {"centre": "O", "radiusOf": "ck"}}
      },
      "highlight": ["K1"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw the line through O at 90° to the line from O to K1. The small circle with centre O crosses the four lines through O at S1 to S8.",
      "create": {
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}},
        "S1": {"point": {"meet": ["cs", "h"], "pick": {"angle": 0.0}}},
        "S2": {"point": {"meet": ["cs", "d45"], "pick": {"angle": 45.0}}},
        "S3": {"point": {"meet": ["cs", "v"], "pick": {"angle": 90.0}}},
        "S4": {"point": {"meet": ["cs", "d135"], "pick": {"angle": 135.0}}},
        "S5": {"point": {"meet": ["cs", "h"], "pick": {"angle": 180.0}}},
        "S6": {"point": {"meet": ["cs", "d45"], "pick": {"angle": 225.0}}},
        "S7": {"point": {"meet": ["cs", "v"], "pick": {"angle": 270.0}}},
        "S8": {"point": {"meet": ["cs", "d135"], "pick": {"angle": 315.0}}}
      },
      "highlight": ["cs"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw the star at O as two squares.",
      "highlight": ["cs"],
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S3, S3 and S5, S5 and S7, and S7 and S1. Draw each line long, to the sides of the cell.",
          "create": {
            "q01": {"line": {"through": ["S1", "S3"]}},
            "q02": {"line": {"through": ["S3", "S5"]}},
            "q03": {"line": {"through": ["S5", "S7"]}},
            "q04": {"line": {"through": ["S7", "S1"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S4, S4 and S6, S6 and S8, and S8 and S2. Draw each line long, to the sides of the cell.",
          "create": {
            "q11": {"line": {"through": ["S2", "S4"]}},
            "q12": {"line": {"through": ["S4", "S6"]}},
            "q13": {"line": {"through": ["S6", "S8"]}},
            "q14": {"line": {"through": ["S8", "S2"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 6,
      "text": "Draw a circle with centre C and the same radius as the small circle. It crosses the horizontal line through C at T, on the right of C. Draw a circle with centre T through C. It crosses the horizontal line through C again at U.",
      "create": {
        "cc": {"circle": {"centre": "C", "radiusOf": "cs"}},
        "T": {"point": {"meet": ["cc", "gy"], "pick": {"angle": 67.5}}},
        "ct": {"circle": {"centre": "T", "through": "C"}},
        "U": {"point": {"meet": ["ct", "gy"], "pick": {"angle": 50.361}}}
      },
      "highlight": ["C", "T", "U"],
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "A second star sits at T. Its circle passes through F. Draw a vertical line and a horizontal line through F. The horizontal line crosses the circle with centre T again at G. Draw a vertical line through G.",
      "create": {
        "fv": {"line": {"through": "F", "parallelTo": "v"}},
        "fh": {"line": {"through": "F", "parallelTo": "h"}},
        "G": {"point": {"meet": ["ct", "fh"], "pick": {"angle": 80.264}}},
        "gv": {"line": {"through": "G", "parallelTo": "v"}}
      },
      "highlight": ["F", "G"],
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Draw a straight line through A and C. Draw a line through U parallel to line AC. Draw a line through U parallel to the line from O to K1. With the lines through F and G they make the star at T.",
      "create": {
        "ac": {"line": {"through": ["A", "C"]}},
        "ua": {"line": {"through": "U", "parallelTo": "ac"}},
        "ud": {"line": {"through": "U", "parallelTo": "d45"}}
      },
      "highlight": ["A", "U"],
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "Turn the lines of the last two steps round O by 90°, three times. They make the stars on the four sides of the cell.",
      "create": {"tp": {"repeat": {"of": ["fv", "gv", "ac", "ua", "ud"], "by": "rot4"}}},
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
