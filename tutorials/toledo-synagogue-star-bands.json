    {
      "id": 4,
      "text": "Keep the compass open to OE. Draw circles with centres B, G1 and G2 in turn. Each circle crosses the horizontal line to the right at G1, G2 and G3.",
      "create": {
        "cg1": {"circle": {"centre": "B", "radiusFrom": ["O", "E"]}},
        "G1": {"point": {"meet": ["cg1", "h"], "pick": {"angle": 0.0}}},
        "cg2": {"circle": {"centre": "G1", "radiusFrom": ["O", "E"]}},
