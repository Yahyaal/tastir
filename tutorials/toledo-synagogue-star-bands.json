    {
      "id": 5,
      "text": "Draw a circle with centre O through G3. It crosses the horizontal and vertical lines at T1 to T4. Draw a vertical line through each of T1 and T3. Draw a horizontal line through each of T2 and T4. They make a square with corners K1, K2, K3 and K4.",
      "create": {
        "co": {"circle": {"centre": "O", "through": "G3"}},
        "T1": {"point": {"meet": ["co", "h"], "pick": {"angle": 0.0}}},
        "T2": {"point": {"meet": ["co", "v"], "pick": {"angle": 90.0}}},
