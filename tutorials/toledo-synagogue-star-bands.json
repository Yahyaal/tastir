        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}}
      },
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "Draw a circle with centre K1 and radius OA. It crosses line OE at N, towards O. Draw a vertical line through N. Turn it round O by 90°, three times. The circle crosses the vertical line through T1 at Q, towards T1. Draw a line through Q parallel to the line from S1 to S3. Turn it round O by 90°, three times.",
      "create": {
