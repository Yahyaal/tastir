        "N": {"point": {"meet": ["ck", "d45"], "pick": {"nearest": "O"}}},
        "nv": {"line": {"through": "N", "parallelTo": "v"}},
        "np": {"repeat": {"of": ["nv"], "by": "rot4"}},
        "Q": {"point": {"meet": ["ck", "gx"], "pick": {"angle": 34.668}}},
        "qd": {"line": {"through": "Q", "parallelTo": "q01"}},
        "qp": {"repeat": {"of": ["qd"], "by": "rot4"}}
      },
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Draw a circle with centre O and radius AB. It crosses line OE at M, above O. Draw a line through M parallel to the line from S1 to S3. Turn it round O by 90°, three times.",
      "create": {
        "c2": {"circle": {"centre": "O", "radiusFrom": ["A", "B"]}},
        "M": {"point": {"meet": ["c2", "d45"], "pick": {"angle": 45.0}}},
        "md": {"line": {"through": "M", "parallelTo": "q01"}},
        "mcopy": {"repeat": {"of": ["md"], "by": "rot4"}}
      },
      "animate": "compass"
    },
    {
