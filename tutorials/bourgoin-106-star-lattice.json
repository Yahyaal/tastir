  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size for the next steps.",
      "create": {"h": {"line": {"through": ["O", "A"]}}, "c": {"circle": {"centre": "O", "through": "A"}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a circle with centre A through O. Draw a circle with centre G through O, where the line crosses the first circle on the left.",
      "create": {
        "G": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "cE": {"circle": {"centre": "A", "radiusOf": "c"}},
        "cW": {"circle": {"centre": "G", "radiusOf": "c"}}
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a vertical line through O. It crosses the first circle at D and K. Draw a circle with centre D through O. Draw a circle with centre K through O.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "K": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "cN": {"circle": {"centre": "D", "radiusOf": "c"}},
        "cS": {"circle": {"centre": "K", "radiusOf": "c"}}
      },
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a straight line through B and H, C and J, E and L, and F and M. B, C, E, F, H, J, L and M are where the four new circles cross the first circle. The first circle is now cut into twelve.",
      "create": {
        "C": {"point": {"meet": ["c", "cE"], "pick": {"angle": 60.0}}},
        "L": {"point": {"meet": ["c", "cE"], "pick": {"angle": 300.0}}},
        "E": {"point": {"meet": ["c", "cW"], "pick": {"angle": 120.0}}},
        "J": {"point": {"meet": ["c", "cW"], "pick": {"angle": 240.0}}},
        "B": {"point": {"meet": ["c", "cN"], "pick": {"angle": 30.0}}},
        "F": {"point": {"meet": ["c", "cN"], "pick": {"angle": 150.0}}},
        "H": {"point": {"meet": ["c", "cS"], "pick": {"angle": 210.0}}},
        "M": {"point": {"meet": ["c", "cS"], "pick": {"angle": 330.0}}},
        "r30": {"line": {"through": ["B", "H"]}},
        "r60": {"line": {"through": ["C", "J"]}},
        "r120": {"line": {"through": ["E", "L"]}},
        "r150": {"line": {"through": ["F", "M"]}}
      },
      "highlight": ["cE", "cW", "cN", "cS"],
      "animate": "ruler",
      "textWithoutHelpers": "The four circles cross the first circle at B, C, E, F, H, J, L and M."
    },
    {
      "id": 5,
      "text": "Draw the lines through O that halve angles AOB, BOC and COD. Draw a line through O at 90° to each new line. The circle crosses the lines at 15° and 45° from OA at S1 and S2, above O.",
      "create": {
        "r15": {"line": {"through": "O", "bisects": ["A", "O", "B"]}},
        "r45": {"line": {"through": "O", "bisects": ["B", "O", "C"]}},
        "r75": {"line": {"through": "O", "bisects": ["C", "O", "D"]}},
        "r105": {"line": {"through": "O", "perpendicularTo": "r15"}},
        "r135": {"line": {"through": "O", "perpendicularTo": "r45"}},
        "r165": {"line": {"through": "O", "perpendicularTo": "r75"}},
        "S1": {"point": {"meet": ["c", "r15"], "pick": {"angle": 15.0}}},
        "S2": {"point": {"meet": ["c", "r45"], "pick": {"angle": 45.0}}}
      },
      "animate": "ruler",
      "textWithoutHelpers": "Draw the lines through O that halve angles AOB and BOC. The circle crosses them at S1 and S2, above O."
    },
    {
      "id": 6,
      "text": "Draw the line through O that halves the angle at O between A and S2. Draw a horizontal line through S1. The two lines cross at P1, above OA.",
      "create": {
        "r22": {"line": {"through": "O", "bisects": ["A", "O", "S2"]}},
        "sh": {"line": {"through": "S1", "parallelTo": "h"}},
        "P1": {"point": {"meet": ["sh", "r22"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Draw lines through P1 parallel to line OC and the line at 165° from OA. Turn them round O by 45°, seven times. These lines make the eight-pointed star.",
      "create": {
        "st0": {"line": {"through": "P1", "parallelTo": "r60"}},
        "starCopies0": {"repeat": {"of": ["st0"], "by": "rot8"}},
        "st1": {"line": {"through": "P1", "parallelTo": "r165"}},
        "starCopies1": {"repeat": {"of": ["st1"], "by": "rot8"}}
      },
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Draw a circle with centre O and opening AE. It crosses the line at 45° from OA at P2, above O. Draw a vertical line through P2. It crosses the horizontal line at N1.",
      "create": {
        "root3": {"circle": {"centre": "O", "radiusFrom": ["A", "E"]}},
        "P2": {"point": {"meet": ["root3", "r45"], "pick": {"angle": 45.0}}},
        "p2v": {"line": {"through": "P2", "parallelTo": "v"}},
        "N1": {"point": {"meet": ["p2v", "h"]}}
      },
      "animate": "compass"
    },
    {
      "id": 9,
      "text": "Draw vertical lines through C and B. They cross the horizontal line at N2 and N3. Draw a circle with centre N1 and opening from O to N2. It crosses that line at N4, right of N1.",
      "create": {
        "N2v": {"line": {"through": "C", "parallelTo": "v"}},
        "N2": {"point": {"meet": ["N2v", "h"]}},
        "N3v": {"line": {"through": "B", "parallelTo": "v"}},
        "N3": {"point": {"meet": ["N3v", "h"]}},
        "sum1": {"circle": {"centre": "N1", "radiusFrom": ["O", "N2"]}},
        "N4": {"point": {"meet": ["sum1", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 10,
      "text": "Draw a circle with centre N4 and opening from O to N3. It crosses the horizontal line at N5, right of N4.",
      "create": {
        "sum2": {"circle": {"centre": "N4", "radiusFrom": ["O", "N3"]}},
        "N5": {"point": {"meet": ["sum2", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 11,
      "text": "Draw a vertical line through N5. Turn it round O by 90°, three times. The four lines frame the tile, with corners T1 to T4.",
      "create": {
        "frame": {"line": {"through": "N5", "parallelTo": "v"}},
        "frames": {"repeat": {"of": ["frame"], "by": "rot4"}},
        "T1": {"point": {"meet": ["frame", "frame@1"]}},
        "T2": {"point": {"meet": ["frame@1", "frame@2"]}},
        "T3": {"point": {"meet": ["frame@2", "frame@3"]}},
        "T4": {"point": {"meet": ["frame@3", "frame"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 12,
      "text": "The left tile side crosses the horizontal line at W. Draw a circle with centre W and the same opening as the first circle. Draw lines through W parallel to lines OC and OE. They cross the new circle at V1 and V2, right of W, above and below it.",
      "create": {
        "W": {"point": {"meet": ["frame@2", "h"]}},
        "neighbour": {"circle": {"centre": "W", "radiusOf": "c"}},
        "neighbourRay60": {"line": {"through": "W", "parallelTo": "r60"}},
        "neighbourRay120": {"line": {"through": "W", "parallelTo": "r120"}},
        "V1": {"point": {"meet": ["neighbour", "neighbourRay60"], "pick": {"angle": 157.5}}},
        "V2": {"point": {"meet": ["neighbour", "neighbourRay120"], "pick": {"angle": 202.5}}}
      },
      "animate": "compass",
      "textWithoutHelpers": "The left tile side crosses the horizontal line at W. Draw a circle with centre W and the same opening as the first circle. Draw a line through W parallel to line OC. It crosses the new circle at V1, right of W. V2 is the matching point below the horizontal line."
    },
    {
      "id": 13,
      "text": "Draw lines through V1 parallel to the lines at 45° and 75° from OA. Draw lines through V2 parallel to the lines at 105° and 135° from OA. Turn these four lines round O by 90°, three times.",
      "create": {
        "neighbourV145": {"line": {"through": "V1", "parallelTo": "r45"}},
        "neighbourV145copies": {"repeat": {"of": ["neighbourV145"], "by": "rot4"}},
        "neighbourV175": {"line": {"through": "V1", "parallelTo": "r75"}},
        "neighbourV175copies": {"repeat": {"of": ["neighbourV175"], "by": "rot4"}},
        "neighbourV2105": {"line": {"through": "V2", "parallelTo": "r105"}},
        "neighbourV2105copies": {"repeat": {"of": ["neighbourV2105"], "by": "rot4"}},
        "neighbourV2135": {"line": {"through": "V2", "parallelTo": "r135"}},
        "neighbourV2135copies": {"repeat": {"of": ["neighbourV2135"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 14,
      "text": "The larger circle crosses the horizontal and vertical lines at N6 and N7, right of O and above O. Draw a horizontal line through N7. It crosses the right tile side at Q1. Draw a line through Q1 parallel to the line at 15° from OA. Turn it round O by 90°, three times.",
      "create": {
        "N6": {"point": {"meet": ["root3", "h"], "pick": {"angle": 0.0}}},
        "N7": {"point": {"meet": ["root3", "v"], "pick": {"angle": 90.0}}},
        "root3h": {"line": {"through": "N7", "parallelTo": "h"}},
        "Q1": {"point": {"meet": ["frame", "root3h"]}},
        "gl0": {"line": {"through": "Q1", "parallelTo": "r15"}},
        "copies0": {"repeat": {"of": ["gl0"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 15,
      "text": "The new line crosses the vertical line through O at Q2. Draw a line through Q2 parallel to the line at 165° from OA. Turn it round O by 90°, three times.",
      "create": {
        "Q2": {"point": {"meet": ["v", "gl0"]}},
        "gl1": {"line": {"through": "Q2", "parallelTo": "r165"}},
        "copies1": {"repeat": {"of": ["gl1"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 16,
      "text": "Draw a vertical line through N6. It crosses the top tile side at Q3. Draw a line through Q3 parallel to the line at 105° from OA. Turn it round O by 90°, three times.",
      "create": {
        "root3v": {"line": {"through": "N6", "parallelTo": "v"}},
        "Q3": {"point": {"meet": ["frame@1", "root3v"]}},
        "gl2": {"line": {"through": "Q3", "parallelTo": "r105"}},
        "copies2": {"repeat": {"of": ["gl2"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 17,
      "text": "The new line crosses the horizontal line at Q4. Draw a line through Q4 parallel to the line at 75° from OA. Turn it round O by 90°, three times.",
      "create": {
        "Q4": {"point": {"meet": ["h", "gl2"]}},
        "gl3": {"line": {"through": "Q4", "parallelTo": "r75"}},
        "copies3": {"repeat": {"of": ["gl3"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 18,
      "text": "Join T1, T2, T3 and T4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["T1", "T2", "T3", "T4"]}},
      "animate": "fade"
