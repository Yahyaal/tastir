  "id": "bourgoin-106-star-lattice",
  "title": "Star lattice of Bourgoin’s Plate 106",
  "short": "Bourgoin 106 star lattice",
  "subtitle": "Bourgoin, Plate 106; examples in Cairo",
  "fold": 4,
  "star": 8,
  "style": "Egyptian",
  "level": "advanced",
  "given": {
    "O": "The centre of an eight-pointed star.",
    "A": "Sets the point radius of a neighbouring six-pointed star."
  },
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s P106 drawing. The drawing gives no steps. An angle bisector and a projected circle point fix the eight-pointed star. Compass transfers and four parallel families complete its square repeat.",
    "changes": "Plain polygon boundaries are retained. The steps, order and named points are ours. The palette is illustrative. No monument photograph was independently checked.",
    "reviewed": "2026-10-27"
  },
  "credits": [
    {
      "source": "Tiling Search, data168/P106: Bourgoin Plate106",
      "creator": "Brian Wichmann",
