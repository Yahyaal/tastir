      { "through": ["S4", "R7"] },
      { "through": ["S4", "R8"] },
      { "through": ["S5", "R9"] },
      { "through": ["S5", "R10"] },
      { "through": ["S6", "R11"] },
      { "through": ["S6", "R12"] }
    ],
    "parts": [
      {
        "text": "Ink the large star: from K1 through H1, K2, H2 and on round the star, back to K1. Its points are H1 to H6, and its inner corners K1 to K6.",
        "paths": 1
      },
      {
        "text": "Ink the small star: from J1 through S1, J2, S2 and on round the star, back to J1. Its points are S1 to S6, and its inner corners J1 to J6.",
        "paths": 1
      },
      {
        "text": "Ink from S1 to R1 and from S1 to R2. Ink the same two lines from each of S2 to S6. They end at R1 to R12 on the hexagon.",
        "paths": 12
      }
    ]
  },
  "pattern": {
    "cell": "hex",
    "text": "Put copies of the hexagon side by side. The lines that leave one tile carry on into the next. Three large stars touch at every corner of the hexagons.",
