  "given": {
    "O": "The centre of the star.",
    "A": "Any point to the right of O. The distance OA is the radius of the first circle, and the unit for every length."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal line, put the compass point on it and draw a circle. Keep the compass at this opening until the end.",
      "create": {"h": {"line": {"through": ["O", "A"]}}, "c": {"circle": {"centre": "O", "through": "A"}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Put the compass point where the circle crosses the line on the right and draw a circle through the centre. Do the same on the left. The two new circles touch at the centre.",
      "create": {
        "E": {"point": {"meet": ["c", "h"], "pick": {"angle": 0}}},
        "W": {"point": {"meet": ["c", "h"], "pick": {"angle": 180}}},
        "cE": {"circle": {"centre": "E", "radiusOf": "c"}},
        "cW": {"circle": {"centre": "W", "radiusOf": "c"}}
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "The two new circles cross the first one at four more points. Draw a circle of the same size around each of them. Six circles now ring the first, and their crossings divide it into six.",
      "create": {
        "P60": {"point": {"meet": ["c", "cE"], "pick": {"angle": 60}}},
        "P300": {"point": {"meet": ["c", "cE"], "pick": {"angle": 300}}},
        "P120": {"point": {"meet": ["c", "cW"], "pick": {"angle": 120}}},
        "P240": {"point": {"meet": ["c", "cW"], "pick": {"angle": 240}}},
        "c60": {"circle": {"centre": "P60", "radiusOf": "c"}},
        "c120": {"circle": {"centre": "P120", "radiusOf": "c"}},
        "c240": {"circle": {"centre": "P240", "radiusOf": "c"}},
        "c300": {"circle": {"centre": "P300", "radiusOf": "c"}}
      },
      "highlight": ["cE", "cW"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Outside the first circle, each pair of neighbouring circles makes a large petal. Rule a line through the centre and the tips of two opposite petals; do it three times. One line is vertical and two lean at 30° either side of it.",
      "create": {
        "X30": {"point": {"meet": ["cE", "c60"], "pick": {"farthest": "O"}}},
        "X90": {"point": {"meet": ["c60", "c120"], "pick": {"farthest": "O"}}},
        "X150": {"point": {"meet": ["c120", "cW"], "pick": {"farthest": "O"}}},
        "m30": {"line": {"through": ["O", "X30"]}},
        "m90": {"line": {"through": ["O", "X90"]}},
        "m150": {"line": {"through": ["O", "X150"]}}
      },
      "highlight": ["cE", "c60", "c120", "cW"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "The three new lines cut the first circle at six points. Join them to make a hexagon standing on one corner. This hexagon is the tile that will repeat.",
      "create": {
        "D30": {"point": {"meet": ["c", "m30"], "pick": {"angle": 30}}},
        "D90": {"point": {"meet": ["c", "m90"], "pick": {"angle": 90}}},
        "D150": {"point": {"meet": ["c", "m150"], "pick": {"angle": 150}}},
        "D210": {"point": {"meet": ["c", "m30"], "pick": {"angle": 210}}},
        "D270": {"point": {"meet": ["c", "m90"], "pick": {"angle": 270}}},
        "D330": {"point": {"meet": ["c", "m150"], "pick": {"angle": 330}}},
        "hex": {"polygon": ["D30", "D90", "D150", "D210", "D270", "D330"]}
      },
      "highlight": ["m30", "m90", "m150"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Join every other corner of the hexagon to draw two triangles, one pointing up and one pointing down. Together they make a six-pointed star.",
      "create": {
        "up": {"polygon": ["D90", "D210", "D330"]},
        "down": {"polygon": ["D30", "D150", "D270"]},
        "K": {"points": {"meet": ["up", "down"], "pick": {"all": "byAngle"}}}
      },
      "highlight": ["D30", "D90", "D150", "D210", "D270", "D330"],
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Find the six points where the three slanted and vertical lines cross the sides of the star, halfway along each side. They sit on a smaller circle, half the size of the first.",
      "create": {
        "Q30": {"point": {"meet": ["m30", "up"], "pick": {"angle": 30}}},
        "Q90": {"point": {"meet": ["m90", "down"], "pick": {"angle": 90}}},
        "Q150": {"point": {"meet": ["m150", "up"], "pick": {"angle": 150}}},
        "Q210": {"point": {"meet": ["m30", "down"], "pick": {"angle": 210}}},
        "Q270": {"point": {"meet": ["m90", "up"], "pick": {"angle": 270}}},
        "Q330": {"point": {"meet": ["m150", "down"], "pick": {"angle": 330}}}
      },
      "highlight": ["m30", "m90", "m150", "up", "down"],
      "animate": "fade"
    },
    {
      "id": 8,
      "text": "Rule a line through every other one of these points, six lines in all. They draw a smaller star, and each line runs on past the star's points until it meets the hexagon on both sides.",
      "create": {
        "s1": {"line": {"through": ["Q30", "Q150"]}},
        "s2": {"line": {"through": ["Q150", "Q270"]}},
        "s3": {"line": {"through": ["Q270", "Q30"]}},
        "s4": {"line": {"through": ["Q90", "Q210"]}},
        "s5": {"line": {"through": ["Q210", "Q330"]}},
        "s6": {"line": {"through": ["Q330", "Q90"]}},
        "e1a": {"point": {"meet": ["s1", "hex"], "pick": {"nearest": "Q30"}}},
        "e1b": {"point": {"meet": ["s1", "hex"], "pick": {"nearest": "Q150"}}},
        "e2a": {"point": {"meet": ["s2", "hex"], "pick": {"nearest": "Q150"}}},
        "e2b": {"point": {"meet": ["s2", "hex"], "pick": {"nearest": "Q270"}}},
        "e3a": {"point": {"meet": ["s3", "hex"], "pick": {"nearest": "Q270"}}},
        "e3b": {"point": {"meet": ["s3", "hex"], "pick": {"nearest": "Q30"}}},
        "e4a": {"point": {"meet": ["s4", "hex"], "pick": {"nearest": "Q90"}}},
        "e4b": {"point": {"meet": ["s4", "hex"], "pick": {"nearest": "Q210"}}},
        "e5a": {"point": {"meet": ["s5", "hex"], "pick": {"nearest": "Q210"}}},
        "e5b": {"point": {"meet": ["s5", "hex"], "pick": {"nearest": "Q330"}}},
        "e6a": {"point": {"meet": ["s6", "hex"], "pick": {"nearest": "Q330"}}},
        "e6b": {"point": {"meet": ["s6", "hex"], "pick": {"nearest": "Q90"}}},
        "J0": {"point": {"meet": ["s3", "s6"]}},
        "J60": {"point": {"meet": ["s1", "s6"]}},
        "J120": {"point": {"meet": ["s1", "s4"]}},
        "J180": {"point": {"meet": ["s4", "s2"]}},
        "J240": {"point": {"meet": ["s5", "s2"]}},
        "J300": {"point": {"meet": ["s5", "s3"]}}
      },
      "highlight": ["Q30", "Q90", "Q150", "Q210", "Q270", "Q330", "hex"],
      "animate": "ruler"
    }
