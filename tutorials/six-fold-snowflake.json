{
  "format": 0,
  "id": "six-fold-snowflake",
  "title": "Six-fold snowflake",
  "fold": 6,
  "style": "Mamluk",
  "level": "beginner",
  "construction": {
    "basis": "instructions",
    "fidelity": "close",
    "note": "The motif and inking follow Mamoot’s numbered Snowflake instructions. The original work log records step comparisons and a corrected small star that matches the source’s lines.",
    "changes": "The six-fold foundation is expanded into several app steps. The repeat uses the source’s hexagon. The current written sequence was checked against the saved page; the earlier image overlay has not been rerun.",
    "reviewed": "2026-10-21"
  },
  "credits": [
    {
      "source": "Islamic Geometry: A Six-Fold “Snowflake”",
      "creator": "Mamoot (mamootdiy.com)",
      "url": "https://mamootdiy.com/2022/04/06/islamic-geometry-a-six-fold-snowflake/",
      "note": "The order of the construction (mirror lines through the large petals, dynamic hexagon, star, half-way points, second star carried to the hexagon) and the choice of lines to ink follow this tutorial.",
      "steps": [4, 5, 6, 7, 8]
    }
  ],
  "given": {
    "O": "The centre of the star.",
    "A": "Any point to the right of O. The distance OA is the radius of the first circle, and the unit for every length."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size until the end.",
      "create": {
        "h": { "line": { "through": ["O", "A"] } },
        "c": { "circle": { "centre": "O", "through": "A" } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a circle with centre A through O. Draw a circle with centre D through O, where the line crosses the first circle on the left. The two new circles touch at O.",
      "create": {
        "D": { "point": { "meet": ["c", "h"], "pick": { "angle": 180 } } },
        "cE": { "circle": { "centre": "A", "radiusOf": "c" } },
        "cW": { "circle": { "centre": "D", "radiusOf": "c" } }
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a circle with centre B through O. Draw a circle with centre C through O. Draw a circle with centre E through O. Draw a circle with centre F through O. B, C, E and F are where the two new circles cross the first one. Six circles now ring the first circle.",
      "create": {
        "B": { "point": { "meet": ["c", "cE"], "pick": { "angle": 60 } } },
        "F": { "point": { "meet": ["c", "cE"], "pick": { "angle": 300 } } },
        "C": { "point": { "meet": ["c", "cW"], "pick": { "angle": 120 } } },
        "E": { "point": { "meet": ["c", "cW"], "pick": { "angle": 240 } } },
        "c60": { "circle": { "centre": "B", "radiusOf": "c" } },
        "c120": { "circle": { "centre": "C", "radiusOf": "c" } },
        "c240": { "circle": { "centre": "E", "radiusOf": "c" } },
        "c300": { "circle": { "centre": "F", "radiusOf": "c" } }
      },
      "highlight": ["cE", "cW"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a straight line through O and P1, O and P2, and O and P3. P1, P2 and P3 are the tips of the large petals outside the first circle.",
      "create": {
        "P1": { "point": { "meet": ["cE", "c60"], "pick": { "farthest": "O" } } },
        "P2": { "point": { "meet": ["c60", "c120"], "pick": { "farthest": "O" } } },
        "P3": { "point": { "meet": ["c120", "cW"], "pick": { "farthest": "O" } } },
        "m30": { "line": { "through": ["O", "P1"] } },
        "m90": { "line": { "through": ["O", "P2"] } },
        "m150": { "line": { "through": ["O", "P3"] } }
      },
      "highlight": ["cE", "c60", "c120", "cW"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Join H1, H2, H3, H4, H5 and H6 with straight lines. H1 to H6 are where the three lines cross the first circle. This hexagon is the tile that repeats.",
      "create": {
        "H1": { "point": { "meet": ["c", "m30"], "pick": { "angle": 30 } } },
        "H2": { "point": { "meet": ["c", "m90"], "pick": { "angle": 90 } } },
        "H3": { "point": { "meet": ["c", "m150"], "pick": { "angle": 150 } } },
        "H4": { "point": { "meet": ["c", "m30"], "pick": { "angle": 210 } } },
        "H5": { "point": { "meet": ["c", "m90"], "pick": { "angle": 270 } } },
        "H6": { "point": { "meet": ["c", "m150"], "pick": { "angle": 330 } } },
        "hex": { "polygon": ["H1", "H2", "H3", "H4", "H5", "H6"] }
      },
      "highlight": ["m30", "m90", "m150"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Join H2, H4 and H6 with straight lines. Join H1, H3 and H5 with straight lines. The two triangles make a six-pointed star. They cross at K1 to K6.",
      "create": {
        "up": { "polygon": ["H2", "H4", "H6"] },
        "down": { "polygon": ["H1", "H3", "H5"] },
        "K1": { "point": { "meet": ["up", "down"], "pick": { "angle": 0 } } },
        "K2": { "point": { "meet": ["up", "down"], "pick": { "angle": 60 } } },
        "K3": { "point": { "meet": ["up", "down"], "pick": { "angle": 120 } } },
        "K4": { "point": { "meet": ["up", "down"], "pick": { "angle": 180 } } },
        "K5": { "point": { "meet": ["up", "down"], "pick": { "angle": 240 } } },
        "K6": { "point": { "meet": ["up", "down"], "pick": { "angle": 300 } } }
      },
      "highlight": ["H1", "H2", "H3", "H4", "H5", "H6"],
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Mark S1 to S6, where the lines through O cross the sides of the star. They sit halfway along each side.",
      "create": {
        "S1": { "point": { "meet": ["m30", "up"], "pick": { "angle": 30 } } },
        "S2": { "point": { "meet": ["m90", "down"], "pick": { "angle": 90 } } },
        "S3": { "point": { "meet": ["m150", "up"], "pick": { "angle": 150 } } },
        "S4": { "point": { "meet": ["m30", "down"], "pick": { "angle": 210 } } },
        "S5": { "point": { "meet": ["m90", "up"], "pick": { "angle": 270 } } },
        "S6": { "point": { "meet": ["m150", "down"], "pick": { "angle": 330 } } }
      },
      "highlight": ["m30", "m90", "m150", "up", "down"],
      "animate": "fade"
    },
    {
      "id": 8,
      "text": "Draw a straight line through S1 and S3, S3 and S5, S5 and S1, and S2 and S4. Draw a straight line through S4 and S6, and S6 and S2. These lines make a small star. They run on to the hexagon.",
      "create": {
        "s1": { "line": { "through": ["S1", "S3"] } },
        "s2": { "line": { "through": ["S3", "S5"] } },
        "s3": { "line": { "through": ["S5", "S1"] } },
        "s4": { "line": { "through": ["S2", "S4"] } },
        "s5": { "line": { "through": ["S4", "S6"] } },
        "s6": { "line": { "through": ["S6", "S2"] } },
        "R1": { "point": { "meet": ["s1", "hex"], "pick": { "nearest": "S1" } } },
        "R6": { "point": { "meet": ["s1", "hex"], "pick": { "nearest": "S3" } } },
        "R5": { "point": { "meet": ["s2", "hex"], "pick": { "nearest": "S3" } } },
        "R10": { "point": { "meet": ["s2", "hex"], "pick": { "nearest": "S5" } } },
        "R9": { "point": { "meet": ["s3", "hex"], "pick": { "nearest": "S5" } } },
        "R2": { "point": { "meet": ["s3", "hex"], "pick": { "nearest": "S1" } } },
        "R3": { "point": { "meet": ["s4", "hex"], "pick": { "nearest": "S2" } } },
        "R8": { "point": { "meet": ["s4", "hex"], "pick": { "nearest": "S4" } } },
        "R7": { "point": { "meet": ["s5", "hex"], "pick": { "nearest": "S4" } } },
        "R12": { "point": { "meet": ["s5", "hex"], "pick": { "nearest": "S6" } } },
        "R11": { "point": { "meet": ["s6", "hex"], "pick": { "nearest": "S6" } } },
        "R4": { "point": { "meet": ["s6", "hex"], "pick": { "nearest": "S2" } } },
        "J1": { "point": { "meet": ["s3", "s6"] } },
        "J2": { "point": { "meet": ["s1", "s6"] } },
        "J3": { "point": { "meet": ["s1", "s4"] } },
        "J4": { "point": { "meet": ["s4", "s2"] } },
        "J5": { "point": { "meet": ["s5", "s2"] } },
        "J6": { "point": { "meet": ["s5", "s3"] } }
      },
      "highlight": ["S1", "S2", "S3", "S4", "S5", "S6", "hex"],
      "animate": "ruler"
    }
  ],
  "ink": {
    "text": "Ink the large star, then the small star. Then ink the lines from the points of the small star out to the hexagon.",
    "paths": [
      {
        "closed": true,
        "through": [
          "K1",
          "H1",
          "K2",
          "H2",
          "K3",
          "H3",
          "K4",
          "H4",
          "K5",
          "H5",
          "K6",
          "H6"
        ]
      },
      {
        "closed": true,
        "through": [
          "J1",
          "S1",
          "J2",
          "S2",
          "J3",
          "S3",
          "J4",
          "S4",
          "J5",
          "S5",
          "J6",
          "S6"
        ]
      },
      { "through": ["S1", "R1"] },
      { "through": ["S1", "R2"] },
      { "through": ["S2", "R3"] },
      { "through": ["S2", "R4"] },
      { "through": ["S3", "R5"] },
