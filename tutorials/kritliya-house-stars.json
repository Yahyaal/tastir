{
  "format": 0,
  "id": "kritliya-house-stars",
  "title": "Interlaced stars of the Kritliya House (Cairo)",
  "short": "Kritliya House stars",
  "subtitle": "Bayt al-Kritliya, Cairo",
  "fold": 4,
  "star": 8,
  "chiral": true,
  "style": "Ottoman",
  "level": "intermediate",
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Brian Wichmann’s KHC drawing, the centre lines of its bands snapped to exact values. We devised the construction: the star at O, then four lines set by two small circles, all turned round O. The drawing gives no steps.",
    "changes": "The compass steps, their order and the named points are ours. The comparison with the drawing checks the finished lines, not how the design was first laid out. Wichmann draws the lines as interlaced bands; the tutorial draws their centre lines, turned by 45° so that the stars next to O sit at the corners of the cell. No photo of the house was checked.",
    "reviewed": "2026-10-25"
  },
  "credits": [
    {
      "source": "Tiling Search, data186/KHC: Kritiya House, Cairo",
      "creator": "Brian Wichmann",
      "url": "https://tilingsearch.mit.edu/HTML/data186/KHC.html",
      "kind": "drawing",
      "note": "The design was read from his drawing of a panel in the Kritliya House (Gayer-Anderson Museum), Cairo, by the fountain in the salamlik, after an Archnet photo; he also cites a Thesaurus Islamicus photo from the house of Jamal al-Din al-Dhahabi, Cairo. The construction is ours."
    }
  ],
  "given": {
    "O": "The centre of an eight-pointed star.",
    "A": "The centre of a small rhombus, halfway from O to the next star of the same hand."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and D. These lines make the square cell, with corners K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "B", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "D", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K1"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "The circle crosses the line from O to K1 at F. Draw the lines through O that halve the angles AOF and FOC.",
      "create": {
        "F": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "b1": {"line": {"through": "O", "bisects": ["A", "O", "F"]}},
        "b2": {"line": {"through": "O", "bisects": ["F", "O", "C"]}}
      },
      "highlight": ["A", "F", "C"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw the line through C at 90° to the line that halves the angle AOF. It crosses that line at T. Draw the line through A at 90° to the line that halves the angle FOC. It crosses that line at U.",
      "create": {
        "ct": {"line": {"through": "C", "perpendicularTo": "b1"}},
        "T": {"point": {"meet": ["ct", "b1"]}},
        "at": {"line": {"through": "A", "perpendicularTo": "b2"}},
        "U": {"point": {"meet": ["at", "b2"]}}
      },
      "highlight": ["b1", "b2"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw a line through T parallel to line OU. Draw a line through U parallel to line OT.",
      "create": {
        "s1": {"line": {"through": "T", "parallelTo": "b2"}},
        "s2": {"line": {"through": "U", "parallelTo": "b1"}}
      },
      "highlight": ["T", "U"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Turn the lines through T and U round O by 90°, three times. They make the star at O.",
      "create": {"cp1": {"repeat": {"of": ["s1", "s2"], "by": "rot4"}}},
      "highlight": ["s1", "s2"],
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Draw a vertical line through F. It crosses the horizontal line at G. Draw a circle with centre A through G. Draw a circle with centre C and the same radius.",
      "create": {
        "fv": {"line": {"through": "F", "parallelTo": "v"}},
        "G": {"point": {"meet": ["fv", "h"]}},
        "ca": {"circle": {"centre": "A", "through": "G"}},
        "cc": {"circle": {"centre": "C", "radiusOf": "ca"}}
      },
      "highlight": ["F", "A", "C"],
      "animate": "compass",
      "textWithoutHelpers": "Draw a circle with centre A through G, the point on the horizontal line straight below F. Draw a circle with centre C and the same radius."
    },
    {
      "id": 8,
      "text": "The circle with centre A crosses the vertical line through A at P, above A, and at E, below A. Draw lines through P and E parallel to line OU. The line through P crosses the circle again at Q.",
      "create": {
        "P": {"point": {"meet": ["ca", "gx"], "pick": {"angle": 16.325}}},
        "E": {"point": {"meet": ["ca", "gx"], "pick": {"angle": 343.675}}},
        "pl": {"line": {"through": "P", "parallelTo": "b2"}},
        "el": {"line": {"through": "E", "parallelTo": "b2"}},
        "Q": {"point": {"meet": ["ca", "pl"], "pick": {"angle": 345.361}}}
      },
      "highlight": ["ca", "gx"],
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "Draw a line through Q parallel to line OT. The circle with centre C crosses the horizontal line through C at M, left of C. Draw a line through M parallel to line OT.",
      "create": {
        "ql": {"line": {"through": "Q", "parallelTo": "b1"}},
        "M": {"point": {"meet": ["cc", "gy"], "pick": {"angle": 106.325}}},
        "ml": {"line": {"through": "M", "parallelTo": "b1"}}
      },
      "highlight": ["Q", "cc"],
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "Turn the lines through P, E, Q and M round O by 90°, three times.",
      "create": {"cp2": {"repeat": {"of": ["pl", "el", "ql", "ml"], "by": "rot4"}}},
      "highlight": ["pl", "el", "ql", "ml"],
      "animate": "ruler"
    },
    {
      "id": 11,
      "text": "The line through P, turned round O by 180°, crosses the horizontal line through C at N. Draw a circle with centre C through N. It crosses the horizontal line through C again at W. Draw a line through W parallel to line OU.",
      "create": {
        "N": {"point": {"meet": ["pl@2", "gy"]}},
        "cn": {"circle": {"centre": "C", "through": "N"}},
        "W": {"point": {"meet": ["cn", "gy"], "pick": {"angle": 65.087}}},
        "wl": {"line": {"through": "W", "parallelTo": "b2"}}
      },
      "highlight": ["pl@2", "gy"],
      "animate": "compass"
    },
    {
      "id": 12,
      "text": "Turn the line through W round O by 90°, three times.",
      "create": {"cp3": {"repeat": {"of": ["wl"], "by": "rot4"}}},
      "highlight": ["wl"],
      "animate": "ruler"
    },
    {
      "id": 13,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
