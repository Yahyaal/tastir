  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Brian Wichmann’s P060 drawing, the centre lines of its bands snapped to exact values. We devised the construction: the star at O is two squares on the circle through G, the same star sits at each corner, and the diamond ABCD with lines at the same distance from A makes the rest. The drawing gives no steps.",
    "changes": "The compass steps, their order and the named points are ours. The comparison with the drawing checks the finished lines, not how the design was first laid out. Wichmann draws the lines as interlaced bands; the tutorial draws their centre lines. No photo of the madrasa was checked.",
    "reviewed": "2026-10-25"
  },
  "credits": [
    {
      "source": "Tiling Search, data11/P060: Bourgoin, Plate 60",
      "creator": "Brian Wichmann",
      "url": "https://tilingsearch.mit.edu/HTML/data11/P060.html",
      "kind": "drawing",
      "note": "The design was read from his drawing of Jules Bourgoin’s plate 60. He lists the same design at the Bou Inania madrasa, Fez (André Paccard, Traditional Islamic Craft in Moroccan Architecture, volume 1 page 130 and volume 2 page 430) and on a fifteenth-century Toledo tile in the Victoria and Albert Museum (308:100-1866), and in the books of El-Said, Critchlow and Abas. The construction is ours."
    }
  ],
  "given": {
    "O": "The centre of an eight-pointed star.",
    "A": "Halfway from O to the side of the square tile on the horizontal line."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and D. These lines make the square cell, with corners K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "B", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "D", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K1"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler",
      "textWithoutHelpers": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through A. Draw a horizontal line through C. They cross at K1, a corner of the cell. Draw a straight line through O and K1."
    },
    {
      "id": 3,
      "text": "Join A, C, B and D with straight lines. Line AC crosses the line from O to K1 at E.",
      "create": {
        "ac": {"line": {"through": ["A", "C"]}},
        "acp": {"repeat": {"of": ["ac"], "by": "rot4"}},
        "E": {"point": {"meet": ["ac", "d45"]}}
      },
      "highlight": ["E"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw a vertical line through E. It crosses the horizontal line at F. Draw a line through F parallel to line AC. It crosses the line from O to K1 at G.",
      "create": {
        "ev": {"line": {"through": "E", "parallelTo": "v"}},
        "F": {"point": {"meet": ["ev", "h"]}},
        "fd": {"line": {"through": "F", "parallelTo": "ac"}},
        "G": {"point": {"meet": ["fd", "d45"]}}
      },
      "highlight": ["F", "G"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw a vertical line through G. Turn it round O by 90°, three times. The four lines make the first square of the star at O.",
      "create": {
        "gv": {"line": {"through": "G", "parallelTo": "v"}},
        "gvp": {"repeat": {"of": ["gv"], "by": "rot4"}}
      },
      "highlight": ["G"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw a circle with centre O through G. It crosses the horizontal line at S. Draw a line through S parallel to line AC. Turn it round O by 90°, three times. The four lines make the second square of the star.",
      "create": {
        "cq": {"circle": {"centre": "O", "through": "G"}},
        "S": {"point": {"meet": ["cq", "h"], "pick": {"angle": 0.0}}},
        "sd": {"line": {"through": "S", "parallelTo": "ac"}},
        "sdp": {"repeat": {"of": ["sd"], "by": "rot4"}}
      },
      "highlight": ["G", "S"],
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "The horizontal line through G crosses line AC at T. Draw a vertical line through T. Turn it round O by 90°, three times. The four lines make the squares of the corner stars.",
      "create": {
        "T": {"point": {"meet": ["gv@1", "ac"]}},
        "tv": {"line": {"through": "T", "parallelTo": "v"}},
        "tvp": {"repeat": {"of": ["tv"], "by": "rot4"}}
      },
      "highlight": ["T"],
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Draw a circle with centre K1 and the same radius as the circle through G. It crosses the vertical line through A at U. Draw a line through U parallel to line AC. Turn it round O by 90°, three times.",
      "create": {
        "ck": {"circle": {"centre": "K1", "radiusOf": "cq"}},
        "U": {"point": {"meet": ["ck", "gx"], "pick": {"angle": 32.881}}},
        "ud": {"line": {"through": "U", "parallelTo": "ac"}},
        "udp": {"repeat": {"of": ["ud"], "by": "rot4"}}
      },
      "highlight": ["K1", "U"],
      "animate": "compass"
    },
    {
      "id": 9,
      "text": "Draw a circle with centre A and the same radius. It crosses the horizontal line at V. Draw a line through V parallel to line AC. Turn it round O by 90°, three times.",
      "create": {
        "ca": {"circle": {"centre": "A", "radiusOf": "cq"}},
        "V": {"point": {"meet": ["ca", "h"], "pick": {"nearest": "O"}}},
        "vd": {"line": {"through": "V", "parallelTo": "ac"}},
        "vdp": {"repeat": {"of": ["vd"], "by": "rot4"}}
      },
      "highlight": ["A", "V"],
      "animate": "compass"
    },
    {
      "id": 10,
      "text": "The horizontal line through G crosses the line through S at W. Draw a vertical line through W. Turn it round O by 90°, three times.",
      "create": {
        "W": {"point": {"meet": ["gv@1", "sd"]}},
        "wv": {"line": {"through": "W", "parallelTo": "v"}},
        "wvp": {"repeat": {"of": ["wv"], "by": "rot4"}}
      },
      "highlight": ["W"],
      "animate": "ruler"
    },
    {
      "id": 11,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
