  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at C, at the top. The horizontal line crosses the circle at B, on the left. Draw a vertical line through A. Draw a horizontal line through C. They cross at E. Draw a straight line through O and E. Draw a line through O at 90° to line OE.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "ax": {"line": {"through": "A", "perpendicularTo": "h"}},
        "cy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "E": {"point": {"meet": ["ax", "cy"]}},
        "d45": {"line": {"through": ["O", "E"]}},
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}}
      },
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw the line through O that halves the angle AOE. Draw the line through O that halves the angle EOC. Draw a line through O at 90° to each of them. The circle crosses the four new lines at S1 to S8.",
      "create": {
        "t1": {"line": {"through": "O", "bisects": ["A", "O", "E"]}},
        "t2": {"line": {"through": "O", "bisects": ["E", "O", "C"]}},
        "t3": {"line": {"through": "O", "perpendicularTo": "t1"}},
        "t4": {"line": {"through": "O", "perpendicularTo": "t2"}},
        "S1": {"point": {"meet": ["c", "t1"], "pick": {"angle": 22.5}}},
        "S2": {"point": {"meet": ["c", "t2"], "pick": {"angle": 67.5}}},
        "S3": {"point": {"meet": ["c", "t3"], "pick": {"angle": 112.5}}},
        "S4": {"point": {"meet": ["c", "t4"], "pick": {"angle": 157.5}}},
        "S5": {"point": {"meet": ["c", "t1"], "pick": {"angle": 202.5}}},
        "S6": {"point": {"meet": ["c", "t2"], "pick": {"angle": 247.5}}},
        "S7": {"point": {"meet": ["c", "t3"], "pick": {"angle": 292.5}}},
        "S8": {"point": {"meet": ["c", "t4"], "pick": {"angle": 337.5}}}
      },
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw the turned star at O as two squares.",
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S3, S3 and S5, S5 and S7, and S7 and S1. Draw each line long, beyond the circle.",
          "create": {
            "q01": {"line": {"through": ["S1", "S3"]}},
            "q02": {"line": {"through": ["S3", "S5"]}},
            "q03": {"line": {"through": ["S5", "S7"]}},
            "q04": {"line": {"through": ["S7", "S1"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S4, S4 and S6, S6 and S8, and S8 and S2. Draw each line long, beyond the circle.",
          "create": {
            "q11": {"line": {"through": ["S2", "S4"]}},
            "q12": {"line": {"through": ["S4", "S6"]}},
            "q13": {"line": {"through": ["S6", "S8"]}},
            "q14": {"line": {"through": ["S8", "S2"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 5,
      "text": "Draw a circle with centre S1 and radius AB. It crosses the line through S1 and S3 at N, beyond S1. Draw a line through N at 90° to that line. Turn it round O by 45°, seven times.",
      "create": {
        "cn": {"circle": {"centre": "S1", "radiusFrom": ["A", "B"]}},
        "N": {"point": {"meet": ["cn", "q01"], "pick": {"angle": 352.139}}},
        "w": {"line": {"through": "N", "perpendicularTo": "q01"}},
        "wr": {"repeat": {"of": ["w"], "by": "rot8"}}
      },
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "The line from O to S2 crosses the vertical line through A at P. Draw a horizontal line through P. The line from O to S1 crosses it at Q. Draw a vertical line through Q. Turn it round O by 90°, three times. The four lines make the square tile, with corners K1, K2, K3 and K4.",
      "create": {
        "P": {"point": {"meet": ["t2", "ax"]}},
        "hp": {"line": {"through": "P", "perpendicularTo": "v"}},
        "Q": {"point": {"meet": ["t1", "hp"]}},
        "gx": {"line": {"through": "Q", "perpendicularTo": "h"}},
        "gr": {"repeat": {"of": ["gx"], "by": "rot4"}},
        "K1": {"point": {"meet": ["gx", "gx@1"]}},
        "K2": {"point": {"meet": ["gx@1", "gx@2"]}},
        "K3": {"point": {"meet": ["gx@2", "gx@3"]}},
        "K4": {"point": {"meet": ["gx@3", "gx"]}}
      },
      "animate": "ruler",
      "textWithoutHelpers": "The line from O to S2 crosses the vertical line through A at P. Q is on the line from O to S1, level with P. Draw a vertical line through Q. Turn it round O by 90°, three times. The four lines make the square tile, with corners K1, K2, K3 and K4."
    },
    {
      "id": 7,
      "text": "Draw a circle with centre K1 and radius OA. It crosses line OE at X, and the top side of the tile at Y. Draw a vertical line through X. Turn it round O by 45°, seven times. Draw a line through Y at 90° to line OE. Turn it round O by 90°, three times.",
      "create": {
        "ck": {"circle": {"centre": "K1", "radiusOf": "c"}},
        "X": {"point": {"meet": ["ck", "d45"], "pick": {"nearest": "O"}}},
