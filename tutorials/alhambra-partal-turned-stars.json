      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "The horizontal line through X crosses the line through M at Z. Draw a line through Z parallel to line OE. Turn it round O by 45°, seven times.",
      "create": {
        "Z": {"point": {"meet": ["x3@2", "m2"]}},
        "z1": {"line": {"through": "Z", "parallelTo": "d45"}},
        "z1r": {"repeat": {"of": ["z1"], "by": "rot8"}}
      },
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "The vertical line through G crosses the horizontal line through X at W. Draw a line through W at 90° to line OE. Turn it round O by 90°, three times.",
      "create": {
        "W": {"point": {"meet": ["m2@7", "x3@2"]}},
        "w5": {"line": {"through": "W", "perpendicularTo": "d45"}},
        "w5r": {"repeat": {"of": ["w5"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 11,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
