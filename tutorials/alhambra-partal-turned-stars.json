      "animate": "compass"
    },
    {
      "id": 8,
      "text": "The horizontal line through O crosses the right side of the tile at M. Draw a line through M at 90° to line OE. Turn it round O by 45°, seven times. A copy crosses the horizontal line through O at G.",
      "create": {
        "M": {"point": {"meet": ["h", "gx"]}},
        "m2": {"line": {"through": "M", "perpendicularTo": "d45"}},
        "m2r": {"repeat": {"of": ["m2"], "by": "rot8"}},
        "G": {"point": {"meet": ["h", "m2@7"]}}
