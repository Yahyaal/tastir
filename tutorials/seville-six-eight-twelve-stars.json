  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size for the next steps.",
      "create": {"h": {"line": {"through": ["O", "A"]}}, "c": {"circle": {"centre": "O", "through": "A"}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a circle with centre A through O. Draw a circle with centre G through O, where the line crosses the first circle on the left.",
      "create": {
        "G": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "cE": {"circle": {"centre": "A", "radiusOf": "c"}},
        "cW": {"circle": {"centre": "G", "radiusOf": "c"}}
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a vertical line through O. It crosses the first circle at D and K. Draw a circle with centre D through O. Draw a circle with centre K through O.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "K": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "cN": {"circle": {"centre": "D", "radiusOf": "c"}},
        "cS": {"circle": {"centre": "K", "radiusOf": "c"}}
      },
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a straight line through B and H, C and J, E and L, and F and M. B, C, E, F, H, J, L and M are where the four new circles cross the first circle. The first circle is now cut into twelve.",
      "create": {
        "C": {"point": {"meet": ["c", "cE"], "pick": {"angle": 60.0}}},
        "L": {"point": {"meet": ["c", "cE"], "pick": {"angle": 300.0}}},
        "E": {"point": {"meet": ["c", "cW"], "pick": {"angle": 120.0}}},
        "J": {"point": {"meet": ["c", "cW"], "pick": {"angle": 240.0}}},
        "B": {"point": {"meet": ["c", "cN"], "pick": {"angle": 30.0}}},
        "F": {"point": {"meet": ["c", "cN"], "pick": {"angle": 150.0}}},
        "H": {"point": {"meet": ["c", "cS"], "pick": {"angle": 210.0}}},
        "M": {"point": {"meet": ["c", "cS"], "pick": {"angle": 330.0}}},
        "r30": {"line": {"through": ["B", "H"]}},
        "r60": {"line": {"through": ["C", "J"]}},
        "r120": {"line": {"through": ["E", "L"]}},
        "r150": {"line": {"through": ["F", "M"]}}
      },
      "highlight": ["cE", "cW", "cN", "cS"],
      "animate": "ruler",
      "textWithoutHelpers": "The four circles cross the first circle at B, C, E, F, H, J, L and M. Draw a straight line through B and H. Draw a straight line through F and M."
    },
    {
      "id": 5,
      "text": "Draw the lines through O that halve angles AOB, BOC and COD. Draw a line through O at 90° to each new line.",
      "create": {
        "r15": {"line": {"through": "O", "bisects": ["A", "O", "B"]}},
        "r45": {"line": {"through": "O", "bisects": ["B", "O", "C"]}},
        "r75": {"line": {"through": "O", "bisects": ["C", "O", "D"]}},
        "r105": {"line": {"through": "O", "perpendicularTo": "r15"}},
        "r135": {"line": {"through": "O", "perpendicularTo": "r45"}},
        "r165": {"line": {"through": "O", "perpendicularTo": "r75"}}
      },
      "animate": "ruler",
      "textWithoutHelpers": "Draw the line through O that halves angle BOC. Draw a line through O at 90° to it."
    },
    {
      "id": 6,
      "text": "Draw the four triangles that make the twelve-pointed star.",
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through A and E, E and J, and J and A.",
          "create": {
            "st0": {"line": {"through": ["A", "E"]}},
            "st4": {"line": {"through": ["E", "J"]}},
            "st8": {"line": {"through": ["J", "A"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through B and F, F and K, and K and B.",
          "create": {
            "st1": {"line": {"through": ["B", "F"]}},
            "st5": {"line": {"through": ["F", "K"]}},
            "st9": {"line": {"through": ["K", "B"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through C and G, G and L, and L and C.",
          "create": {
            "st2": {"line": {"through": ["C", "G"]}},
            "st6": {"line": {"through": ["G", "L"]}},
            "st10": {"line": {"through": ["L", "C"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through D and H, H and M, and M and D.",
          "create": {
            "st3": {"line": {"through": ["D", "H"]}},
            "st7": {"line": {"through": ["H", "M"]}},
            "st11": {"line": {"through": ["M", "D"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 7,
      "text": "Draw a circle with centre A through O. It crosses the horizontal line at N1, right of A. Draw a circle with centre N1 and opening OA. It crosses that line at N2, right of N1. Draw a circle with centre O and opening AE. It crosses that line at N3, right of A.",
      "create": {
        "two": {"circle": {"centre": "A", "through": "O"}},
        "N1": {"point": {"meet": ["two", "h"], "pick": {"farthest": "O"}}},
        "three": {"circle": {"centre": "N1", "radiusFrom": ["O", "A"]}},
        "N2": {"point": {"meet": ["three", "h"], "pick": {"farthest": "O"}}},
        "root3": {"circle": {"centre": "O", "radiusFrom": ["A", "E"]}},
        "N3": {"point": {"meet": ["root3", "h"], "pick": {"angle": 0.0}}}
      },
      "animate": "compass"
    },
    {
      "id": 8,
      "text": "Draw a circle with centre N2 and opening from O to N3. It crosses the horizontal line at N4, towards O. Draw a line through N4 parallel to the line at 135° from OA. It crosses the line at 45° from OA at P1. Draw a vertical line through P1. It crosses the horizontal line at N5.",
      "create": {
        "difference": {"circle": {"centre": "N2", "radiusFrom": ["O", "N3"]}},
        "N4": {"point": {"meet": ["difference", "h"], "pick": {"nearest": "O"}}},
        "halfDiagonal": {"line": {"through": "N4", "parallelTo": "r135"}},
        "P1": {"point": {"meet": ["halfDiagonal", "r45"]}},
        "halfProjection": {"line": {"through": "P1", "parallelTo": "v"}},
        "N5": {"point": {"meet": ["halfProjection", "h"]}}
      },
      "animate": "compass"
    },
    {
      "id": 9,
      "text": "Draw a line through N5 parallel to the line at 135° from OA. It crosses the line at 45° from OA at P2. Draw a vertical line through P2. It crosses the horizontal line at N6.",
      "create": {
        "quarterDiagonal": {"line": {"through": "N5", "parallelTo": "r135"}},
        "P2": {"point": {"meet": ["quarterDiagonal", "r45"]}},
        "quarterProjection": {"line": {"through": "P2", "parallelTo": "v"}},
        "N6": {"point": {"meet": ["quarterProjection", "h"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "Draw a circle with centre N2 and opening from O to N6. It crosses the horizontal line at N7, right of N2.",
      "create": {
        "apothem": {"circle": {"centre": "N2", "radiusFrom": ["O", "N6"]}},
        "N7": {"point": {"meet": ["apothem", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 11,
      "text": "Draw a vertical line through N7. Turn it round O by 60°, five times. The six lines frame the tile, with corners T1 to T6.",
      "create": {
        "frame": {"line": {"through": "N7", "parallelTo": "v"}},
        "frames": {"repeat": {"of": ["frame"], "by": "rot6"}},
        "T1": {"point": {"meet": ["frame", "frame@1"]}},
        "T2": {"point": {"meet": ["frame@1", "frame@2"]}},
        "T3": {"point": {"meet": ["frame@2", "frame@3"]}},
