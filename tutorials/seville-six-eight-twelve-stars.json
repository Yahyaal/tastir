        "T5": {"point": {"meet": ["frame@4", "frame@5"]}},
        "T6": {"point": {"meet": ["frame@5", "frame"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 12,
      "text": "Draw a vertical line through C. It crosses the horizontal line at N8. Draw a circle with centre N7 and opening from O to N8. It crosses that line at N9, towards O. Draw a vertical line through N9. Turn it round O by 60°, five times.",
      "create": {
        "cv": {"line": {"through": "C", "parallelTo": "v"}},
        "N8": {"point": {"meet": ["cv", "h"]}},
        "axial": {"circle": {"centre": "N7", "radiusFrom": ["O", "N8"]}},
        "N9": {"point": {"meet": ["axial", "h"], "pick": {"nearest": "O"}}},
        "xv": {"line": {"through": "N9", "parallelTo": "v"}},
        "xs": {"repeat": {"of": ["xv"], "by": "rot6"}}
      },
      "animate": "compass"
    },
    {
      "id": 13,
      "text": "Draw a circle with centre O through N7. It crosses the line at 45° from OA at P3, above O. Draw a vertical line through P3. It crosses the horizontal line at N10. Draw a circle with centre N10 and opening from O to N8. It crosses that line at N11, towards O.",
      "create": {
        "frameCircle": {"circle": {"centre": "O", "through": "N7"}},
        "P3": {"point": {"meet": ["frameCircle", "r45"], "pick": {"angle": 45.0}}},
        "diagonalProjection": {"line": {"through": "P3", "parallelTo": "v"}},
        "N10": {"point": {"meet": ["diagonalProjection", "h"]}},
        "oblique": {"circle": {"centre": "N10", "radiusFrom": ["O", "N8"]}},
        "N11": {"point": {"meet": ["oblique", "h"], "pick": {"nearest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 14,
      "text": "Draw a circle with centre O through N11. It crosses the line at 135° from OA at P4, above O. Draw a line through P4 parallel to the line at 45° from OA. Turn it round O by 30°, eleven times.",
      "create": {
        "oblique0": {"circle": {"centre": "O", "through": "N11"}},
        "P4": {"point": {"meet": ["oblique0", "r135"], "pick": {"angle": 135.0}}},
        "diagonal0": {"line": {"through": "P4", "parallelTo": "r45"}},
        "diagonals0": {"repeat": {"of": ["diagonal0"], "by": "rot12"}}
      },
      "animate": "compass"
    },
    {
      "id": 15,
      "text": "Join T1, T2, T3, T4, T5 and T6 to mark the tile that repeats.",
