  "given": {"O": "The centre of a small eight-pointed star.", "A": "Halfway from O to the next star."},
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and D. These lines make the square cell, with corners K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "B", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "D", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K1"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw a straight line through K4 and C. It crosses the line from O to K1 at T, a third of the way to K1. Draw a horizontal line through T. It crosses the vertical line at E.",
      "create": {
        "kp": {"line": {"through": ["K4", "C"]}},
        "T": {"point": {"meet": ["kp", "d45"]}},
        "th": {"line": {"through": "T", "parallelTo": "h"}},
        "E": {"point": {"meet": ["th", "v"]}}
      },
      "highlight": ["K4", "C"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw a line through E parallel to the line from O to K1. Draw a straight line through B and C. Draw a circle with centre C through E. It crosses the top side of the cell at F, on the left. Draw a line through F parallel to the line from O to K1.",
      "create": {
        "e45": {"line": {"through": "E", "parallelTo": "d45"}},
        "bc": {"line": {"through": ["B", "C"]}},
        "cc": {"circle": {"centre": "C", "through": "E"}},
        "F": {"point": {"meet": ["cc", "gy"], "pick": {"angle": 123.69}}},
        "f45": {"line": {"through": "F", "parallelTo": "d45"}}
      },
      "highlight": ["E"],
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Draw a circle with centre O that touches the line through E. It crosses the vertical line at G, above O. Draw a circle with centre E through O. It crosses the vertical line again at J. Draw a circle with centre J that touches the line through E. It crosses the vertical line at L and M.",
      "create": {
        "co": {"circle": {"centre": "O", "tangentTo": ["e45"]}},
        "G": {"point": {"meet": ["co", "v"], "pick": {"angle": 90.0}}},
        "ce": {"circle": {"centre": "E", "through": "O"}},
        "J": {"point": {"meet": ["ce", "v"], "pick": {"farthest": "O"}}},
        "cj": {"circle": {"centre": "J", "tangentTo": ["e45"]}},
        "L": {"point": {"meet": ["cj", "v"], "pick": {"farthest": "O"}}},
        "M": {"point": {"meet": ["cj", "v"], "pick": {"nearest": "O"}}}
      },
      "highlight": ["e45"],
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "Draw a horizontal line through each of G, L and M. These are the lines of the bands.",
      "create": {
        "yg": {"line": {"through": "G", "parallelTo": "h"}},
        "yl": {"line": {"through": "L", "parallelTo": "h"}},
        "ym": {"line": {"through": "M", "parallelTo": "h"}}
      },
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Turn the lines of the last three steps round O by 90°, three times.",
      "create": {"cp": {"repeat": {"of": ["e45", "bc", "f45", "yg", "yl", "ym"], "by": "rot4"}}},
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
