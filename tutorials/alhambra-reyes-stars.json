        "gys": { "line": { "through": "D", "perpendicularTo": "v" } },
        "E": { "point": { "meet": ["gx", "gy"] } },
        "F": { "point": { "meet": ["gxw", "gy"] } },
        "G": { "point": { "meet": ["gxw", "gys"] } },
        "H": { "point": { "meet": ["gx", "gys"] } },
        "d45": { "line": { "through": ["O", "E"] } },
        "d135": { "line": { "through": ["O", "F"] } }
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw a circle with centre A through O. It crosses the first circle at W1 and W2. Draw a straight line through W1 and W2. It crosses the horizontal line at M, halfway from O to A. Draw a circle with centre O through M.",
