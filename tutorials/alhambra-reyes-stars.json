  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {
        "c": { "circle": { "centre": "O", "through": "A" } },
        "h": { "line": { "through": ["O", "A"] } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through A. Draw a vertical line through B. Draw a horizontal line through C. Draw a horizontal line through D. These lines cross at E, F, G and H, the corners of the tile. Draw a straight line through O and E. Draw a straight line through O and F.",
      "textWithoutHelpers": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through A. Draw a vertical line through B. Draw a horizontal line through C. These lines cross at E and F, two corners of the tile. Draw a straight line through O and E. Draw a straight line through O and F.",
      "create": {
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "C": { "point": { "meet": ["c", "v"], "pick": { "angle": 90.0 } } },
        "B": { "point": { "meet": ["c", "h"], "pick": { "angle": 180.0 } } },
        "D": { "point": { "meet": ["c", "v"], "pick": { "angle": 270.0 } } },
