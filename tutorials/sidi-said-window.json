  "title": "Pierced plaster window of the Dar Si Said museum (Marrakesh)",
  "short": "Dar Si Said window",
  "subtitle": "Dar Si Said museum, Marrakesh",
  "given": {
    "O": "The centre of a small eight-pointed star.",
    "A": "A point halfway from O to the side of the tile."
  },
