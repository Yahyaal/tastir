  "given": {
    "O": "The centre of an eight-pointed star.",
    "A": "Halfway from O to the next star on the horizontal line."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and D. These lines make the square cell, with corners K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "B", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "D", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K1"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler",
      "textWithoutHelpers": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through A. Draw a horizontal line through C. They cross at K1, a corner of the cell. Draw a straight line through O and K1."
    },
    {
      "id": 3,
      "text": "Draw a straight line through O and K2. It crosses the circle at E. Draw a straight line through K1 and E. Draw a straight line through A and C. It crosses the line through K1 and E at P.",
      "create": {
        "d135": {"line": {"through": ["O", "K2"]}},
        "E": {"point": {"meet": ["c", "d135"], "pick": {"angle": 135.0}}},
        "ke": {"line": {"through": ["K1", "E"]}},
        "ac": {"line": {"through": ["A", "C"]}},
        "P": {"point": {"meet": ["ac", "ke"]}}
      },
      "highlight": ["K2", "E", "P"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Draw a vertical line through P. Draw a horizontal line through P. Turn the two lines round O by 90°, three times.",
      "create": {
        "pv": {"line": {"through": "P", "parallelTo": "v"}},
        "ph": {"line": {"through": "P", "parallelTo": "h"}},
        "pp": {"repeat": {"of": ["pv", "ph"], "by": "rot4"}}
      },
      "highlight": ["P"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "The vertical line through P crosses the line from O to K1 at G. Draw a circle with centre O through G. It crosses the horizontal line at S. Draw a line through S parallel to line AC. Turn it round O by 90°, three times. The lines make the star at O.",
      "create": {
        "G": {"point": {"meet": ["pv", "d45"]}},
        "cg": {"circle": {"centre": "O", "through": "G"}},
        "S": {"point": {"meet": ["cg", "h"], "pick": {"angle": 0.0}}},
        "sd": {"line": {"through": "S", "parallelTo": "ac"}},
        "sdp": {"repeat": {"of": ["sd"], "by": "rot4"}}
      },
      "highlight": ["G", "S"],
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "Draw a circle with centre A and the same radius as the circle through G. It crosses the vertical line through A at T, above A. Draw a line through T parallel to line AC. Turn it round O by 90°, three times.",
      "create": {
        "ca": {"circle": {"centre": "A", "radiusOf": "cg"}},
        "T": {"point": {"meet": ["ca", "gx"], "pick": {"angle": 11.701}}},
        "td": {"line": {"through": "T", "parallelTo": "ac"}},
        "tdp": {"repeat": {"of": ["td"], "by": "rot4"}}
      },
      "highlight": ["A", "T"],
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "The circle with centre A crosses the horizontal line at U, to the left of A. The line through S crosses the vertical line through A at W, below A. Draw a line through each of U and W parallel to the line from O to K1. Turn the two lines round O by 90°, three times.",
      "create": {
        "U": {"point": {"meet": ["ca", "h"], "pick": {"nearest": "O"}}},
        "W": {"point": {"meet": ["sd", "gx"]}},
        "ud": {"line": {"through": "U", "parallelTo": "d45"}},
        "wd": {"line": {"through": "W", "parallelTo": "d45"}},
        "uwp": {"repeat": {"of": ["ud", "wd"], "by": "rot4"}}
      },
      "highlight": ["U", "W"],
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Draw a circle with centre O through U. It crosses the line from O to K1 at Q. Draw a vertical line and a horizontal line through Q. Turn the two lines round O by 90°, three times.",
      "create": {
        "cu": {"circle": {"centre": "O", "through": "U"}},
        "Q": {"point": {"meet": ["cu", "d45"], "pick": {"angle": 45.0}}},
        "qv": {"line": {"through": "Q", "parallelTo": "v"}},
        "qh": {"line": {"through": "Q", "parallelTo": "h"}},
        "qp": {"repeat": {"of": ["qv", "qh"], "by": "rot4"}}
      },
      "highlight": ["U", "Q"],
      "animate": "compass"
    },
    {
      "id": 9,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
