  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a line through each of A, B, C and D at 90° to its line from O. These four lines cross at K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "B", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "D", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K1"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw a circle with centre A through O. It crosses the first circle at G and H. Draw a straight line through G and H. Turn it round O by 45°, seven times.",
      "create": {
        "cA": {"circle": {"centre": "A", "through": "O"}},
        "G": {"point": {"meet": ["c", "cA"], "pick": {"angle": 60.0}}},
        "H": {"point": {"meet": ["c", "cA"], "pick": {"angle": 300.0}}},
        "mid": {"line": {"through": ["G", "H"]}},
        "midr": {"repeat": {"of": ["mid"], "by": "rot8"}}
      },
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "The first circle crosses the line through O and K1 at E. Draw the line through O that halves the angle AOE. It crosses line GH at T. Draw a line through T parallel to the line through O and K1. Turn it round O by 90°, three times.",
      "create": {
        "E": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "r22": {"line": {"through": "O", "bisects": ["A", "O", "E"]}},
        "T": {"point": {"meet": ["mid", "r22"]}},
        "d1": {"line": {"through": "T", "parallelTo": "d45"}},
        "d1r": {"repeat": {"of": ["d1"], "by": "rot4"}}
      },
      "animate": "ruler",
      "textWithoutHelpers": "The first circle crosses the line through O and K1 at E. Draw the line through O that halves the angle AOE. It crosses line GH at T. Draw a line through T parallel to the line through O and K1. Turn it round O by 90°. Keep only the turned line."
    },
    {
      "id": 5,
      "text": "Line OT crosses the line through T, turned by 90°, at P. Draw a horizontal line through P. Turn it round O by 45°, seven times.",
      "create": {
        "P": {"point": {"meet": ["r22", "d1@1"]}},
        "a1": {"line": {"through": "P", "parallelTo": "h"}},
        "a1r": {"repeat": {"of": ["a1"], "by": "rot8"}}
      },
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "The horizontal line through P, turned by 270°, crosses line OA at S. Draw a circle with centre A and radius OS. It crosses line OA at W, left of A. Draw a vertical line through W. Turn it round O by 45°, seven times.",
      "create": {
        "S": {"point": {"meet": ["a1@6", "h"]}},
        "cAS": {"circle": {"centre": "A", "radiusFrom": ["O", "S"]}},
        "W": {"point": {"meet": ["cAS", "h"], "pick": {"nearest": "O"}}},
        "a3": {"line": {"through": "W", "perpendicularTo": "h"}},
        "a3r": {"repeat": {"of": ["a3"], "by": "rot8"}}
      },
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "The vertical line through A crosses the horizontal line through P, turned by 225°, at Q. Draw a line through Q at 90° to the line through O and K1. Turn it round O by 90°, three times.",
      "create": {
        "Q": {"point": {"meet": ["gx", "a1@5"]}},
        "d3": {"line": {"through": "Q", "perpendicularTo": "d45"}},
        "d3r": {"repeat": {"of": ["d3"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
