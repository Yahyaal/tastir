  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s NC5 vector drawing. Its band centre lines were snapped to exact half-unit square-root-of-two values. Every edge is a side of one of four eight-pointed stars with 45-degree tips, continued. The circle transfer through E locates their centres, and the crossings make the small central star. The drawing gives no steps; we devised the construction.",
    "changes": "The compass steps, their order and the named points are ours. The 8 pt bands are represented by their centre lines. The palette is illustrative; no photograph of the ceiling was checked.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data174/NC5: Sala de las Dos Hermanas, Alhambra",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data174/NC5.html",
      "note": "Read from his finished drawing, not construction instructions. His reference is Nick Crossling’s photograph, personal communication, of wood inlay in a side gallery of the Sala de las Dos Hermanas. The page locates the design at the end section of a side-chamber ceiling."
    }
  ],
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass",
      "textWithoutHelpers": "Draw a circle with centre O through A."
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at C, above O. Draw the line through O that halves the angle AOC. It crosses the circle at E, above O. Draw a circle with centre E through O. It crosses line OE again at B1, beyond E.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "d45": {"line": {"through": "O", "bisects": ["A", "O", "C"]}},
        "E": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "ce": {"circle": {"centre": "E", "through": "O"}},
        "B1": {"point": {"meet": ["ce", "d45"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a circle with centre B1 through E. Draw a horizontal line through B1. Draw a vertical line through B1. Draw a line through B1 at 90° to line OE. The circle crosses the four lines through B1 at S1 to S8.",
      "create": {
        "cs": {"circle": {"centre": "B1", "through": "E"}},
        "bh": {"line": {"through": "B1", "parallelTo": "h"}},
        "bv": {"line": {"through": "B1", "parallelTo": "v"}},
        "bd": {"line": {"through": "B1", "perpendicularTo": "d45"}},
        "S1": {"point": {"meet": ["cs", "bh"], "pick": {"angle": 30.361}}},
        "S2": {"point": {"meet": ["cs", "d45"], "pick": {"farthest": "O"}}},
        "S3": {"point": {"meet": ["cs", "bv"], "pick": {"angle": 59.639}}},
        "S4": {"point": {"meet": ["cs", "bd"], "pick": {"angle": 71.565}}},
        "S5": {"point": {"meet": ["cs", "bh"], "pick": {"angle": 73.675}}},
        "S6": {"point": {"meet": ["cs", "d45"], "pick": {"nearest": "O"}}},
        "S7": {"point": {"meet": ["cs", "bv"], "pick": {"angle": 16.325}}},
        "S8": {"point": {"meet": ["cs", "bd"], "pick": {"angle": 18.435}}}
      },
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw the eight-pointed star at B1.",
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S4, S3 and S6, S5 and S8, and S7 and S2. Draw each line long.",
          "create": {
            "q0": {"line": {"through": ["S1", "S4"]}},
            "q2": {"line": {"through": ["S3", "S6"]}},
            "q4": {"line": {"through": ["S5", "S8"]}},
            "q6": {"line": {"through": ["S7", "S2"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S5, S4 and S7, S6 and S1, and S8 and S3. Draw each line long.",
          "create": {
            "q1": {"line": {"through": ["S2", "S5"]}},
            "q3": {"line": {"through": ["S4", "S7"]}},
            "q5": {"line": {"through": ["S6", "S1"]}},
            "q7": {"line": {"through": ["S8", "S3"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 5,
      "text": "Turn the eight lines of the last step round O by 90°, three times.",
      "create": {"qp": {"repeat": {"of": ["q0", "q1", "q2", "q3", "q4", "q5", "q6", "q7"], "by": "rot4"}}},
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw a vertical line through S1. Turn it round O by 90°, three times. These four lines make a square with corners K1, K2, K3 and K4.",
      "create": {
        "gx": {"line": {"through": "S1", "parallelTo": "v"}},
        "grid": {"repeat": {"of": ["gx"], "by": "rot4"}},
        "K1": {"point": {"meet": ["gx", "gx@1"]}},
        "K2": {"point": {"meet": ["gx@1", "gx@2"]}},
        "K3": {"point": {"meet": ["gx@2", "gx@3"]}},
        "K4": {"point": {"meet": ["gx@3", "gx"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
