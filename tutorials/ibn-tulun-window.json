        "st345": { "line": { "through": ["K", "C"] } },
        "st15": { "line": { "through": ["L", "D"] } },
        "st45": { "line": { "through": ["M", "E"] } }
      },
      "highlight": ["A", "B", "C", "D", "E", "F", "G", "H", "J", "K", "L", "M"],
      "animate": "ruler"
    },
