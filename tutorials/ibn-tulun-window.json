        "sqA": { "polygon": ["D", "A", "K", "G"] },
        "sqB": { "polygon": ["C", "M", "J", "F"] },
        "sqC": { "polygon": ["B", "L", "H", "E"] }
      },
      "highlight": ["A", "B", "C", "D", "E", "F", "G", "H", "J", "K", "L", "M"],
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "Draw a straight line through A and F, B and G, C and H, and D and J. Draw a straight line through E and K, F and L, G and M, and H and A. Draw a straight line through J and B, K and C, L and D, and M and E. The twelve lines make a twelve-pointed star.",
      "create": {
        "st75": { "line": { "through": ["A", "F"] } },
        "st105": { "line": { "through": ["B", "G"] } },
        "st135": { "line": { "through": ["C", "H"] } },
