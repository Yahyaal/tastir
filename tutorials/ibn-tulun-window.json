{
  "format": 0,
  "id": "ibn-tulun-window",
  "title": "Ibn Tulun window",
  "fold": 6,
  "style": "Tulunid",
  "level": "advanced",
  "construction": {
    "basis": "instructions",
    "fidelity": "adapted",
    "note": "The sequence follows Mamoot’s Ibn Tulun window lesson: triangles, three squares, twelve-pointed star, fish and two bending stars. The work log records an exact final-ink overlay.",
    "changes": "The source does not fully specify the fish and bending-star endpoints in words. Those details were measured from its step drawings and expressed as exact crossings and parallel lines. We use its clover repeat.",
    "reviewed": "2026-10-21"
  },
  "credits": [
    {
      "source": "Islamic Geometry: A Window from Ibn Tulun Masjid",
      "creator": "Mamoot (mamootdiy.com), after a class by William Charles Riding and the Prince's Foundation School of Traditional Arts",
      "url": "https://mamootdiy.com/2020/12/21/islamic-geometry-a-window-from-ibn-tulun-masjid/",
      "note": "The sequence of triangles, three squares, twelve-pointed star, the six fish, the diagonals and the two stars of parallel lines follows this tutorial.",
      "steps": [6, 7, 8, 9, 10]
    }
  ],
  "given": {
    "O": "The centre of the window's rosette.",
    "A": "Any point to the right of O. The distance OA is the radius of the first circle, and the unit for every length."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size until the end.",
      "create": {
        "h": { "line": { "through": ["O", "A"] } },
        "c": { "circle": { "centre": "O", "through": "A" } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a circle with centre A through O. Draw a circle with centre G through O, where the line crosses the first circle on the left. The two new circles touch at O.",
      "create": {
        "G": { "point": { "meet": ["c", "h"], "pick": { "angle": 180 } } },
        "cE": { "circle": { "centre": "A", "radiusOf": "c" } },
        "cW": { "circle": { "centre": "G", "radiusOf": "c" } }
      },
      "highlight": ["c", "h"],
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw circles with centres C, E, J and L, through O. C, E, J and L are where the two new circles cross the first one. Six circles now ring the first circle.",
      "create": {
        "C": { "point": { "meet": ["c", "cE"], "pick": { "angle": 60 } } },
        "L": { "point": { "meet": ["c", "cE"], "pick": { "angle": 300 } } },
        "E": { "point": { "meet": ["c", "cW"], "pick": { "angle": 120 } } },
        "J": { "point": { "meet": ["c", "cW"], "pick": { "angle": 240 } } },
        "c60": { "circle": { "centre": "C", "radiusOf": "c" } },
        "c120": { "circle": { "centre": "E", "radiusOf": "c" } },
        "c240": { "circle": { "centre": "J", "radiusOf": "c" } },
        "c300": { "circle": { "centre": "L", "radiusOf": "c" } }
      },
      "highlight": ["cE", "cW"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a straight line through O and P1, through O and P2, and through O and P3. P1, P2 and P3 are the tips of the large petals outside the first circle.",
      "create": {
        "P1": { "point": { "meet": ["cE", "c60"], "pick": { "farthest": "O" } } },
        "P2": { "point": { "meet": ["c60", "c120"], "pick": { "farthest": "O" } } },
        "P3": { "point": { "meet": ["c120", "cW"], "pick": { "farthest": "O" } } },
        "m30": { "line": { "through": ["O", "P1"] } },
        "m90": { "line": { "through": ["O", "P2"] } },
        "m150": { "line": { "through": ["O", "P3"] } }
      },
      "highlight": ["cE", "c60", "c120", "cW"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Join B, D, F, H, K and M with straight lines. Join A, C, E, G, J and L with straight lines. B, D, F, H, K and M are where the three lines cross the first circle. The circle is now cut into twelve.",
      "create": {
        "B": { "point": { "meet": ["c", "m30"], "pick": { "angle": 30 } } },
        "D": { "point": { "meet": ["c", "m90"], "pick": { "angle": 90 } } },
        "F": { "point": { "meet": ["c", "m150"], "pick": { "angle": 150 } } },
        "H": { "point": { "meet": ["c", "m30"], "pick": { "angle": 210 } } },
        "K": { "point": { "meet": ["c", "m90"], "pick": { "angle": 270 } } },
        "M": { "point": { "meet": ["c", "m150"], "pick": { "angle": 330 } } },
        "hex": { "polygon": ["B", "D", "F", "H", "K", "M"] },
        "flat": { "polygon": ["A", "C", "E", "G", "J", "L"] }
      },
      "highlight": ["m30", "m90", "m150"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Join D, M and H with straight lines. Join B, K and F with straight lines. The two triangles make a six-pointed star.",
      "create": {
        "up": { "polygon": ["D", "M", "H"] },
        "down": { "polygon": ["B", "K", "F"] }
      },
      "highlight": ["B", "D", "F", "H", "K", "M"],
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Join D, A, K and G with straight lines. Join C, M, J and F with straight lines. Join B, L, H and E with straight lines. These are three squares.",
