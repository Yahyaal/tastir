  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Brian Wichmann’s P064 drawing, its corners snapped to exact values. We devised the construction. The star at O is the classic star of two squares, and every other line runs through a crossing of its lines carried on (V and P), as in the Damghan minaret. The large octagons sit at the corners of a square tile turned by 22.5°. The drawing gives no steps.",
    "changes": "The compass steps, their order and the named points are ours. The comparison with the drawing checks the finished lines, not how the design was first laid out. No photo of a real panel was checked.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data11/P064: Bourgoin, Plate 64",
      "creator": "Brian Wichmann",
      "url": "https://tilingsearch.mit.edu/HTML/data11/P064.html",
      "kind": "drawing",
      "note": "The design was read from his drawing. He takes it from plate 64 of Jules Bourgoin, Arabic Geometrical Pattern and Design (1879; Dover reprint), and lists it on carved stucco from Rey (twelfth century, Tehran Museum), at the Sari Han on the Aksaray to Kayseri road (David Wade’s photo TUR 0626) and under an inscription in the al-Azhar mosque, Cairo. The construction is ours."
    }
  ],
  "given": {"O": "The centre of an eight-pointed star.", "A": "A point of the star."},
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. Draw the line through O that halves the angle between the two lines. Draw the line through O at 90° to it. The four lines cross the circle at S1 to S8.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "d45": {"line": {"through": "O", "bisects": ["A", "O", "C"]}},
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}},
        "S1": {"point": {"meet": ["c", "h"], "pick": {"angle": 0.0}}},
        "S2": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "S3": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "S4": {"point": {"meet": ["c", "d135"], "pick": {"angle": 135.0}}},
        "S5": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "S6": {"point": {"meet": ["c", "d45"], "pick": {"angle": 225.0}}},
        "S7": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "S8": {"point": {"meet": ["c", "d135"], "pick": {"angle": 315.0}}}
      },
      "highlight": ["c"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw the star at O as two squares.",
      "highlight": ["c"],
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S3, S3 and S5, S5 and S7, and S7 and S1. Draw each line long.",
          "create": {
            "q01": {"line": {"through": ["S1", "S3"]}},
            "q02": {"line": {"through": ["S3", "S5"]}},
            "q03": {"line": {"through": ["S5", "S7"]}},
            "q04": {"line": {"through": ["S7", "S1"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S4, S4 and S6, S6 and S8, and S8 and S2. Draw each line long.",
          "create": {
            "q11": {"line": {"through": ["S2", "S4"]}},
            "q12": {"line": {"through": ["S4", "S6"]}},
            "q13": {"line": {"through": ["S6", "S8"]}},
            "q14": {"line": {"through": ["S8", "S2"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 4,
      "text": "The line through S1 and S3 crosses the line through S2 and S4 at V. Draw a vertical line through V. Draw a line through V parallel to the line through O and S2. The line through S7 and S1 crosses the line through S2 and S4, carried on, at P. Draw a vertical line through P. Draw a line through P parallel to the line through O and S4.",
      "create": {
        "V": {"point": {"meet": ["q01", "q11"]}},
        "vv": {"line": {"through": "V", "parallelTo": "v"}},
        "vd": {"line": {"through": "V", "parallelTo": "d45"}},
        "P": {"point": {"meet": ["q04", "q11"]}},
        "pv": {"line": {"through": "P", "parallelTo": "v"}},
        "pd": {"line": {"through": "P", "parallelTo": "d135"}}
      },
      "highlight": ["V", "P"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Turn the four lines of the last step round O by 90°, three times.",
      "create": {"vr": {"repeat": {"of": ["vv", "vd", "pv", "pd"], "by": "rot4"}}},
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw a vertical line through A. Draw the line through O that halves the angle at O between S2 and S3. The two lines cross at K1. Draw a line through O at 90° to the line through O and K1. Draw a circle with centre O through K1. It crosses the two lines through O at K2, K3 and K4.",
      "create": {
        "ax": {"line": {"through": "A", "perpendicularTo": "h"}},
        "t": {"line": {"through": "O", "bisects": ["S2", "O", "S3"]}},
        "K1": {"point": {"meet": ["ax", "t"]}},
        "tp": {"line": {"through": "O", "perpendicularTo": "t"}},
        "ck": {"circle": {"centre": "O", "through": "K1"}},
        "K2": {"point": {"meet": ["ck", "tp"], "pick": {"angle": 157.5}}},
        "K3": {"point": {"meet": ["ck", "t"], "pick": {"angle": 247.5}}},
        "K4": {"point": {"meet": ["ck", "tp"], "pick": {"angle": 337.5}}}
      },
      "highlight": ["K1"],
      "animate": "compass",
      "textWithoutHelpers": "Mark K1, a corner of the tile, above A. Draw a circle with centre O through K1. Mark K2, K3 and K4 on it, each a quarter turn on from the last."
    },
    {
      "id": 7,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
