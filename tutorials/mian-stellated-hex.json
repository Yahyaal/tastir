  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. This is the circle of one rosette.",
      "create": {
        "c": { "circle": { "centre": "O", "through": "A" } },
        "h": { "line": { "through": ["O", "A"] } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at D and K. The horizontal line crosses it at G.",
      "create": {
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "G": { "point": { "meet": ["c", "h"], "pick": { "angle": 180.0 } } },
        "D": { "point": { "meet": ["c", "v"], "pick": { "angle": 90.0 } } },
        "K": { "point": { "meet": ["c", "v"], "pick": { "angle": 270.0 } } }
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw circles with centres A, D, G and K, through O. They cross the first circle at B, C, E, F, H, J, L and M. The circle is now cut into twelve.",
      "create": {
        "cE": { "circle": { "centre": "A", "through": "O" } },
        "cW": { "circle": { "centre": "G", "through": "O" } },
        "cN": { "circle": { "centre": "D", "through": "O" } },
        "cS": { "circle": { "centre": "K", "through": "O" } },
        "C": { "point": { "meet": ["c", "cE"], "pick": { "angle": 60.0 } } },
        "L": { "point": { "meet": ["c", "cE"], "pick": { "angle": 300.0 } } },
        "E": { "point": { "meet": ["c", "cW"], "pick": { "angle": 120.0 } } },
        "J": { "point": { "meet": ["c", "cW"], "pick": { "angle": 240.0 } } },
        "B": { "point": { "meet": ["c", "cN"], "pick": { "angle": 30.0 } } },
        "F": { "point": { "meet": ["c", "cN"], "pick": { "angle": 150.0 } } },
        "H": { "point": { "meet": ["c", "cS"], "pick": { "angle": 210.0 } } },
        "M": { "point": { "meet": ["c", "cS"], "pick": { "angle": 330.0 } } }
      },
      "highlight": ["A", "D", "G", "K"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a straight line through A and C, B and D, C and E, and D and F. Draw a straight line through E and G, F and H, G and J, and H and K. Draw a straight line through J and L, K and M, L and A, and M and B. These lines make two hexagons. They run on across the tile.",
      "create": {
        "H0": { "line": { "through": ["A", "C"] } },
        "H1": { "line": { "through": ["B", "D"] } },
        "H2": { "line": { "through": ["C", "E"] } },
        "H3": { "line": { "through": ["D", "F"] } },
        "H4": { "line": { "through": ["E", "G"] } },
