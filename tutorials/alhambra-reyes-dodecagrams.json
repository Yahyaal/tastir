        "t0": { "line": { "through": "T1", "perpendicularTo": "h" } },
        "T2": { "point": { "meet": ["cd", "r30"], "pick": { "angle": 30.0 } } },
        "t30": { "line": { "through": "T2", "perpendicularTo": "r30" } },
        "tr": { "repeat": { "of": ["t0", "t30"], "by": "rot6" } }
      },
