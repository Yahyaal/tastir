  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. Keep this compass size.",
      "create": {
        "c": { "circle": { "centre": "O", "through": "A" } },
        "h": { "line": { "through": ["O", "A"] } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a circle with centre A through O. Draw a circle with centre G through O, where the line crosses the first circle on the left. The two new circles cross the first circle at C, E, J and L. Draw a straight line through C and J. Draw a straight line through E and L.",
      "textWithoutHelpers": "Draw a circle with centre A through O. Draw a circle with centre G through O, where the line crosses the first circle on the left. The two new circles cross the first circle at C, E, J and L.",
      "create": {
        "G": { "point": { "meet": ["c", "h"], "pick": { "angle": 180.0 } } },
        "cE": { "circle": { "centre": "A", "through": "O" } },
        "cW": { "circle": { "centre": "G", "through": "O" } },
        "C": { "point": { "meet": ["c", "cE"], "pick": { "angle": 60.0 } } },
        "L": { "point": { "meet": ["c", "cE"], "pick": { "angle": 300.0 } } },
        "E": { "point": { "meet": ["c", "cW"], "pick": { "angle": 120.0 } } },
        "J": { "point": { "meet": ["c", "cW"], "pick": { "angle": 240.0 } } },
        "r60": { "line": { "through": ["C", "J"] } },
        "r120": { "line": { "through": ["E", "L"] } }
      },
      "animate": "compass"
    },
    {
      "id": 3,
      "text": "Draw a vertical line through O. It crosses the first circle at D. Draw the line through O that halves the angle AOC. It crosses the first circle at B.",
      "create": {
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "r30": { "line": { "through": "O", "bisects": ["A", "O", "C"] } },
        "B": { "point": { "meet": ["c", "r30"], "pick": { "angle": 30.0 } } },
        "D": { "point": { "meet": ["c", "v"], "pick": { "angle": 90.0 } } }
      },
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Join A, C, E, G, J and L with straight lines. The sides of this hexagon run on as lines of the pattern.",
      "create": {
        "hx0": { "line": { "through": ["A", "C"] } },
        "hx60": { "line": { "through": ["C", "E"] } },
        "hx120": { "line": { "through": ["E", "G"] } },
        "hx180": { "line": { "through": ["G", "J"] } },
        "hx240": { "line": { "through": ["J", "L"] } },
        "hx300": { "line": { "through": ["L", "A"] } }
      },
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw a vertical line through A. Draw a line through C, at 90° to the line from O to C. Draw a line through E, at 90° to the line from O to E. Draw a vertical line through G. Draw a line through J, at 90° to the line from O to J. Draw a line through L, at 90° to the line from O to L. These lines make the hexagon tile, with corners V1 to V6.",
      "create": {
        "g0": { "line": { "through": "A", "perpendicularTo": "h" } },
        "g60": { "line": { "through": "C", "perpendicularTo": "r60" } },
        "g120": { "line": { "through": "E", "perpendicularTo": "r120" } },
        "g180": { "line": { "through": "G", "perpendicularTo": "h" } },
        "g240": { "line": { "through": "J", "perpendicularTo": "r60" } },
        "g300": { "line": { "through": "L", "perpendicularTo": "r120" } },
        "V1": { "point": { "meet": ["g0", "g60"] } },
        "V2": { "point": { "meet": ["g60", "g120"] } },
        "V3": { "point": { "meet": ["g120", "g180"] } },
        "V4": { "point": { "meet": ["g180", "g240"] } },
        "V5": { "point": { "meet": ["g240", "g300"] } },
        "V6": { "point": { "meet": ["g300", "g0"] } }
      },
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw a vertical line through C. It crosses the horizontal line at X. Draw a vertical line through B. It crosses the horizontal line at Y. Draw a circle with centre O whose radius is the distance from X to Y. It crosses the horizontal line at Q. Draw a circle with centre Q through O. It crosses the last circle at Q1 and Q2. Draw a straight line through Q1 and Q2. It crosses the horizontal line at T1. Draw a circle with centre O through T1.",
      "create": {
        "vx": { "line": { "through": "C", "parallelTo": "v" } },
        "vy": { "line": { "through": "B", "parallelTo": "v" } },
        "X": { "point": { "meet": ["vx", "h"] } },
        "Y": { "point": { "meet": ["vy", "h"] } },
        "cp": { "circle": { "centre": "O", "radiusFrom": ["X", "Y"] } },
        "Q": { "point": { "meet": ["cp", "h"], "pick": { "angle": 0.0 } } },
        "cq": { "circle": { "centre": "Q", "through": "O" } },
