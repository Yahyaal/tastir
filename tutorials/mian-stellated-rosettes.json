        "S12": { "point": { "meet": ["ci", "r150"], "pick": { "angle": 330.0 } } },
        "A0": { "line": { "through": ["S1", "S6"] } },
        "A1": { "line": { "through": ["S2", "S7"] } },
        "A2": { "line": { "through": ["S3", "S8"] } },
        "A3": { "line": { "through": ["S4", "S9"] } },
        "A4": { "line": { "through": ["S5", "S10"] } },
