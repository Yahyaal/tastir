  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A. This is the circle of one rosette.",
      "create": {
        "c": { "circle": { "centre": "O", "through": "A" } },
        "h": { "line": { "through": ["O", "A"] } }
      },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at D and K. The horizontal line crosses it at G. Draw a vertical line through each of A and G. Draw a horizontal line through each of D and K. These lines make the square cell, with corners V1, V2, V3 and V4. Draw a straight line through O and V1.",
      "textWithoutHelpers": "Draw a vertical line through O. It crosses the circle at D and K. The horizontal line crosses it at G. Draw a vertical line through each of A and G. Draw a horizontal line through D. These lines make three sides of the square cell, with corners V1 and V2.",
      "create": {
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "G": { "point": { "meet": ["c", "h"], "pick": { "angle": 180.0 } } },
        "D": { "point": { "meet": ["c", "v"], "pick": { "angle": 90.0 } } },
        "K": { "point": { "meet": ["c", "v"], "pick": { "angle": 270.0 } } },
        "gx": { "line": { "through": "A", "perpendicularTo": "h" } },
        "gxw": { "line": { "through": "G", "perpendicularTo": "h" } },
        "gy": { "line": { "through": "D", "perpendicularTo": "v" } },
        "gys": { "line": { "through": "K", "perpendicularTo": "v" } },
        "V1": { "point": { "meet": ["gx", "gy"] } },
        "V2": { "point": { "meet": ["gxw", "gy"] } },
        "V3": { "point": { "meet": ["gxw", "gys"] } },
        "V4": { "point": { "meet": ["gx", "gys"] } },
        "r45": { "line": { "through": ["O", "V1"] } }
      },
      "highlight": ["c", "h"],
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw circles with centres A, D, G and K, through O. They cross the first circle at B, C, E, F, H, J, L and M. The circle is now cut into twelve.",
      "create": {
        "cE": { "circle": { "centre": "A", "through": "O" } },
        "cW": { "circle": { "centre": "G", "through": "O" } },
        "cN": { "circle": { "centre": "D", "through": "O" } },
        "cS": { "circle": { "centre": "K", "through": "O" } },
        "C": { "point": { "meet": ["c", "cE"], "pick": { "angle": 60.0 } } },
        "L": { "point": { "meet": ["c", "cE"], "pick": { "angle": 300.0 } } },
        "E": { "point": { "meet": ["c", "cW"], "pick": { "angle": 120.0 } } },
        "J": { "point": { "meet": ["c", "cW"], "pick": { "angle": 240.0 } } },
        "B": { "point": { "meet": ["c", "cN"], "pick": { "angle": 30.0 } } },
        "F": { "point": { "meet": ["c", "cN"], "pick": { "angle": 150.0 } } },
        "H": { "point": { "meet": ["c", "cS"], "pick": { "angle": 210.0 } } },
        "M": { "point": { "meet": ["c", "cS"], "pick": { "angle": 330.0 } } }
      },
      "highlight": ["A", "D", "G", "K"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw a straight line through A and C, B and D, C and E, and D and F. Draw a straight line through E and G, F and H, G and J, and H and K. Draw a straight line through J and L, K and M, L and A, and M and B. These lines make two hexagons. They run on across the tile.",
      "create": {
        "H0": { "line": { "through": ["A", "C"] } },
        "H1": { "line": { "through": ["B", "D"] } },
        "H2": { "line": { "through": ["C", "E"] } },
        "H3": { "line": { "through": ["D", "F"] } },
        "H4": { "line": { "through": ["E", "G"] } },
        "H5": { "line": { "through": ["F", "H"] } },
        "H6": { "line": { "through": ["G", "J"] } },
        "H7": { "line": { "through": ["H", "K"] } },
        "H8": { "line": { "through": ["J", "L"] } },
        "H9": { "line": { "through": ["K", "M"] } },
        "H10": { "line": { "through": ["L", "A"] } },
        "H11": { "line": { "through": ["M", "B"] } }
      },
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw a straight line through B and H, C and J, E and L, and F and M. Draw the lines through O that halve the angles between these lines and the horizontal and vertical lines. There is now a line through O every 15°.",
      "textWithoutHelpers": "Draw a straight line through B and H, C and J, E and L, and F and M.",
      "create": {
        "r30": { "line": { "through": ["B", "H"] } },
        "r60": { "line": { "through": ["C", "J"] } },
        "r120": { "line": { "through": ["E", "L"] } },
        "r150": { "line": { "through": ["F", "M"] } },
        "r15": { "line": { "through": "O", "bisects": ["A", "O", "B"] } },
        "r75": { "line": { "through": "O", "bisects": ["C", "O", "D"] } },
        "r105": { "line": { "through": "O", "bisects": ["D", "O", "E"] } },
        "r165": { "line": { "through": "O", "bisects": ["F", "O", "G"] } },
        "r135": { "line": { "through": "O", "perpendicularTo": "r45" } }
      },
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw a circle with centre O through X. X is where the line through A and C crosses the line through B and D. This circle touches all twelve sides of the hexagons.",
      "create": {
        "X": { "point": { "meet": ["H0", "H1"] } },
        "co": { "circle": { "centre": "O", "through": "X" } }
      },
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Draw a straight line through U1 and U2. U1 is where this circle crosses the vertical line. U2 is where it crosses the line through O at 195°. The line crosses the horizontal line at T. Draw a circle with centre O through T. The star is built on it.",
      "create": {
        "U1": { "point": { "meet": ["co", "v"], "pick": { "angle": 90.0 } } },
        "U2": { "point": { "meet": ["co", "r15"], "pick": { "angle": 195.0 } } },
        "chord": { "line": { "through": ["U1", "U2"] } },
        "T": { "point": { "meet": ["chord", "h"] } },
        "ci": { "circle": { "centre": "O", "through": "T" } }
      },
      "animate": "compass"
    },
    {
      "id": 8,
      "text": "Draw a straight line through S1 and S6, S2 and S7, S3 and S8, and S4 and S9. Draw a straight line through S5 and S10, S6 and S11, S7 and S12, and S8 and S1. Draw a straight line through S9 and S2, S10 and S3, S11 and S4, and S12 and S5. S1 to S12 are where the inner circle crosses the lines through O at 0°, 30°, 60° and so on. The twelve lines make the twelve-pointed star.",
      "create": {
        "S1": { "point": { "meet": ["ci", "h"], "pick": { "angle": 0.0 } } },
        "S2": { "point": { "meet": ["ci", "r30"], "pick": { "angle": 30.0 } } },
        "S3": { "point": { "meet": ["ci", "r60"], "pick": { "angle": 60.0 } } },
        "S4": { "point": { "meet": ["ci", "v"], "pick": { "angle": 90.0 } } },
