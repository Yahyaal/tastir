    {
      "id": 10,
      "text": "Draw two lines through W3, parallel to the lines from O through C and from O through E. Draw two lines through W6, parallel to the lines from O through B and from O through F. They close the hexagons and the octagon at V1.",
      "create": {
        "G1": { "line": { "through": "W3", "parallelTo": "r60" } },
        "G2": { "line": { "through": "W3", "parallelTo": "r120" } },
        "G3": { "line": { "through": "W6", "parallelTo": "r30" } },
        "G4": { "line": { "through": "W6", "parallelTo": "r150" } }
