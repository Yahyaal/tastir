        "A10": { "line": { "through": ["S11", "S4"] } },
        "A11": { "line": { "through": ["S12", "S5"] } }
      },
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "Draw a circle with centre W1 through W2. W1 is where the line from O through C crosses the top of the cell. W2 is where the line through A and C crosses it. The circle crosses the top again at W3. Draw a circle with centre W4 through W5 in the same way, on the right side. It crosses the side again at W6.",
      "create": {
        "W1": { "point": { "meet": ["r60", "gy"] } },
        "W2": { "point": { "meet": ["H0", "gy"] } },
        "ch": { "circle": { "centre": "W1", "through": "W2" } },
        "W3": { "point": { "meet": ["ch", "gy"], "pick": { "angle": 53.794 } } },
        "W4": { "point": { "meet": ["r30", "gx"] } },
        "W5": { "point": { "meet": ["H1", "gx"] } },
        "ch2": { "circle": { "centre": "W4", "through": "W5" } },
        "W6": { "point": { "meet": ["ch2", "gx"], "pick": { "angle": 36.206 } } }
