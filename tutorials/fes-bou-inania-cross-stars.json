{
  "format": 0,
  "id": "fes-bou-inania-cross-stars",
  "title": "Crosses and stars of the Bou Inania madrasa (Fez)",
  "short": "Fez cross and stars",
  "subtitle": "Bou Inania madrasa, Fez",
  "fold": 4,
  "star": 8,
  "style": "Moroccan",
  "level": "intermediate",
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Brian Wichmann’s MOR2832X vector drawing. The grey bevel shading was separated from the coloured faces, and the band centre lines snapped to exact values. The drawing gives no steps. We devised the construction from half-unit lines and circles of radius OM.",
    "changes": "The compass steps, their order and the named points are ours. The 9 pt bevelled bands are represented by their centre lines. The large cruciform piece has 24 corners in this centre-line tiling. OA is one third of the cell half-side. The palette is illustrative; no photograph was checked.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data190/MOR2832X: Bou Inania Madrasah, Fez",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data190/MOR2832X.html",
      "note": "Read from his finished drawing, not construction instructions. His reference is David Wade photograph MOR 2832x of the Bou Inania madrasa, Fez."
    }
  ],
  "given": {"O": "The centre of a large cross.", "A": "One grid interval from O on the horizontal line."},
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at C, above O. Draw a straight line through A and C. Draw the line through O that halves the angle AOC. It crosses line AC at M.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "ac": {"line": {"through": ["A", "C"]}},
        "d45": {"line": {"through": "O", "bisects": ["A", "O", "C"]}},
        "M": {"point": {"meet": ["ac", "d45"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw a vertical line through M. Turn it round O by 90°, three times. The vertical line through M crosses the horizontal line at P. Draw a circle with centre O through M. It crosses the horizontal line at S, to the right. Draw a line through S parallel to line AC. Turn it round O by 90°, three times.",
      "create": {
        "mv": {"line": {"through": "M", "parallelTo": "v"}},
        "mvp": {"repeat": {"of": ["mv"], "by": "rot4"}},
        "P": {"point": {"meet": ["mv", "h"]}},
        "ch": {"circle": {"centre": "O", "through": "M"}},
        "S": {"point": {"meet": ["ch", "h"], "pick": {"angle": 0.0}}},
        "sd": {"line": {"through": "S", "parallelTo": "ac"}},
        "sdp": {"repeat": {"of": ["sd"], "by": "rot4"}}
      },
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Keep the compass open to OA. Draw circles with centres A, T1 and T2 in turn. Each circle crosses the horizontal line to the right at T1, T2 and T3.",
      "create": {
        "ct1": {"circle": {"centre": "A", "radiusOf": "c"}},
        "T1": {"point": {"meet": ["ct1", "h"], "pick": {"farthest": "O"}}},
        "ct2": {"circle": {"centre": "T1", "radiusOf": "c"}},
        "T2": {"point": {"meet": ["ct2", "h"], "pick": {"farthest": "O"}}},
        "ct3": {"circle": {"centre": "T2", "radiusOf": "c"}},
        "T3": {"point": {"meet": ["ct3", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 5,
      "text": "Draw a circle with centre O through T2. It crosses the horizontal and vertical lines at U1 to U4. Draw a vertical line through each of U1 and U3. Draw a horizontal line through each of U2 and U4. They make a square with corners K1, K2, K3 and K4.",
      "create": {
        "co": {"circle": {"centre": "O", "through": "T2"}},
        "U1": {"point": {"meet": ["co", "h"], "pick": {"angle": 0.0}}},
        "U2": {"point": {"meet": ["co", "v"], "pick": {"angle": 90.0}}},
        "U3": {"point": {"meet": ["co", "h"], "pick": {"angle": 180.0}}},
        "U4": {"point": {"meet": ["co", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "U1", "parallelTo": "v"}},
        "gy": {"line": {"through": "U2", "parallelTo": "h"}},
        "gxw": {"line": {"through": "U3", "parallelTo": "v"}},
        "gys": {"line": {"through": "U4", "parallelTo": "h"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}}
      },
      "animate": "compass"
    },
    {
      "id": 6,
      "text": "Draw a circle with centre A and radius OP. It crosses the horizontal line at Q, beyond A. Draw a vertical line through Q. Turn it round O by 90°, three times.",
      "create": {
        "ca": {"circle": {"centre": "A", "radiusFrom": ["O", "P"]}},
        "Q": {"point": {"meet": ["ca", "h"], "pick": {"farthest": "O"}}},
        "qv": {"line": {"through": "Q", "parallelTo": "v"}},
        "qvp": {"repeat": {"of": ["qv"], "by": "rot4"}}
      },
      "animate": "compass"
    },
    {
      "id": 7,
      "text": "Draw a circle with centre Q and radius OA. It crosses the horizontal line at R, to the right. Draw a vertical line through R. Turn it round O by 90°, three times.",
      "create": {
        "cq": {"circle": {"centre": "Q", "radiusOf": "c"}},
        "R": {"point": {"meet": ["cq", "h"], "pick": {"farthest": "O"}}},
        "rv": {"line": {"through": "R", "parallelTo": "v"}},
        "rvp": {"repeat": {"of": ["rv"], "by": "rot4"}}
      },
      "animate": "compass"
    },
    {
      "id": 8,
      "text": "Draw a circle with centre T1 and radius OM. It crosses the horizontal line at V1 and V2. Draw a line through each of V1 and V2 parallel to line AC. Turn both lines round O by 90°, three times.",
      "create": {
        "cr1": {"circle": {"centre": "T1", "radiusOf": "ch"}},
        "V1": {"point": {"meet": ["cr1", "h"], "pick": {"nearest": "O"}}},
        "v1d": {"line": {"through": "V1", "parallelTo": "ac"}},
        "V2": {"point": {"meet": ["cr1", "h"], "pick": {"farthest": "O"}}},
        "v2d": {"line": {"through": "V2", "parallelTo": "ac"}},
        "v1copies": {"repeat": {"of": ["v1d", "v2d"], "by": "rot4"}}
      },
      "animate": "compass"
    },
    {
      "id": 9,
      "text": "Draw a circle with centre T3 and radius OM. It crosses the horizontal line at V3 and V4. Draw a line through each of V3 and V4 parallel to line AC. Turn both lines round O by 90°, three times.",
      "create": {
        "cr3": {"circle": {"centre": "T3", "radiusOf": "ch"}},
        "V3": {"point": {"meet": ["cr3", "h"], "pick": {"nearest": "O"}}},
        "v3d": {"line": {"through": "V3", "parallelTo": "ac"}},
        "V4": {"point": {"meet": ["cr3", "h"], "pick": {"farthest": "O"}}},
        "v4d": {"line": {"through": "V4", "parallelTo": "ac"}},
        "v3copies": {"repeat": {"of": ["v3d", "v4d"], "by": "rot4"}}
      },
      "animate": "compass"
    },
    {
      "id": 10,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
