        "N6": {"point": {"meet": ["three", "h"], "pick": {"farthest": "O"}}}
      },
      "animate": "compass"
    },
    {
      "id": 11,
      "text": "Draw a vertical line through B. It crosses the horizontal line at N7. Draw a circle with centre N6 and opening from O to N7. It crosses that line at N8, towards O. Draw a circle with centre O through N8. It crosses the vertical line at N9, above O.",
      "create": {
        "bv": {"line": {"through": "B", "parallelTo": "v"}},
        "N7": {"point": {"meet": ["bv", "h"]}},
        "height": {"circle": {"centre": "N6", "radiusFrom": ["O", "N7"]}},
        "N8": {"point": {"meet": ["height", "h"], "pick": {"nearest": "O"}}},
        "heightCircle": {"circle": {"centre": "O", "through": "N8"}},
        "N9": {"point": {"meet": ["heightCircle", "v"], "pick": {"angle": 90.0}}}
      },
      "animate": "compass"
    },
    {
      "id": 12,
      "text": "Draw a horizontal line through N9. Turn it round O by 60°, five times.",
      "create": {
        "yh": {"line": {"through": "N9", "parallelTo": "h"}},
        "yhCopies": {"repeat": {"of": ["yh"], "by": "rot6"}}
      },
      "animate": "ruler"
    },
    {
      "id": 13,
      "text": "The right tile side crosses the line through N9 turned by 300° at Q. Draw a line through Q parallel to line OC. Turn it round O by 60°, five times.",
      "create": {
        "Q": {"point": {"meet": ["frame", "yh@5"]}},
        "gl0": {"line": {"through": "Q", "parallelTo": "r60"}},
        "copies0": {"repeat": {"of": ["gl0"], "by": "rot6"}}
      },
      "animate": "ruler"
    },
    {
      "id": 14,
      "text": "Join T1, T2, T3, T4, T5 and T6 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["T1", "T2", "T3", "T4", "T5", "T6"]}},
      "animate": "fade"
