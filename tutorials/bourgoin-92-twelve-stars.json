    {
      "id": 10,
      "text": "Draw a circle with centre A through O. It crosses the horizontal line at N5, right of A. Draw a circle with centre N5 and opening OA. It crosses that line at N6, right of N5.",
      "create": {
        "two": {"circle": {"centre": "A", "through": "O"}},
        "N5": {"point": {"meet": ["two", "h"], "pick": {"farthest": "O"}}},
