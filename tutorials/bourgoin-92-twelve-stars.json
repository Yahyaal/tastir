    {
      "id": 6,
      "text": "Draw a circle with centre O and opening AE. It crosses the horizontal line at N1, right of A.",
      "create": {
        "root3": {"circle": {"centre": "O", "radiusFrom": ["A", "E"]}},
        "N1": {"point": {"meet": ["root3", "h"], "pick": {"angle": 0.0}}}
