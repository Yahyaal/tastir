    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Brian Wichmann’s MAR1 drawing, the centre lines of its bands snapped to exact values. We devised the construction. Its stars and first steps are those of the Spanish tile mosaic; four more diagonals through Z make the small squares at A, B, C and D. The drawing gives no steps.",
    "changes": "The compass steps, their order and the named points are ours. The comparison with the drawing checks the finished lines, not how the design was first laid out. Wichmann draws the lines as interlaced bands; the tutorial draws their centre lines. No photo of the palace was checked.",
    "reviewed": "2026-10-25"
  },
  "credits": [
    {
      "source": "Tiling Search, data197/MAR1: El Badi Palace, Marrakesh",
      "creator": "Brian Wichmann",
      "url": "https://tilingsearch.mit.edu/HTML/data197/MAR1.html",
      "kind": "drawing",
      "note": "The design was read from his drawing, made from a photo of the El Badi Palace in Marrakesh that was sent to him. The construction is ours."
    }
  ],
  "given": {
    "O": "The centre of an eight-pointed star.",
    "A": "Halfway from O to the next star on the horizontal line."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through each of A and B. Draw a horizontal line through each of C and D. These lines make the square cell, with corners K1, K2, K3 and K4. Draw a straight line through O and K1.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "gx": {"line": {"through": "A", "perpendicularTo": "h"}},
        "gxw": {"line": {"through": "B", "perpendicularTo": "h"}},
        "gy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "gys": {"line": {"through": "D", "perpendicularTo": "v"}},
        "K1": {"point": {"meet": ["gx", "gy"]}},
        "K2": {"point": {"meet": ["gxw", "gy"]}},
        "K3": {"point": {"meet": ["gxw", "gys"]}},
        "K4": {"point": {"meet": ["gx", "gys"]}},
        "d45": {"line": {"through": ["O", "K1"]}}
      },
      "highlight": ["c", "h"],
      "animate": "ruler",
      "textWithoutHelpers": "Draw a vertical line through O. The two lines cross the circle at A, B, C and D. Draw a vertical line through A. Draw a horizontal line through C. They cross at K1, a corner of the cell. Draw a straight line through O and K1."
    },
    {
      "id": 3,
      "text": "The circle crosses the line from O to K1 at F. Draw a vertical line through F. It crosses the horizontal line at G. Draw a circle with centre A through G. Draw circles with centres O and K1 and the same radius.",
      "create": {
        "F": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "fv": {"line": {"through": "F", "parallelTo": "v"}},
        "G": {"point": {"meet": ["fv", "h"]}},
        "ca": {"circle": {"centre": "A", "through": "G"}},
        "cs": {"circle": {"centre": "O", "radiusOf": "ca"}},
        "ck": {"circle": {"centre": "K1", "radiusOf": "ca"}}
      },
      "highlight": ["F", "A"],
      "animate": "compass"
    },
    {
      "id": 4,
      "text": "Draw the line through O at 90° to the line from O to K1. The small circle with centre O crosses the four lines through O at S1 to S8.",
      "create": {
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}},
        "S1": {"point": {"meet": ["cs", "h"], "pick": {"angle": 0.0}}},
        "S2": {"point": {"meet": ["cs", "d45"], "pick": {"angle": 45.0}}},
        "S3": {"point": {"meet": ["cs", "v"], "pick": {"angle": 90.0}}},
        "S4": {"point": {"meet": ["cs", "d135"], "pick": {"angle": 135.0}}},
        "S5": {"point": {"meet": ["cs", "h"], "pick": {"angle": 180.0}}},
        "S6": {"point": {"meet": ["cs", "d45"], "pick": {"angle": 225.0}}},
        "S7": {"point": {"meet": ["cs", "v"], "pick": {"angle": 270.0}}},
        "S8": {"point": {"meet": ["cs", "d135"], "pick": {"angle": 315.0}}}
      },
      "highlight": ["cs"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Draw the star at O as two squares.",
      "highlight": ["cs"],
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S3, S3 and S5, S5 and S7, and S7 and S1. Draw each line long, to the sides of the cell.",
          "create": {
            "q01": {"line": {"through": ["S1", "S3"]}},
            "q02": {"line": {"through": ["S3", "S5"]}},
            "q03": {"line": {"through": ["S5", "S7"]}},
            "q04": {"line": {"through": ["S7", "S1"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S4, S4 and S6, S6 and S8, and S8 and S2. Draw each line long, to the sides of the cell.",
          "create": {
            "q11": {"line": {"through": ["S2", "S4"]}},
            "q12": {"line": {"through": ["S4", "S6"]}},
            "q13": {"line": {"through": ["S6", "S8"]}},
            "q14": {"line": {"through": ["S8", "S2"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 6,
      "text": "The same star sits at each corner of the cell. The circle with centre K1 crosses the line from O to K1 at E. Draw a vertical line through E. The circle with centre K1 crosses the vertical line through A at P. It crosses the horizontal line through C at Q. Draw a straight line through P and Q.",
      "create": {
        "E": {"point": {"meet": ["ck", "d45"], "pick": {"nearest": "O"}}},
        "ev": {"line": {"through": "E", "parallelTo": "v"}},
        "P": {"point": {"meet": ["ck", "gx"], "pick": {"angle": 35.264}}},
        "Q": {"point": {"meet": ["ck", "gy"], "pick": {"angle": 54.736}}},
        "pq": {"line": {"through": ["P", "Q"]}}
      },
      "highlight": ["ck"],
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "Draw a vertical line through S1. It crosses the line through S3 and S5 at V. Draw a horizontal line through S3. It crosses the line through S7 and S1 at W. Draw a straight line through V and W.",
      "create": {
        "s1v": {"line": {"through": "S1", "parallelTo": "v"}},
        "V": {"point": {"meet": ["s1v", "q02"]}},
        "s3h": {"line": {"through": "S3", "parallelTo": "h"}},
        "W": {"point": {"meet": ["s3h", "q04"]}},
        "vw": {"line": {"through": ["V", "W"]}}
      },
      "highlight": ["S1", "S3"],
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "The vertical line through F crosses the line through S7 and S1 at Z. Draw the line through Z at 90° to the line from O to K1.",
      "create": {
        "Z": {"point": {"meet": ["fv", "q04"]}},
        "zd": {"line": {"through": "Z", "perpendicularTo": "d45"}}
      },
      "highlight": ["fv", "q04"],
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "Turn the lines of the last three steps round O by 90°, three times.",
      "create": {"cp": {"repeat": {"of": ["ev", "pq", "vw", "zd"], "by": "rot4"}}},
      "highlight": ["ev", "pq", "vw", "zd"],
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
