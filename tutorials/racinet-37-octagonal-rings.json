  "id": "racinet-37-octagonal-rings",
  "title": "Octagonal rings from Racinet plate 37",
  "short": "Racinet 37 octagonal rings",
  "subtitle": "Algerian motifs in Racinet, plate 37",
  "given": {
    "O": "The centre of a pointed star inside an octagonal ring.",
    "A": "Sets the radius of the guide circle."
  },
  "fold": 4,
  "star": 8,
  "style": "Maghrebi",
  "region": "Algeria and Tunisia",
  "level": "advanced",
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s R37D drawing. Its band centres fit exact square-root-of-two values. The construction shares the Rabat throne-room octagon grid, adding two compass and crossing steps for the different rims and connecting pieces. The first two squares are guides for the larger pointed star. The drawing gives no steps; we devised the construction.",
    "changes": "The compass steps, their order and the named points are ours. The 7 pt bands are represented by their centre lines. The palette is illustrative; no photograph was checked. The source identifies Algerian architectural motifs but gives no individual building.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data202/R37D: Algerian motifs in Racinet, plate 37",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data202/R37D.html",
      "note": "Read from his finished drawing, not construction instructions. His reference is Auguste Racinet, Full-Color Picture Sourcebook of Historic Ornament, plate 37, described as motifs from Algerian public architecture of the thirteenth and fourteenth centuries."
    }
  ],
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at C and D. The horizontal line crosses the circle at B on the left. Draw a vertical line through A. Draw a horizontal line through C. They cross at E. Draw a straight line through O and E. Draw a line through O at 90° to line OE. The circle crosses the four lines through O at S1 to S8.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "ax": {"line": {"through": "A", "perpendicularTo": "h"}},
        "cy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "E": {"point": {"meet": ["ax", "cy"]}},
        "d45": {"line": {"through": ["O", "E"]}},
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}},
        "S1": {"point": {"meet": ["c", "h"], "pick": {"angle": 0.0}}},
        "S2": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "S3": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "S4": {"point": {"meet": ["c", "d135"], "pick": {"angle": 135.0}}},
        "S5": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "S6": {"point": {"meet": ["c", "d45"], "pick": {"angle": 225.0}}},
        "S7": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "S8": {"point": {"meet": ["c", "d135"], "pick": {"angle": 315.0}}}
      },
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw two guide squares.",
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S3, S3 and S5, S5 and S7, and S7 and S1. Draw each line long, beyond the circle.",
