{
  "format": 0,
  "id": "alhambra-star-and-arrows",
  "title": "Alhambra star and arrows",
  "short": "Star and arrows",
  "subtitle": "Alhambra",
  "fold": 8,
  "style": "Nasrid",
  "level": "beginner",
  "construction": {
    "basis": "mixed",
    "fidelity": "adapted",
    "note": "The rosette follows Mamoot’s Alhambra lesson. The build log records first-try step matches and an exact overlay of the final motif.",
    "changes": "Repeating it in square grid is our addition. The source shows one ceiling rosette, and neither a historical wall with this repeat nor the surrounding ceiling band network was established.",
    "reviewed": "2026-10-21"
  },
  "credits": [
    {
      "source": "Islamic Geometry: A Rosette Tile from The Alhambra",
      "creator": "Mamoot (mamootdiy.com)",
      "url": "https://mamootdiy.com/2021/02/01/islamic-geometry-rosette-tile-from-the-alhambra/",
      "note": "The small circle sized from a square's corner to the squares' crossing, the star joining every third point, and the lines carried out to the squares follow this tutorial.",
      "steps": [7, 8, 9]
    }
  ],
  "given": {
    "O": "The centre of the drawing.",
    "A": "Any point to the right of O. The distance OA is the radius, and the unit for every length."
  },
  "steps": [
    {
      "id": 1,
      "text": "Draw a circle with centre O through A.",
      "create": { "c": { "circle": { "centre": "O", "through": "A" } } },
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a horizontal straight line through O and A. Draw a vertical line through O. The two lines cross the circle at A, C, E and G.",
      "create": {
        "h": { "line": { "through": ["O", "A"] } },
        "v": { "line": { "through": "O", "perpendicularTo": "h" } },
        "C": { "point": { "meet": ["c", "v"], "pick": { "angle": 90 } } },
        "E": { "point": { "meet": ["c", "h"], "pick": { "angle": 180 } } },
        "G": { "point": { "meet": ["c", "v"], "pick": { "angle": 270 } } }
      },
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw the line through O that halves the angle AOC. Draw the line through O that halves the angle COE. These lines cross the circle at B, D, F and H.",
      "create": {
        "d1": { "line": { "through": "O", "bisects": ["A", "O", "C"] } },
        "d2": { "line": { "through": "O", "bisects": ["C", "O", "E"] } },
        "B": { "point": { "meet": ["c", "d1"], "pick": { "angle": 45 } } },
        "D": { "point": { "meet": ["c", "d2"], "pick": { "angle": 135 } } },
        "F": { "point": { "meet": ["c", "d1"], "pick": { "angle": 225 } } },
        "H": { "point": { "meet": ["c", "d2"], "pick": { "angle": 315 } } }
      },
      "highlight": ["h", "v"],
      "animate": "ruler"
    },
    {
      "id": 4,
      "text": "Join A, C, E and G with straight lines. This square stands on its corner.",
      "create": { "dynamic": { "polygon": ["A", "C", "E", "G"] } },
      "highlight": ["A", "C", "E", "G"],
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "Join B, D, F and H with straight lines. This square sits flat. The two squares cross at X1 to X8.",
      "create": {
        "static": { "polygon": ["B", "D", "F", "H"] },
        "X1": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 22.5 } }
        },
        "X2": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 67.5 } }
        },
        "X3": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 112.5 } }
        },
        "X4": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 157.5 } }
        },
        "X5": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 202.5 } }
        },
        "X6": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 247.5 } }
        },
        "X7": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 292.5 } }
        },
        "X8": {
          "point": { "meet": ["dynamic", "static"], "pick": { "angle": 337.5 } }
        }
      },
      "highlight": ["B", "D", "F", "H"],
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "Draw the tile.",
      "parts": [
        {
          "text": "Draw a vertical line through A. Draw a vertical line through E. Draw a horizontal line through C. Draw a horizontal line through G. These lines make a square with corners J, K, L and M.",
          "create": {
            "tE": { "line": { "through": "A", "perpendicularTo": "h" } },
            "tW": { "line": { "through": "E", "perpendicularTo": "h" } },
            "tN": { "line": { "through": "C", "perpendicularTo": "v" } },
            "tS": { "line": { "through": "G", "perpendicularTo": "v" } },
            "J": { "point": { "meet": ["tE", "tN"] } },
            "K": { "point": { "meet": ["tN", "tW"] } },
            "L": { "point": { "meet": ["tW", "tS"] } },
            "M": { "point": { "meet": ["tS", "tE"] } }
          },
          "highlight": ["A", "C", "E", "G"],
          "animate": "ruler"
        },
        {
          "text": "Mark the square JKLM as the tile that repeats.",
          "create": { "cell": { "polygon": ["J", "K", "L", "M"] } },
          "animate": "fade"
        }
      ]
    },
    {
      "id": 7,
      "text": "Draw a circle with centre O whose radius is the distance from A to X1. It crosses the lines through O at T1 to T8.",
      "create": {
        "small": { "circle": { "centre": "O", "radiusFrom": ["A", "X1"] } },
        "T1": { "point": { "meet": ["small", "h"], "pick": { "angle": 0 } } },
        "T2": { "point": { "meet": ["small", "d1"], "pick": { "angle": 45 } } },
        "T3": { "point": { "meet": ["small", "v"], "pick": { "angle": 90 } } },
        "T4": { "point": { "meet": ["small", "d2"], "pick": { "angle": 135 } } },
        "T5": { "point": { "meet": ["small", "h"], "pick": { "angle": 180 } } },
        "T6": { "point": { "meet": ["small", "d1"], "pick": { "angle": 225 } } },
        "T7": { "point": { "meet": ["small", "v"], "pick": { "angle": 270 } } },
        "T8": { "point": { "meet": ["small", "d2"], "pick": { "angle": 315 } } }
      },
      "highlight": ["A", "X1"],
      "animate": "compass"
    },
    {
      "id": 8,
      "text": "Draw a straight line through T1 and T4. Draw a straight line through T2 and T5. Draw a straight line through T3 and T6. Draw a straight line through T4 and T7. Draw a straight line through T5 and T8. Draw a straight line through T6 and T1. Draw a straight line through T7 and T2. Draw a straight line through T8 and T3. The eight lines make an eight-pointed star.",
      "create": {
        "L0": { "line": { "through": ["T1", "T4"] } },
        "L45": { "line": { "through": ["T2", "T5"] } },
        "L90": { "line": { "through": ["T3", "T6"] } },
        "L135": { "line": { "through": ["T4", "T7"] } },
        "L180": { "line": { "through": ["T5", "T8"] } },
        "L225": { "line": { "through": ["T6", "T1"] } },
        "L270": { "line": { "through": ["T7", "T2"] } },
        "L315": { "line": { "through": ["T8", "T3"] } }
      },
      "highlight": ["T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8"],
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "Mark U1 to U16, where the lines of the star cross the squares. Mark V1 to V8, where the lines of the star cross nearest the centre.",
      "create": {
        "U1": {
          "point": { "meet": ["L225", "static"], "pick": { "nearest": "T1" } }
        },
        "U16": {
          "point": { "meet": ["L0", "static"], "pick": { "nearest": "T1" } }
        },
        "U3": {
          "point": { "meet": ["L270", "dynamic"], "pick": { "nearest": "T2" } }
        },
        "U2": {
          "point": { "meet": ["L45", "dynamic"], "pick": { "nearest": "T2" } }
        },
        "U5": {
          "point": { "meet": ["L315", "static"], "pick": { "nearest": "T3" } }
        },
        "U4": {
          "point": { "meet": ["L90", "static"], "pick": { "nearest": "T3" } }
        },
        "U7": {
          "point": { "meet": ["L0", "dynamic"], "pick": { "nearest": "T4" } }
        },
        "U6": {
          "point": { "meet": ["L135", "dynamic"], "pick": { "nearest": "T4" } }
        },
        "U9": {
          "point": { "meet": ["L45", "static"], "pick": { "nearest": "T5" } }
        },
        "U8": {
          "point": { "meet": ["L180", "static"], "pick": { "nearest": "T5" } }
        },
        "U11": {
          "point": { "meet": ["L90", "dynamic"], "pick": { "nearest": "T6" } }
        },
        "U10": {
          "point": { "meet": ["L225", "dynamic"], "pick": { "nearest": "T6" } }
        },
        "U13": {
          "point": { "meet": ["L135", "static"], "pick": { "nearest": "T7" } }
        },
        "U12": {
          "point": { "meet": ["L270", "static"], "pick": { "nearest": "T7" } }
        },
        "U15": {
          "point": { "meet": ["L180", "dynamic"], "pick": { "nearest": "T8" } }
        },
        "U14": {
          "point": { "meet": ["L315", "dynamic"], "pick": { "nearest": "T8" } }
        },
        "V1": { "point": { "meet": ["L315", "L270"] } },
        "V2": { "point": { "meet": ["L0", "L315"] } },
        "V3": { "point": { "meet": ["L45", "L0"] } },
        "V4": { "point": { "meet": ["L90", "L45"] } },
        "V5": { "point": { "meet": ["L135", "L90"] } },
        "V6": { "point": { "meet": ["L180", "L135"] } },
        "V7": { "point": { "meet": ["L225", "L180"] } },
        "V8": { "point": { "meet": ["L270", "L225"] } }
      },
      "highlight": ["static", "dynamic"],
      "animate": "fade"
    }
  ],
  "ink": {
    "text": "Ink an arrow at each point of the star. Each arrow runs from the corners of the squares, through the point of the star, to near the centre.",
    "paths": [
      { "through": ["H", "U16", "T1", "V2"] },
      { "through": ["B", "U1", "T1", "V8"] },
      { "through": ["A", "U2", "T2", "V3"] },
      { "through": ["C", "U3", "T2", "V1"] },
      { "through": ["B", "U4", "T3", "V4"] },
      { "through": ["D", "U5", "T3", "V2"] },
      { "through": ["C", "U6", "T4", "V5"] },
      { "through": ["E", "U7", "T4", "V3"] },
      { "through": ["D", "U8", "T5", "V6"] },
      { "through": ["F", "U9", "T5", "V4"] },
      { "through": ["E", "U10", "T6", "V7"] },
      { "through": ["G", "U11", "T6", "V5"] },
      { "through": ["F", "U12", "T7", "V8"] },
      { "through": ["H", "U13", "T7", "V6"] },
      { "through": ["G", "U14", "T8", "V1"] },
      { "through": ["A", "U15", "T8", "V7"] }
    ],
    "parts": [
      {
        "text": "Ink from B through U1 and T1 to V8. Ink from H through U16 and T1 to V2. These two lines make the arrow at T1.",
        "paths": 2
      },
      {
        "text": "Ink from C through U3 and T2 to V1. Ink from A through U2 and T2 to V3. These two lines make the arrow at T2.",
        "paths": 2
      },
      {
        "text": "Ink the other six arrows the same way, at T3 to T8. Tick “Also ink the copies round the centre” to ink them all at once.",
        "paths": 12
      }
    ]
  },
  "pattern": {
    "cell": "cell",
    "text": "Put copies of the tile side by side. Neighbouring rosettes touch at the corners of their standing squares. The space between four rosettes stays empty.",
    "palette": "Alhambra",
    "colors": {
      "ground": "ground",
      "arrow": "a",
      "blade": "b",
      "star": "c",
      "dart": "ground"
    },
    "rings": true
  },
  "expect": {
    "note": "Golden values for the square repeat, computed by the engine. The repeat itself is not attested by a photo.",
    "pieceTypes": 5,
    "pieces": [
      { "name": "ground", "vertices": 16, "area": 1.65685, "perCell": 1 },
      { "name": "arrow", "vertices": 6, "area": 0.13604, "perCell": 8 },
      { "name": "blade", "vertices": 6, "area": 0.12132, "perCell": 8 },
      { "name": "star", "vertices": 16, "area": 0.11775, "perCell": 1 },
      { "name": "dart", "vertices": 4, "area": 0.02082, "perCell": 8 }
    ],
    "cellArea": 4
  }
}
