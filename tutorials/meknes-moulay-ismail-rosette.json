  "fold": 4,
  "star": 8,
  "style": "Moroccan",
  "region": "Morocco",
  "level": "advanced",
  "construction": {
    "basis": "reconstruction",
    "fidelity": "not-applicable",
    "note": "The finished design was read from Wichmann’s MOR0803 drawing. Its tile corners were snapped to the square-root-of-two grid in small-star-radius units. The opening, the unit star and the first six lines after it, is shared with the Meknes throne-room star rosette. After the unit star every line, the tile’s sides too, is drawn through a crossing of earlier lines and turned round O. The drawing gives no steps; we devised the construction.",
    "changes": "The compass steps, their order and the named points are ours. The tile edges follow the plain drawing. The colours follow Wichmann’s drawing: orange, green, black and white, in the Marinid zellige palette, whose honey stands for his orange. Wade’s photos MOR 0803 and MOR 0911 were not checked.",
    "reviewed": "2026-10-26"
  },
  "credits": [
    {
      "source": "Tiling Search, data173/MOR0803: Tomb of Moulay Ismail, Meknes",
      "creator": "Brian Wichmann",
      "kind": "drawing",
      "url": "https://tilingsearch.mit.edu/HTML/data173/MOR0803.html",
      "note": "Read from his finished drawing, not construction instructions. His references are David Wade’s photos MOR 0803, the tomb of Moulay Ismail, Meknes, and MOR 0911, the Bou Inania madrasa, Meknes (patterninislamicart.com)."
    }
  ],
  "steps": [
    {
      "id": 1,
      "text": "Draw a horizontal straight line through O and A. Draw a circle with centre O through A.",
      "create": {"c": {"circle": {"centre": "O", "through": "A"}}, "h": {"line": {"through": ["O", "A"]}}},
      "animate": "compass"
    },
    {
      "id": 2,
      "text": "Draw a vertical line through O. It crosses the circle at C and D. The horizontal line crosses the circle at B on the left. Draw a vertical line through A. Draw a horizontal line through C. They cross at E. Draw a straight line through O and E. Draw a line through O at 90° to line OE. The circle crosses the four lines through O at S1 to S8.",
      "create": {
        "v": {"line": {"through": "O", "perpendicularTo": "h"}},
        "B": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "C": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "D": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "ax": {"line": {"through": "A", "perpendicularTo": "h"}},
        "cy": {"line": {"through": "C", "perpendicularTo": "v"}},
        "E": {"point": {"meet": ["ax", "cy"]}},
        "d45": {"line": {"through": ["O", "E"]}},
        "d135": {"line": {"through": "O", "perpendicularTo": "d45"}},
        "S1": {"point": {"meet": ["c", "h"], "pick": {"angle": 0.0}}},
        "S2": {"point": {"meet": ["c", "d45"], "pick": {"angle": 45.0}}},
        "S3": {"point": {"meet": ["c", "v"], "pick": {"angle": 90.0}}},
        "S4": {"point": {"meet": ["c", "d135"], "pick": {"angle": 135.0}}},
        "S5": {"point": {"meet": ["c", "h"], "pick": {"angle": 180.0}}},
        "S6": {"point": {"meet": ["c", "d45"], "pick": {"angle": 225.0}}},
        "S7": {"point": {"meet": ["c", "v"], "pick": {"angle": 270.0}}},
        "S8": {"point": {"meet": ["c", "d135"], "pick": {"angle": 315.0}}}
      },
      "animate": "ruler"
    },
    {
      "id": 3,
      "text": "Draw the star at O as two squares.",
      "animate": "ruler",
      "parts": [
        {
          "text": "Draw a straight line through S1 and S3, S3 and S5, S5 and S7, and S7 and S1. Draw each line long, beyond the circle.",
          "create": {
            "q01": {"line": {"through": ["S1", "S3"]}},
            "q02": {"line": {"through": ["S3", "S5"]}},
            "q03": {"line": {"through": ["S5", "S7"]}},
            "q04": {"line": {"through": ["S7", "S1"]}}
          },
          "animate": "ruler"
        },
        {
          "text": "Draw a straight line through S2 and S4, S4 and S6, S6 and S8, and S8 and S2. Draw each line long, beyond the circle.",
          "create": {
            "q11": {"line": {"through": ["S2", "S4"]}},
            "q12": {"line": {"through": ["S4", "S6"]}},
            "q13": {"line": {"through": ["S6", "S8"]}},
            "q14": {"line": {"through": ["S8", "S2"]}}
          },
          "animate": "ruler"
        }
      ]
    },
    {
      "id": 4,
      "text": "The line from S7 to S1 crosses the line from S2 to S4 at P1. Draw a vertical line through P1. Turn it round O by 45°, seven times.",
      "create": {
        "P1": {"point": {"meet": ["q04", "q11"]}},
        "m1": {"line": {"through": "P1", "parallelTo": "v"}},
        "mr1": {"repeat": {"of": ["m1"], "by": "rot8"}}
      },
      "animate": "ruler"
    },
    {
      "id": 5,
      "text": "The line from S3 to S5 crosses the vertical line through P1 at P2. The vertical line through P1 crosses the vertical line through P1, turned by 135°, at P3. Draw a horizontal line through P2. Draw a horizontal line through P3. Turn the new lines round O by 45°, seven times.",
      "create": {
        "P2": {"point": {"meet": ["q02", "m1"]}},
        "P3": {"point": {"meet": ["m1", "m1@3"]}},
        "m2": {"line": {"through": "P2", "parallelTo": "h"}},
        "m3": {"line": {"through": "P3", "parallelTo": "h"}},
        "mr3": {"repeat": {"of": ["m2", "m3"], "by": "rot8"}}
      },
      "animate": "ruler"
    },
    {
      "id": 6,
      "text": "The line from S7 to S1 crosses the horizontal line through P3 at P4. The vertical line through P1 crosses the horizontal line through P2, turned by 45°, at P5. Draw a vertical line through P4. Draw a horizontal line through P5. Turn the new lines round O by 45°, seven times.",
      "create": {
        "P4": {"point": {"meet": ["q04", "m3"]}},
        "P5": {"point": {"meet": ["m1", "m2@1"]}},
        "m4": {"line": {"through": "P4", "parallelTo": "v"}},
        "m5": {"line": {"through": "P5", "parallelTo": "h"}},
        "mr5": {"repeat": {"of": ["m4", "m5"], "by": "rot8"}}
      },
      "animate": "ruler"
    },
    {
      "id": 7,
      "text": "The line from S7 to S1 crosses the horizontal line through P5 at P6. Draw a vertical line through P6. Turn it round O by 45°, seven times.",
      "create": {
        "P6": {"point": {"meet": ["q04", "m5"]}},
        "m6": {"line": {"through": "P6", "parallelTo": "v"}},
        "mr6": {"repeat": {"of": ["m6"], "by": "rot8"}}
      },
      "animate": "ruler"
    },
    {
      "id": 8,
      "text": "The line from S3 to S5 crosses the vertical line through P6 at P7. Draw a horizontal line through P7. Turn it round O by 45°, seven times.",
      "create": {
        "P7": {"point": {"meet": ["q02", "m6"]}},
        "m7": {"line": {"through": "P7", "parallelTo": "h"}},
        "mr7": {"repeat": {"of": ["m7"], "by": "rot8"}}
      },
      "animate": "ruler"
    },
    {
      "id": 9,
      "text": "The line from S8 to S2 crosses the vertical line through P4, turned by 135°, at P8. The vertical line through P4 crosses the horizontal line through P7 at P9. The vertical line through P1, turned by 135°, crosses the vertical line through P6 at P10. Draw a line through P8 at 90° to line OE. Draw a line through P9 at 90° to line OE. Draw a line through P10 at 90° to line OE. Turn the new lines round O by 90°, three times.",
      "create": {
        "P8": {"point": {"meet": ["q14", "m4@3"]}},
        "P9": {"point": {"meet": ["m4", "m7"]}},
        "P10": {"point": {"meet": ["m1@3", "m6"]}},
        "m8": {"line": {"through": "P8", "parallelTo": "d135"}},
        "m9": {"line": {"through": "P9", "parallelTo": "d135"}},
        "m10": {"line": {"through": "P10", "parallelTo": "d135"}},
        "mr10": {"repeat": {"of": ["m8", "m9", "m10"], "by": "rot4"}}
      },
      "animate": "ruler"
    },
    {
      "id": 10,
      "text": "The horizontal line through C crosses the vertical line through P4, turned by 315°, at T. Draw a vertical line through T. Turn it round O by 90°, three times. The four lines make a square with corners K1, K2, K3 and K4.",
      "create": {
        "T": {"point": {"meet": ["cy", "m4@7"]}},
        "gs": {"line": {"through": "T", "parallelTo": "v"}},
        "gsr": {"repeat": {"of": ["gs"], "by": "rot4"}},
        "K1": {"point": {"meet": ["gs", "gs@1"]}},
        "K2": {"point": {"meet": ["gs@1", "gs@2"]}},
        "K3": {"point": {"meet": ["gs@2", "gs@3"]}},
        "K4": {"point": {"meet": ["gs@3", "gs"]}}
      },
      "animate": "ruler"
    },
    {
      "id": 11,
      "text": "Join K1, K2, K3 and K4 to mark the tile that repeats.",
      "create": {"tile": {"polygon": ["K1", "K2", "K3", "K4"]}},
      "animate": "fade"
    }
  ],
