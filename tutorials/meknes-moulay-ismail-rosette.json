{
  "format": 0,
  "id": "meknes-moulay-ismail-rosette",
  "title": "Rosette of the tomb of Moulay Ismail (Meknes)",
  "short": "Moulay Ismail tomb rosette",
  "subtitle": "Tomb of Moulay Ismail, Meknes",
  "given": {
    "O": "The centre of the small star inside the large rosette.",
    "A": "A point of that small star."
