{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": false,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["vitest.config.mts", "src/**/*.spec.ts"],
  "references": [
    {
      "path": "../schema/tsconfig.lib.json"
    },
    {
      "path": "../project-core/tsconfig.lib.json"
    },
    {
      "path": "../engine/tsconfig.lib.json"
    }
  ]
}
