{
  "name": "@tastir/source",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nx run player:dev",
    "test": "pnpm catalog && nx run-many -t test --parallel=1",
    "lint": "nx run-many -t lint",
    "typecheck": "pnpm catalog && nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "review": "tools/review/review.sh",
    "compare": "python3 tools/review/compare.py",
    "test:perf": "TASTIR_PERF=1 vitest run --config packages/engine/vitest.config.mts",
    "bench:ink": "node --conditions=@tastir/source --import tsx tools/bench-ink.mts",
    "catalog": "node --conditions=@tastir/source --import tsx apps/player/src/build/catalog.tsx",
    "test:browser": "nx run player:build && playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:browser",
    "dev:agent": "node --conditions=@tastir/source --import tsx tools/dev-agent.mts",
    "test:agent:browser": "playwright test --config tools/agent-playwright.config.mts",
    "studio:agent": "pnpm studio --assistant",
    "test:shared:browser": "playwright test --config tools/shared-project-playwright.config.mts",
    "studio": "node --conditions=@tastir/source --import tsx tools/studio.mts",
    "test:studio:browser": "playwright test --config tools/studio-playwright.config.mts",
    "contest": "node --conditions=@tastir/source --import tsx tools/studio-contest.mts",
    "studio:db:migrate": "node --conditions=@tastir/source --import tsx tools/studio-db.mts",
    "studio:db:generate": "pnpm --dir apps/studio exec drizzle-kit generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "^23.2.1",
    "@nx/eslint-plugin": "^23.2.1",
    "@nx/js": "^23.2.1",
    "@nx/react": "^23.2.1",
    "@nx/vite": "^23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "^23.2.1",
    "@playwright/test": "^1.64.0",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "^23.2.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
