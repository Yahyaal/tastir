{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tastir-live-room",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "vars": { "STUDIO_ORIGINS": "http://127.0.0.1:4293,http://127.0.0.1:4498" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ProjectRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }],
  "observability": { "enabled": false },
}
