/** Regenerate the presentation's measured vector figures, without screenshots.
 * node --conditions=@tastir/source --import tsx tools/build-ink-presentation.mts
 */
import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync } from 'node:fs';
import { cellOf, evaluate, inkStrokes } from '../packages/engine/src/index.js';
import { parseTutorial } from '../packages/schema/src/index.js';
import {
  compareInk,
  type InkComparison,
  type Stroke,
} from '../apps/player/src/review/inkComparison.js';

const wall = (id: string) => {
  const t = parseTutorial(
    JSON.parse(readFileSync(`tutorials/${id}.json`, 'utf8')),
  );
  const scene = evaluate(t);
  return {
    ...cellOf(scene, t.pattern.cell),
    ink: inkStrokes(scene, t).map((s) => s.segment),
  };
};
const round = (n: number) => Number(n.toFixed(6));
function figure(r: InkComparison) {
  const xs = r.boundary.map((p) => p.x),
    ys = r.boundary.map((p) => -p.y);
  const x = Math.min(...xs),
    y = Math.min(...ys);
  const w = Math.max(...xs) - x,
    h = Math.max(...ys) - y,
    margin = Math.max(w, h) * 0.06;
  const path = (strokes: Stroke[]) =>
    strokes
      .map(
        (s) =>
          `M${round(s.a.x)},${round(-s.a.y)}L${round(s.b.x)},${round(-s.b.y)}`,
      )
      .join('');
  return {
    status: r.status,
    coverageA: r.coverageA,
    coverageB: r.coverageB,
    viewBox: [x - margin, y - margin, w + 2 * margin, h + 2 * margin]
      .map(round)
      .join(' '),
    center: [round(x + w / 2), round(y + h / 2)],
    shared: path(r.shared),
    onlyA: path(r.onlyA),
    onlyB: path(r.onlyB),
  };
}
const pairs = {
  paccard: ['paccard-222-rosette', 'paccard-222-rosette-ring'],
  najjarin: ['fes-najjarin-rosette', 'meknes-bou-inania-rosette'],
};
const summary = JSON.parse(
  readFileSync('docs/review/ink-overlay/merges/summary.json', 'utf8'),
);
const merges = summary.rows.map(
  (r: { place: string; base: string; title: string; baseTitle: string }) => ({
    place: r.place,
    base: r.base,
    title: r.title,
    baseTitle: r.baseTitle,
    ...figure(
      JSON.parse(
        readFileSync(
          `docs/review/ink-overlay/merges/${r.place}--${r.base}.json`,
          'utf8',
        ),
      ),
    ),
  }),
);
const comparisonSha256 = createHash('sha256')
  .update(readFileSync('apps/player/src/review/inkComparison.ts'))
  .digest('hex');
if (summary.comparisonSha256 !== comparisonSha256)
  throw new Error('Regenerate the merge audit first.');
const results = Object.fromEntries(
  Object.entries(pairs).map(([key, [a, b]]) => {
    if (!a || !b) throw new Error('Missing pair');
    return [key, figure(compareInk(wall(a), wall(b)))];
  }),
);
writeFileSync(
  'apps/player/src/review/inkPresentationFigures.ts',
  '// Generated by tools/build-ink-presentation.mts. Coordinates are rounded for display only.\nexport default ' +
    JSON.stringify({
      comparisonSha256,
      source: summary.source,
      merges,
      ...results,
    }) +
    ';\n',
);
console.log(
  'Presentation figures regenerated: ten merges and two rosette comparisons.',
);
