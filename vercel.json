{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@10.30.3 install --frozen-lockfile",
  "buildCommand": "node tools/studio-build.mjs && VITE_TASTIR_STUDIO=hosted pnpm exec vite build --config apps/player/vite.config.mts --outDir ../../dist/studio-hosted --emptyOutDir",
  "outputDirectory": "dist/studio-hosted",
  "regions": ["cle1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{tutorials/**,dist/studio-function/server/*.mjs,dist/studio-function/fonts/**,dist/studio-function/node_modules/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/mcp", "destination": "/api" },
    { "source": "/.well-known/:path*", "destination": "/api" },
    { "source": "/authorize", "destination": "/api" },
    { "source": "/token", "destination": "/api" },
    { "source": "/register", "destination": "/api" },
    { "source": "/revoke", "destination": "/api" },
    { "source": "/login", "destination": "/api" },
    { "source": "/logout", "destination": "/api" },
    { "source": "/auth/:path*", "destination": "/api" },
    { "source": "/consent", "destination": "/api" },
    { "source": "/connections/:path*", "destination": "/api" },
    { "source": "/connections", "destination": "/api" }
  ]
}
